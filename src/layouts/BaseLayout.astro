---
import '../styles/global.css';
import { profile } from '../data/profile';
import CyberCompanion from '../components/CyberCompanion.astro';
import CyberArcade from '../components/CyberArcade.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Gus Adi — Software Developer & Informatics Student',
  description = 'Personal developer portfolio of Gus Adi. Informatics student and software developer building web, backend, and applied systems.',
} = Astro.props;
---

<!doctype html>
<html lang="id" data-theme="light" data-accent="emerald">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ee" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Fonts: Space Grotesk + Outfit + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-flash theme, accent & language script (Default: Daylight Studio Light v7) -->
    <script is:inline>
      (function () {
        try {
          const savedBgScene = localStorage.getItem('portfolio_bg_scene_v7');
          const validScene =
            savedBgScene && ['studio', 'space', 'sakura', 'fireflies', 'ocean', 'sunset'].includes(savedBgScene)
              ? savedBgScene
              : 'studio';
          document.documentElement.setAttribute('data-bg-scene', validScene);

          const savedTheme = localStorage.getItem('portfolio_theme_v7');
          const darkScenes = ['space', 'fireflies', 'sunset'];
          let theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : 'light';
          if (darkScenes.includes(validScene)) {
            theme = 'dark';
          }
          document.documentElement.setAttribute('data-theme', theme);

          const savedAccent = localStorage.getItem('portfolio_accent_v7');
          if (savedAccent && ['emerald', 'coral', 'ocean', 'violet'].includes(savedAccent)) {
            document.documentElement.setAttribute('data-accent', savedAccent);
          }

          const savedLang = localStorage.getItem('lang');
          const lang = savedLang === 'en' ? 'en' : 'id';
          document.documentElement.setAttribute('lang', lang);
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen w-full text-[var(--text-primary)] bg-[var(--bg-base)] antialiased font-sans relative">
    <!-- Thin Top Reading Progress Line -->
    <div class="fixed top-0 left-0 right-0 z-50 h-[3px] bg-transparent pointer-events-none">
      <div
        id="scroll-progress-bar"
        class="h-full bg-gradient-to-r from-[var(--accent-primary)] to-[var(--accent-secondary)] w-0 transition-[width] duration-100 ease-out"
      ></div>
    </div>

    <!-- Soft Daylight Pastel Watercolor Blobs (Eye-friendly ambient depth) -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
      <div class="animate-blob-slow absolute -top-24 -left-24 w-[420px] h-[420px] rounded-full bg-teal-300/20 blur-3xl"></div>
      <div class="animate-blob-slow absolute top-[28%] -right-28 w-[380px] h-[380px] rounded-full bg-sky-300/20 blur-3xl" style="animation-delay: -5s;"></div>
      <div class="animate-blob-slow absolute bottom-12 left-[20%] w-[360px] h-[360px] rounded-full bg-amber-200/20 blur-3xl" style="animation-delay: -9s;"></div>
    </div>

    <!-- Optional Easter-Egg & Ambience World Canvas -->
    <canvas
      id="bg-canvas"
      class="fixed inset-0 w-full h-full pointer-events-none z-0 opacity-85"
      aria-hidden="true"
    ></canvas>

    <!-- Main Creative Studio Flow -->
    <div class="relative z-10 w-full min-h-screen flex flex-col">
      <slot />
    </div>

    <!-- Floating Back-to-Top + Reading Progress Pill -->
    <button
      type="button"
      id="floating-scroll-top"
      class="fixed bottom-6 right-6 z-40 inline-flex items-center gap-2 rounded-full bg-[var(--bg-surface)] border-2 border-[var(--border-subtle)] shadow-[var(--card-shadow)] hover:border-[var(--accent-primary)] text-[var(--text-primary)] px-4 py-2 text-xs font-bold cursor-pointer opacity-0 translate-y-3 pointer-events-none transition-all duration-300"
      aria-label="Kembali ke atas"
      title="Kembali ke atas"
    >
      <span class="text-[var(--accent-primary)] font-bold">↑</span>
      <span id="floating-scroll-pct" class="font-mono text-[11px] text-[var(--text-secondary)]">0%</span>
    </button>

    <!-- Quick Spotlight Search Modal (⌘K / Ctrl+K) -->
    <div
      id="cmd-palette-modal"
      class="modal-backdrop fixed inset-0 z-50 hidden bg-slate-900/40 p-4 flex items-start justify-center pt-[12vh] select-none"
      role="dialog"
      aria-modal="true"
      aria-label="Quick Search"
    >
      <div class="modal-panel w-full max-w-lg rounded-3xl border-2 border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-2xl overflow-hidden font-sans">
        <div class="px-5 py-3.5 border-b border-[var(--border-subtle)] flex items-center gap-3">
          <span class="text-xs font-bold text-[var(--accent-primary)]">⌘K</span>
          <input
            id="cmd-search-input"
            type="text"
            placeholder="Cari bagian, proyek, warna aksen, atau mini-game..."
            autocomplete="off"
            class="flex-1 bg-transparent text-sm text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none"
          />
          <button
            type="button"
            id="cmd-close-btn"
            class="px-2.5 py-1 rounded-full bg-[var(--bg-elevated)] text-xs text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer font-medium"
          >
            Esc
          </button>
        </div>

        <div id="cmd-list" class="p-2.5 space-y-0.5 text-sm max-h-[58vh] overflow-y-auto">
          <a href="#hero" data-cmd-keywords="hero home beranda studio" class="cmd-entry cmd-item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors">
            <span>Beranda &amp; Interactive Studio</span>
            <span class="text-xs text-[var(--text-muted)]">↵</span>
          </a>
          <a href="#projects" data-cmd-keywords="projects karya proyek plagiarism sakuku nlp lab" class="cmd-entry cmd-item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors">
            <span>Karya Pilihan &amp; Live Simulator</span>
            <span class="text-xs text-[var(--text-muted)]">P</span>
          </a>
          <a href="#stack" data-cmd-keywords="stack tech keahlian teknologi radar" class="cmd-entry cmd-item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors">
            <span>Eksplorasi Teknologi &amp; Skill Inspector</span>
            <span class="text-xs text-[var(--text-muted)]">S</span>
          </a>
          <a href="#about" data-cmd-keywords="about bio tentang profil bali" class="cmd-entry cmd-item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors">
            <span>Tentang, Radar Bali &amp; Perjalanan</span>
            <span class="text-xs text-[var(--text-muted)]">A</span>
          </a>
          <a href="#github" data-cmd-keywords="github repositori kontribusi snake" class="cmd-entry cmd-item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors">
            <span>Aktivitas GitHub &amp; Contribution Snake</span>
            <span class="text-xs text-[var(--text-muted)]">G</span>
          </a>
          <a href="#contact" data-cmd-keywords="contact email pesan kontak" class="cmd-entry cmd-item flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors">
            <span>Kontak &amp; Kirim Pesan</span>
            <span class="text-xs text-[var(--text-muted)]">C</span>
          </a>

          <div class="pt-2 mt-1 border-t border-[var(--border-subtle)]"></div>

          <button type="button" id="cmd-action-theme" data-cmd-keywords="theme dark light tema terang gelap" class="cmd-entry cmd-item w-full text-left flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors cursor-pointer">
            <span>Ganti Tema (Daylight Terang / Slate Gelap)</span>
            <span class="text-xs text-[var(--text-muted)]">T</span>
          </button>
          <button type="button" id="cmd-action-lang" data-cmd-keywords="language bahasa indonesia english" class="cmd-entry cmd-item w-full text-left flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors cursor-pointer">
            <span>Ganti Bahasa (Indonesia / English)</span>
            <span class="text-xs text-[var(--text-muted)]">L</span>
          </button>
          <button type="button" id="cmd-action-email" data-email={profile.email} data-cmd-keywords="copy email salin alamat" class="cmd-entry cmd-item w-full text-left flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] transition-colors cursor-pointer">
            <span>Salin Email ({profile.email})</span>
            <span class="text-xs text-[var(--text-muted)]">E</span>
          </button>
          <button type="button" id="cmd-action-arcade" data-cmd-keywords="game arcade ular snake typer" class="cmd-entry cmd-item w-full text-left flex items-center justify-between px-3.5 py-2.5 rounded-xl hover:bg-[var(--bg-elevated)] text-[var(--accent-primary)] font-semibold transition-colors cursor-pointer">
            <span>🎮 Buka Mini-Game Arcade (6 Permainan)</span>
            <span class="text-xs text-[var(--text-muted)]">G</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Subtle Minimal Toast Notification -->
    <div
      id="cyber-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-200 rounded-full bg-[var(--text-primary)] text-[var(--bg-surface)] px-4 py-2 font-sans text-xs font-semibold shadow-lg"
      role="status"
      aria-live="polite"
    ></div>

    <!-- Audio Synth + Easter Eggs + Arcade Modal -->
    <CyberCompanion />
    <CyberArcade />

    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Scroll Progress & Floating Back-to-Top Pill
      const progressBar = document.getElementById('scroll-progress-bar');
      const floatingTopBtn = document.getElementById('floating-scroll-top');
      const floatingPctEl = document.getElementById('floating-scroll-pct');

      function updateScrollProgress() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? Math.min(100, Math.round((scrollTop / docHeight) * 100)) : 0;
        if (progressBar) progressBar.style.width = `${pct}%`;
        if (floatingPctEl) floatingPctEl.textContent = `${pct}%`;

        if (floatingTopBtn) {
          if (scrollTop > 320) {
            floatingTopBtn.classList.remove('opacity-0', 'translate-y-3', 'pointer-events-none');
            floatingTopBtn.classList.add('opacity-100', 'translate-y-0');
          } else {
            floatingTopBtn.classList.add('opacity-0', 'translate-y-3', 'pointer-events-none');
            floatingTopBtn.classList.remove('opacity-100', 'translate-y-0');
          }
        }
      }
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      updateScrollProgress();

      floatingTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: reducedMotion ? 'auto' : 'smooth' });
      });

      // 2. Cursor Spotlight & 3D Perspective Tilt on cards (EXCEPT #contact)
      if (!reducedMotion) {
        let activeTiltTarget: HTMLElement | null = null;

        document.addEventListener(
          'mousemove',
          (e) => {
            const target = e.target as HTMLElement | null;
            if (!target) return;

            // Update Cursor Spotlight coordinates on any card (except #contact)
            const spotTarget = target.closest<HTMLElement>(
              '.spotlight-surface, section:not(#contact) .tactile-card, section:not(#contact) .soft-panel'
            );
            if (spotTarget && !spotTarget.closest('#contact')) {
              const rect = spotTarget.getBoundingClientRect();
              spotTarget.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
              spotTarget.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
            }

            // Find innermost card to tilt (exclude #contact and flip-card-inner children)
            const tiltTarget = target.closest<HTMLElement>(
              '[data-tilt], section:not(#contact) .tactile-card, section:not(#contact) .soft-panel'
            );

            if (
              tiltTarget &&
              !tiltTarget.closest('#contact') &&
              !tiltTarget.closest('.flip-card-inner')
            ) {
              if (activeTiltTarget && activeTiltTarget !== tiltTarget) {
                activeTiltTarget.style.transform = '';
              }
              activeTiltTarget = tiltTarget;
              const rect = tiltTarget.getBoundingClientRect();
              const x = (e.clientX - rect.left) / rect.width - 0.5;
              const y = (e.clientY - rect.top) / rect.height - 0.5;
              // Responsive physical 3D tilt + gentle tactile elevation
              tiltTarget.style.transform = `perspective(900px) rotateX(${(-y * 4.5).toFixed(2)}deg) rotateY(${(x * 4.5).toFixed(2)}deg) translateY(-4px)`;
            } else if (activeTiltTarget) {
              activeTiltTarget.style.transform = '';
              activeTiltTarget = null;
            }
          },
          { passive: true }
        );

        document.addEventListener('mouseout', (e) => {
          const from = e.target as HTMLElement | null;
          const to = e.relatedTarget as HTMLElement | null;
          if (
            activeTiltTarget &&
            from &&
            activeTiltTarget.contains(from) &&
            (!to || !activeTiltTarget.contains(to))
          ) {
            activeTiltTarget.style.transform = '';
            activeTiltTarget = null;
          }
        });
      }

      // 3. Scroll Reveal Observer
      const revealEls = document.querySelectorAll('.reveal-on-scroll');
      if (!reducedMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -30px 0px' }
        );
        revealEls.forEach((el) => observer.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      // 4. Toast Helper & Accent Color Switcher Event
      const toastEl = document.getElementById('cyber-toast');
      let toastTimer: number | null = null;
      function showToast(msg: string) {
        if (!toastEl) return;
        toastEl.textContent = msg;
        toastEl.classList.remove('opacity-0', 'translate-y-2');
        toastEl.classList.add('opacity-100', 'translate-y-0');
        if (toastTimer) window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => {
          toastEl.classList.add('opacity-0', 'translate-y-2');
          toastEl.classList.remove('opacity-100', 'translate-y-0');
        }, 2200);
      }

      window.addEventListener('portfolio:toast', (e: Event) => {
        const custom = e as CustomEvent<{ message?: string }>;
        if (custom.detail?.message) showToast(custom.detail.message);
      });

      window.addEventListener('portfolio:set-accent', (e: Event) => {
        const custom = e as CustomEvent<{ accent?: string; label?: string }>;
        const accent = custom.detail?.accent || 'emerald';
        document.documentElement.setAttribute('data-accent', accent);
        try {
          localStorage.setItem('portfolio_accent_v7', accent);
        } catch (_) {}
        if (custom.detail?.label) {
          showToast(`🎨 Warna Aksen: ${custom.detail.label}`);
        }
      });

      // 5. Interactive Background Ambience Worlds + Easter Egg Canvas
      const canvas = document.getElementById('bg-canvas') as HTMLCanvasElement | null;
      let matrixMode = false;
      let serpentBgEnabled = false;
      let activeBgScene = document.documentElement.getAttribute('data-bg-scene') || 'studio';

      interface StarParticle {
        x: number;
        y: number;
        r: number;
        phase: number;
        speed: number;
        color: string;
      }
      interface MeteorParticle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        len: number;
        alpha: number;
        active: boolean;
      }
      interface AmbienceParticle {
        x: number;
        y: number;
        vx: number;
        vy: number;
        size: number;
        angle: number;
        spin: number;
        phase: number;
        color: string;
      }

      if (canvas && !reducedMotion) {
        const ctx = canvas.getContext('2d');
        let width = (canvas.width = window.innerWidth);
        let height = (canvas.height = window.innerHeight);
        let matrixCols: number[] = [];
        const stars: StarParticle[] = [];
        const meteors: MeteorParticle[] = [];
        const ambiencePts: AmbienceParticle[] = [];

        interface BgSerpent {
          pts: { x: number; y: number }[];
          angle: number;
          turnVel: number;
          speed: number;
          food: { x: number; y: number };
        }
        const bgSerpents: BgSerpent[] = [];

        function initMatrixCols() {
          const colCount = Math.floor(width / 22);
          matrixCols = Array.from({ length: colCount }, () => Math.random() * -80);
        }

        function initSpaceParticles() {
          stars.length = 0;
          const starColors = ['#ffffff', '#93c5fd', '#c4b5fd', '#fde68a', '#5eead4'];
          for (let i = 0; i < 120; i++) {
            stars.push({
              x: Math.random() * width,
              y: Math.random() * height,
              r: 0.7 + Math.random() * 1.9,
              phase: Math.random() * Math.PI * 2,
              speed: 0.015 + Math.random() * 0.035,
              color: starColors[i % starColors.length],
            });
          }
          meteors.length = 0;
          for (let i = 0; i < 2; i++) {
            meteors.push({
              x: Math.random() * width,
              y: Math.random() * (height * 0.4),
              vx: 6 + Math.random() * 4,
              vy: 3 + Math.random() * 2,
              len: 65 + Math.random() * 45,
              alpha: 0,
              active: false,
            });
          }
        }

        function initAmbienceParticles() {
          ambiencePts.length = 0;
          const sakuraColors = ['#f9a8d4', '#f472b6', '#fbcfe8', '#fda4af'];
          const fireflyColors = ['#fde047', '#34d399', '#a7f3d0', '#fef08a'];
          const oceanColors = ['#38bdf8', '#0284c7', '#2dd4bf', '#7dd3fc'];
          const sunsetColors = ['#fb923c', '#f43f5e', '#c084fc', '#fbbf24'];

          for (let i = 0; i < 52; i++) {
            let color = sakuraColors[i % sakuraColors.length];
            if (activeBgScene === 'fireflies') color = fireflyColors[i % fireflyColors.length];
            else if (activeBgScene === 'ocean') color = oceanColors[i % oceanColors.length];
            else if (activeBgScene === 'sunset') color = sunsetColors[i % sunsetColors.length];

            ambiencePts.push({
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.8,
              vy: 0.5 + Math.random() * 1.1,
              size: 4 + Math.random() * 6,
              angle: Math.random() * Math.PI * 2,
              spin: (Math.random() - 0.5) * 0.03,
              phase: Math.random() * Math.PI * 2,
              color,
            });
          }
        }

        function initSerpents() {
          bgSerpents.length = 0;
          const sx = width * 0.3;
          const sy = height * 0.4;
          bgSerpents.push({
            pts: Array.from({ length: 18 }, (_, j) => ({ x: sx - j * 8, y: sy })),
            angle: 0.2,
            turnVel: 0,
            speed: 0.8,
            food: { x: width * 0.7, y: height * 0.5 },
          });
        }

        initMatrixCols();
        initSpaceParticles();
        initAmbienceParticles();
        initSerpents();

        window.addEventListener('resize', () => {
          if (!canvas) return;
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
          initMatrixCols();
          initSpaceParticles();
          initAmbienceParticles();
        });

        window.addEventListener('portfolio:set-bg-scene', (e: Event) => {
          const custom = e as CustomEvent<{ scene?: string; label?: string }>;
          const scene = custom.detail?.scene || 'studio';
          activeBgScene = scene;
          document.documentElement.setAttribute('data-bg-scene', scene);

          // Automatically pair dark/light mode for best contrast
          const darkScenes = ['space', 'fireflies', 'sunset'];
          const targetTheme = darkScenes.includes(scene) ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', targetTheme);

          try {
            localStorage.setItem('portfolio_bg_scene_v7', scene);
            localStorage.setItem('portfolio_theme_v7', targetTheme);
          } catch (_) {}

          initSpaceParticles();
          initAmbienceParticles();

          if (custom.detail?.label) {
            showToast(`✨ Background Ambience: ${custom.detail.label}`);
          }
        });

        const chars = '01{}[]<>/*+-=~;:ABCDEF';
        let lastFrameAt = performance.now();

        function animate(now: number) {
          if (!ctx) return;
          const dtScale = Math.min(2.2, Math.max(0.25, (now - lastFrameAt) / 16.667));
          lastFrameAt = now;

          ctx.clearRect(0, 0, width, height);

          // A. Outer Space / Deep Cosmos Scene
          if (activeBgScene === 'space') {
            for (const st of stars) {
              st.phase += st.speed * dtScale;
              const alpha = 0.25 + 0.7 * (0.5 + 0.5 * Math.sin(st.phase));
              ctx.save();
              ctx.globalAlpha = alpha;
              ctx.fillStyle = st.color;
              ctx.beginPath();
              ctx.arc(st.x, st.y, st.r, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }

            // Shooting Stars / Meteors
            for (const m of meteors) {
              if (!m.active && Math.random() < 0.008 * dtScale) {
                m.active = true;
                m.x = Math.random() * (width * 0.75);
                m.y = Math.random() * (height * 0.35);
                m.alpha = 1;
              }
              if (m.active) {
                m.x += m.vx * dtScale;
                m.y += m.vy * dtScale;
                m.alpha -= 0.016 * dtScale;
                if (m.alpha <= 0 || m.x > width || m.y > height) {
                  m.active = false;
                } else {
                  ctx.save();
                  const grad = ctx.createLinearGradient(m.x, m.y, m.x - m.len, m.y - m.len * 0.5);
                  grad.addColorStop(0, `rgba(255, 255, 255, ${m.alpha})`);
                  grad.addColorStop(1, 'rgba(147, 197, 253, 0)');
                  ctx.strokeStyle = grad;
                  ctx.lineWidth = 2;
                  ctx.beginPath();
                  ctx.moveTo(m.x, m.y);
                  ctx.lineTo(m.x - m.len, m.y - m.len * 0.5);
                  ctx.stroke();
                  ctx.restore();
                }
              }
            }
          }

          // B. Sakura Cherry Blossom Breeze Scene
          else if (activeBgScene === 'sakura') {
            for (const p of ambiencePts) {
              p.phase += 0.025 * dtScale;
              p.x += (Math.sin(p.phase) * 0.65 + 0.35) * dtScale;
              p.y += p.vy * dtScale;
              p.angle += p.spin * dtScale;
              if (p.y > height + 20) {
                p.y = -15;
                p.x = Math.random() * width;
              }
              if (p.x > width + 20) p.x = -15;

              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate(p.angle);
              ctx.fillStyle = p.color;
              ctx.globalAlpha = 0.65;
              ctx.beginPath();
              ctx.ellipse(0, 0, p.size, p.size * 0.58, 0, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }
          }

          // C. Enchanted Firefly Forest Scene
          else if (activeBgScene === 'fireflies') {
            for (const p of ambiencePts) {
              p.phase += 0.03 * dtScale;
              p.x = (p.x + Math.cos(p.phase * 0.7) * 0.55 * dtScale + width) % width;
              p.y = (p.y - 0.35 * dtScale + Math.sin(p.phase) * 0.35 * dtScale + height) % height;
              const glow = 0.2 + 0.8 * (0.5 + 0.5 * Math.sin(p.phase));

              ctx.save();
              ctx.globalAlpha = glow;
              const radGrad = ctx.createRadialGradient(p.x, p.y, 0.5, p.x, p.y, p.size * 2.6);
              radGrad.addColorStop(0, p.color);
              radGrad.addColorStop(1, 'rgba(16, 185, 129, 0)');
              ctx.fillStyle = radGrad;
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.size * 2.6, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }
          }

          // D. Deep Ocean Bubbles Scene
          else if (activeBgScene === 'ocean') {
            for (const p of ambiencePts) {
              p.phase += 0.03 * dtScale;
              p.x += Math.sin(p.phase) * 0.45 * dtScale;
              p.y -= p.vy * 0.85 * dtScale;
              if (p.y < -20) {
                p.y = height + 15;
                p.x = Math.random() * width;
              }

              ctx.save();
              ctx.strokeStyle = p.color;
              ctx.globalAlpha = 0.42;
              ctx.lineWidth = 1.5;
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.size * 0.9, 0, Math.PI * 2);
              ctx.stroke();
              ctx.restore();
            }
          }

          // E. Sunset Lo-Fi Synthwave Dusk Scene
          else if (activeBgScene === 'sunset') {
            for (const p of ambiencePts) {
              p.phase += 0.02 * dtScale;
              p.x = (p.x + Math.sin(p.phase) * 0.4 * dtScale + width) % width;
              p.y = (p.y - p.vy * 0.55 * dtScale + height) % height;
              const alpha = 0.25 + 0.55 * (0.5 + 0.5 * Math.cos(p.phase));

              ctx.save();
              ctx.globalAlpha = alpha;
              ctx.fillStyle = p.color;
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.size * 0.75, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            }
          }

          if (matrixMode) {
            ctx.font = '12px "JetBrains Mono", monospace';
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            ctx.fillStyle = isLight ? 'rgba(13, 148, 136, 0.28)' : 'rgba(45, 212, 191, 0.28)';
            for (let i = 0; i < matrixCols.length; i++) {
              const ch = chars[Math.floor(Math.random() * chars.length)];
              const x = i * 22;
              const y = matrixCols[i] * 18;
              ctx.fillText(ch, x, y);
              if (y > height && Math.random() > 0.975) matrixCols[i] = 0;
              matrixCols[i] += 0.32 * dtScale;
            }
          }

          if (serpentBgEnabled) {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            const strokeCol = isLight ? 'rgba(13, 148, 136, 0.35)' : 'rgba(45, 212, 191, 0.35)';
            for (const s of bgSerpents) {
              const head = s.pts[0];
              const dx = s.food.x - head.x;
              const dy = s.food.y - head.y;
              const dist = Math.hypot(dx, dy);
              if (dist < 22) {
                s.food.x = 60 + Math.random() * Math.max(80, width - 120);
                s.food.y = 60 + Math.random() * Math.max(80, height - 120);
              }
              const targetAngle = Math.atan2(dy, dx);
              let diff = targetAngle - s.angle;
              while (diff > Math.PI) diff -= Math.PI * 2;
              while (diff < -Math.PI) diff += Math.PI * 2;
              s.turnVel = s.turnVel * Math.pow(0.88, dtScale) + diff * 0.008 * dtScale;
              s.turnVel = Math.max(-0.04, Math.min(0.04, s.turnVel));
              s.angle += s.turnVel * dtScale;

              const nx = (head.x + Math.cos(s.angle) * s.speed * dtScale + width) % width;
              const ny = (head.y + Math.sin(s.angle) * s.speed * dtScale + height) % height;
              s.pts[0] = { x: nx, y: ny };
              for (let i = 1; i < s.pts.length; i++) {
                const prev = s.pts[i - 1];
                const cur = s.pts[i];
                const sdx = prev.x - cur.x;
                const sdy = prev.y - cur.y;
                const d = Math.hypot(sdx, sdy);
                if (d > 50) s.pts[i] = { x: prev.x, y: prev.y };
                else if (d > 8) {
                  const a = Math.atan2(sdy, sdx);
                  s.pts[i] = { x: prev.x - Math.cos(a) * 8, y: prev.y - Math.sin(a) * 8 };
                }
              }
              ctx.strokeStyle = strokeCol;
              ctx.lineWidth = 2.5;
              ctx.lineCap = 'round';
              ctx.beginPath();
              ctx.moveTo(s.pts[0].x, s.pts[0].y);
              for (let i = 1; i < s.pts.length; i++) {
                if (Math.hypot(s.pts[i].x - s.pts[i - 1].x, s.pts[i].y - s.pts[i - 1].y) < 30) {
                  ctx.lineTo(s.pts[i].x, s.pts[i].y);
                } else {
                  ctx.moveTo(s.pts[i].x, s.pts[i].y);
                }
              }
              ctx.stroke();
            }
          }

          requestAnimationFrame(animate);
        }
        requestAnimationFrame(animate);
      }

      window.addEventListener('portfolio:toggle-matrix', () => {
        matrixMode = !matrixMode;
        showToast(matrixMode ? 'Matrix Mode: Aktif' : 'Matrix Mode: Nonaktif');
      });

      window.addEventListener('portfolio:toggle-serpent', () => {
        serpentBgEnabled = !serpentBgEnabled;
        showToast(serpentBgEnabled ? '🐍 Ular Latar: Aktif' : '🐍 Ular Latar: Nonaktif');
      });

      // 6. Command Palette Logic
      const cmdModal = document.getElementById('cmd-palette-modal');
      const cmdClose = document.getElementById('cmd-close-btn');
      const cmdSearch = document.getElementById('cmd-search-input') as HTMLInputElement | null;
      const cmdEntries = document.querySelectorAll<HTMLElement>('.cmd-entry');

      function filterCmdEntries(q: string) {
        const query = q.trim().toLowerCase();
        cmdEntries.forEach((el) => {
          const text = (el.textContent || '').toLowerCase();
          const kw = (el.getAttribute('data-cmd-keywords') || '').toLowerCase();
          if (!query || text.includes(query) || kw.includes(query)) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
      }

      cmdSearch?.addEventListener('input', () => filterCmdEntries(cmdSearch.value));

      function openCmdPalette() {
        cmdModal?.classList.remove('hidden');
        if (cmdSearch) {
          cmdSearch.value = '';
          filterCmdEntries('');
        }
        requestAnimationFrame(() => {
          cmdModal?.classList.add('is-open');
          cmdSearch?.focus();
        });
      }

      function closeCmdPalette() {
        cmdModal?.classList.remove('is-open');
        setTimeout(() => cmdModal?.classList.add('hidden'), 180);
      }

      window.addEventListener('portfolio:open-cmd', openCmdPalette);
      cmdClose?.addEventListener('click', closeCmdPalette);
      cmdModal?.addEventListener('click', (e) => {
        if (e.target === cmdModal) closeCmdPalette();
      });

      document.querySelectorAll('.cmd-item').forEach((item) => {
        item.addEventListener('click', () => closeCmdPalette());
      });

      document.getElementById('cmd-action-theme')?.addEventListener('click', () => {
        document.getElementById('theme-toggle-btn')?.click();
      });
      document.getElementById('cmd-action-lang')?.addEventListener('click', () => {
        document.getElementById('lang-toggle-btn')?.click();
      });
      document.getElementById('cmd-action-arcade')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('portfolio:open-arcade'));
      });
      document.getElementById('cmd-action-email')?.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLElement;
        const email = target.getAttribute('data-email');
        if (email) {
          try {
            await navigator.clipboard.writeText(email);
            showToast(`✓ Email tersalin: ${email}`);
          } catch (_) {}
        }
      });

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          if (cmdModal?.classList.contains('hidden')) openCmdPalette();
          else closeCmdPalette();
          return;
        }

        if (e.key === 'Escape' && !cmdModal?.classList.contains('hidden')) {
          closeCmdPalette();
          return;
        }

        const tag = (e.target as HTMLElement | null)?.tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.metaKey || e.ctrlKey || e.altKey) return;

        const k = e.key.toLowerCase();
        if (k === 't') document.getElementById('theme-toggle-btn')?.click();
        else if (k === 'l') document.getElementById('lang-toggle-btn')?.click();
        else if (k === 'm') window.dispatchEvent(new CustomEvent('portfolio:toggle-matrix'));
        else if (k === 'n') window.dispatchEvent(new CustomEvent('portfolio:toggle-serpent'));
        else if (k === 's') window.dispatchEvent(new CustomEvent('portfolio:toggle-sfx'));
      });
    </script>
  </body>
</html>
