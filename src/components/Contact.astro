---
import { profile } from '../data/profile';
import { translations } from '../data/i18n';
import { Copy, Send, ExternalLink, Mail } from 'lucide-astro';
---

<section id="contact" class="w-full py-8 sm:py-14 font-sans">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-8">
    <!-- Direct Dispatch Postcard Container (100% Normal Sans-Serif Plus Jakarta Sans — No Template Header) -->
    <div class="tactile-card overflow-hidden reveal-on-scroll font-sans">
      <!-- Postcard Top Ribbon -->
      <div class="bg-[var(--tint-mint)] border-b-2 border-[var(--border-subtle)] px-6 sm:px-8 py-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <Mail class="w-4 h-4 text-teal-800" />
          <h2 class="font-sans text-lg sm:text-xl font-extrabold text-teal-950">
            <span data-lang="id">{translations.id.contact.header}</span>
            <span data-lang="en">{translations.en.contact.header}</span>
          </h2>
        </div>
        <span class="font-sans text-xs font-bold text-teal-900 bg-white/85 px-3 py-1 rounded-full">
          Bali, Indonesia · Direct Dispatch
        </span>
      </div>

      <div class="p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start font-sans">
      <!-- Left 5 Cols: Readable Intro, Large Normal Email Link & Channels -->
      <div class="lg:col-span-5 space-y-6">
        <p class="text-base sm:text-[17px] leading-relaxed text-[var(--text-secondary)] font-normal">
          <span data-lang="id">{translations.id.contact.intro}</span>
          <span data-lang="en">{translations.en.contact.intro}</span>
        </p>

        <!-- Direct Email (Normal Sans-Serif, Large & Easy to Read) -->
        <div class="space-y-3 border-l-2 border-[var(--accent-primary)] pl-4">
          <div class="text-xs font-semibold uppercase tracking-wider text-[var(--text-muted)]">
            <span data-lang="id">{translations.id.contact.emailLabel}</span>
            <span data-lang="en">{translations.en.contact.emailLabel}</span>
          </div>

          <a
            href={`mailto:${profile.email}`}
            class="block font-sans text-xl sm:text-2xl font-bold text-[var(--text-primary)] hover:text-[var(--accent-primary)] tracking-normal leading-snug break-all select-all transition-colors"
          >
            {profile.email}
          </a>

          <div class="flex flex-wrap items-center gap-2.5 pt-2">
            <button
              type="button"
              id="copy-email-btn"
              data-email={profile.email}
              class="pill-btn inline-flex items-center gap-2 border border-[var(--border-strong)] hover:border-[var(--accent-primary)] text-[var(--text-primary)] font-sans text-sm font-medium px-4 py-2 cursor-pointer"
              aria-label="Copy email address"
            >
              <Copy class="w-4 h-4 text-[var(--accent-primary)]" />
              <span id="copy-label-default">
                <span data-lang="id">{translations.id.contact.copyBtn}</span>
                <span data-lang="en">{translations.en.contact.copyBtn}</span>
              </span>
              <span id="copy-label-done" class="hidden text-[var(--status-ok)] font-semibold">
                <span data-lang="id">{translations.id.contact.copiedBtn}</span>
                <span data-lang="en">{translations.en.contact.copiedBtn}</span>
              </span>
            </button>

            <a
              href={`mailto:${profile.email}`}
              class="pill-btn inline-flex items-center gap-2 bg-[var(--accent-primary)] text-[var(--accent-ink)] font-sans text-sm font-semibold px-4 py-2"
            >
              <Send class="w-4 h-4" />
              <span data-lang="id">Kirim Email</span>
              <span data-lang="en">Send Email</span>
            </a>
          </div>
        </div>

        <!-- Open Hairline Contact Directory (No Box Border) -->
        <div class="divide-y divide-[var(--border-subtle)] text-sm font-sans">
          <div class="py-3.5 flex items-baseline justify-between gap-4">
            <span class="text-[var(--text-muted)]">{translations.id.contact.githubLabel}</span>
            <a
              id="contact-github-link"
              href={`https://github.com/${profile.githubUsername}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-sans font-semibold text-[var(--text-primary)] hover:text-[var(--accent-primary)] transition-colors"
            >
              <span id="contact-github-text">github.com/{profile.githubUsername}</span>
              <ExternalLink class="w-3.5 h-3.5 text-[var(--accent-primary)]" />
            </a>
          </div>

          <div class="py-3.5 flex items-baseline justify-between gap-4">
            <span class="text-[var(--text-muted)]">{translations.id.contact.linkedinLabel}</span>
            {profile.linkedinUrl ? (
              <a
                href={profile.linkedinUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-sans font-semibold text-[var(--text-primary)] hover:text-[var(--accent-primary)]"
              >
                <span>LinkedIn</span>
                <ExternalLink class="w-3.5 h-3.5 text-[var(--accent-primary)]" />
              </a>
            ) : (
              <span class="text-[var(--text-muted)] font-normal">
                <span data-lang="id">{translations.id.contact.unlinked}</span>
                <span data-lang="en">{translations.en.contact.unlinked}</span>
              </span>
            )}
          </div>

          <div class="py-3.5 flex items-baseline justify-between gap-4">
            <span class="text-[var(--text-muted)]">{translations.id.contact.cvLabel}</span>
            {profile.cvUrl.id || profile.cvUrl.en ? (
              <a
                href={profile.cvUrl.en || profile.cvUrl.id}
                download
                class="inline-flex items-center gap-1.5 font-sans font-semibold text-[var(--accent-primary)] hover:underline"
              >
                <span>Download PDF</span>
              </a>
            ) : (
              <span class="text-[var(--text-muted)] font-normal">
                <span data-lang="id">{translations.id.contact.cvPending}</span>
                <span data-lang="en">{translations.en.contact.cvPending}</span>
              </span>
            )}
          </div>
        </div>
      </div>

      <!-- Right 7 Cols: Quick Message Form (Normal Sans-Serif) -->
      <div class="lg:col-span-7 p-6 sm:p-7 rounded-2xl bg-[var(--bg-elevated)]/45 border border-[var(--border-subtle)] space-y-6 font-sans">
        <div class="space-y-1">
          <h3 class="text-xl sm:text-2xl font-bold text-[var(--text-primary)] tracking-tight">
            <span data-lang="id">{translations.id.contact.composerTitle}</span>
            <span data-lang="en">{translations.id.contact.composerTitle}</span>
          </h3>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            <span data-lang="id">{translations.id.contact.composerSub}</span>
            <span data-lang="en">{translations.en.contact.composerSub}</span>
          </p>
        </div>

        <!-- Clean Rounded Topic Pills -->
        <div class="space-y-2">
          <div class="text-xs font-semibold text-[var(--text-secondary)]">
            <span data-lang="id">Topik Pesan</span>
            <span data-lang="en">Inquiry Topic</span>
          </div>
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Select inquiry topic">
            <button
              type="button"
              data-msg-topic="Internship / Role Opportunity"
              class="msg-topic-btn rounded-full px-4 py-1.5 bg-[var(--accent-primary)] text-[var(--accent-ink)] text-xs sm:text-sm font-semibold cursor-pointer transition-colors"
            >
              <span data-lang="id">{translations.id.contact.topicIntern}</span>
              <span data-lang="en">{translations.en.contact.topicIntern}</span>
            </button>
            <button
              type="button"
              data-msg-topic="Project Collaboration"
              class="msg-topic-btn rounded-full px-4 py-1.5 border border-[var(--border-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs sm:text-sm font-medium cursor-pointer transition-colors"
            >
              <span data-lang="id">{translations.id.contact.topicCollab}</span>
              <span data-lang="en">{translations.en.contact.topicCollab}</span>
            </button>
            <button
              type="button"
              data-msg-topic="Tech Discussion"
              class="msg-topic-btn rounded-full px-4 py-1.5 border border-[var(--border-strong)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] text-xs sm:text-sm font-medium cursor-pointer transition-colors"
            >
              <span data-lang="id">{translations.id.contact.topicChat}</span>
              <span data-lang="en">{translations.en.contact.topicChat}</span>
            </button>
          </div>
        </div>

        <!-- Clean Underlined Normal Sans-Serif Inputs -->
        <div class="space-y-5">
          <div class="space-y-1">
            <label for="composer-name" class="block text-xs font-semibold text-[var(--text-secondary)]">
              <span data-lang="id">Nama / Instansi</span>
              <span data-lang="en">Your Name / Organization</span>
            </label>
            <input
              id="composer-name"
              type="text"
              placeholder="Contoh: Budi — PT Contoh Teknologi"
              class="w-full border-b border-[var(--border-strong)] focus:border-[var(--accent-primary)] bg-transparent py-2.5 font-sans text-base text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none transition-colors"
            />
          </div>

          <div class="space-y-1">
            <label for="composer-body" class="block text-xs font-semibold text-[var(--text-secondary)]">
              <span data-lang="id">Isi Pesan</span>
              <span data-lang="en">Message</span>
            </label>
            <textarea
              id="composer-body"
              rows="3"
              placeholder="Halo Gus Adi, saya tertarik untuk berdiskusi mengenai..."
              class="w-full border-b border-[var(--border-strong)] focus:border-[var(--accent-primary)] bg-transparent py-2.5 font-sans text-base text-[var(--text-primary)] placeholder:text-[var(--text-muted)] leading-relaxed focus:outline-none transition-colors resize-none"
            ></textarea>
          </div>
        </div>

        <!-- Open Subject Preview & Action Pills -->
        <div class="pt-2 space-y-4">
          <div class="text-xs text-[var(--text-muted)] truncate">
            <span class="font-semibold text-[var(--text-secondary)]">Subjek:</span>{' '}
            <span id="composer-preview-subject">[Portfolio] Internship / Role Opportunity</span>
          </div>
          <span id="composer-preview-body" class="hidden"></span>

          <div class="flex flex-wrap items-center gap-3">
            <a
              id="composer-mailto-link"
              href={`mailto:${profile.email}?subject=%5BPortfolio%5D%20Internship%20%2F%20Role%20Opportunity`}
              data-to={profile.email}
              class="pill-btn inline-flex items-center justify-center gap-2 bg-[var(--accent-primary)] text-[var(--accent-ink)] font-sans text-sm font-semibold px-6 py-3"
            >
              <Send class="w-4 h-4" />
              <span data-lang="id">{translations.id.contact.sendMailBtn}</span>
              <span data-lang="en">{translations.en.contact.sendMailBtn}</span>
            </a>

            <button
              type="button"
              id="composer-copy-btn"
              class="pill-btn inline-flex items-center justify-center gap-2 border border-[var(--border-strong)] hover:border-[var(--accent-primary)] text-[var(--text-primary)] font-sans text-sm font-medium px-5 py-3 cursor-pointer"
            >
              <Copy class="w-4 h-4 text-[var(--text-secondary)]" />
              <span data-lang="id">{translations.id.contact.copyDraftBtn}</span>
              <span data-lang="en">{translations.en.contact.copyDraftBtn}</span>
            </button>
          </div>
        </div>
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const defaultLabel = document.getElementById('copy-label-default');
  const doneLabel = document.getElementById('copy-label-done');

  copyBtn?.addEventListener('click', async () => {
    const email = copyBtn.getAttribute('data-email');
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
      defaultLabel?.classList.add('hidden');
      doneLabel?.classList.remove('hidden');
      window.dispatchEvent(
        new CustomEvent('portfolio:toast', { detail: { message: `✓ Email tersalin: ${email}` } })
      );
      setTimeout(() => {
        doneLabel?.classList.add('hidden');
        defaultLabel?.classList.remove('hidden');
      }, 1800);
    } catch (_) {}
  });

  const topicBtns = document.querySelectorAll<HTMLButtonElement>('.msg-topic-btn');
  const nameInput = document.getElementById('composer-name') as HTMLInputElement | null;
  const bodyInput = document.getElementById('composer-body') as HTMLTextAreaElement | null;
  const previewSubj = document.getElementById('composer-preview-subject');
  const previewBody = document.getElementById('composer-preview-body');
  const mailtoLink = document.getElementById('composer-mailto-link') as HTMLAnchorElement | null;
  const copyDraftBtn = document.getElementById('composer-copy-btn');

  let activeTopic = 'Internship / Role Opportunity';

  function syncComposer() {
    const sender = nameInput?.value.trim() || '';
    const msg = bodyInput?.value.trim() || 'Halo Gus Adi, saya mengunjungi portofolio Anda dan tertarik untuk terhubung.';
    const subject = `[Portfolio] ${activeTopic}${sender ? ` — ${sender}` : ''}`;
    const fullBody = sender ? `${msg}\n\nSalam,\n${sender}` : msg;

    if (previewSubj) previewSubj.textContent = subject;
    if (previewBody) previewBody.textContent = msg;

    if (mailtoLink) {
      const to = mailtoLink.getAttribute('data-to') || '';
      mailtoLink.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(fullBody)}`;
    }
  }

  topicBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeTopic = btn.getAttribute('data-msg-topic') || 'Collaboration';
      topicBtns.forEach((b) => {
        if (b === btn) {
          b.classList.add('bg-[var(--accent-primary)]', 'text-[var(--accent-ink)]', 'font-semibold');
          b.classList.remove('border', 'border-[var(--border-strong)]', 'text-[var(--text-secondary)]', 'font-medium');
        } else {
          b.classList.remove('bg-[var(--accent-primary)]', 'text-[var(--accent-ink)]', 'font-semibold');
          b.classList.add('border', 'border-[var(--border-strong)]', 'text-[var(--text-secondary)]', 'font-medium');
        }
      });
      syncComposer();
    });
  });

  nameInput?.addEventListener('input', syncComposer);
  bodyInput?.addEventListener('input', syncComposer);

  copyDraftBtn?.addEventListener('click', async () => {
    const subj = previewSubj?.textContent || '';
    const sender = nameInput?.value.trim() || '';
    const msg = bodyInput?.value.trim() || 'Halo Gus Adi, saya mengunjungi portofolio Anda dan tertarik untuk terhubung.';
    const draft = `Subject: ${subj}\n\n${msg}${sender ? `\n\n— ${sender}` : ''}`;
    try {
      await navigator.clipboard.writeText(draft);
      window.dispatchEvent(
        new CustomEvent('portfolio:toast', { detail: { message: '📋 Teks pesan berhasil disalin!' } })
      );
    } catch (_) {}
  });

  syncComposer();
</script>
