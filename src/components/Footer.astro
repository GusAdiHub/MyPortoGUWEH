---
import { translations } from '../data/i18n';
---

<footer class="w-full border-t border-[var(--border-subtle)] bg-[var(--bg-surface)]/60 py-10 font-sans text-xs text-[var(--text-muted)] select-none">
  <div class="w-full max-w-5xl mx-auto px-5 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <!-- Left: Clean Colophon -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-3">
      <span class="font-display font-bold text-base text-[var(--text-primary)]">
        Gus Adi<span class="text-[var(--accent-primary)]">.</span>
      </span>
      <span>·</span>
      <span class="text-[var(--text-secondary)]">{translations.id.footer.statuslineStack}</span>
      <span>·</span>
      <button
        type="button"
        id="footer-arcade-trigger"
        class="text-[var(--accent-primary)] hover:underline font-semibold cursor-pointer transition-colors"
      >
        🎮 Mini-Game Arcade
      </button>
    </div>

    <!-- Right: Copyright & Back to Top -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      <span class="text-[var(--text-secondary)]">{translations.id.footer.copyright}</span>
      <span id="footer-scroll-pct" class="hidden">0%</span>
      <a
        href="#hero"
        class="pill-btn bg-[var(--bg-elevated)] hover:bg-[var(--accent-primary)] hover:text-[var(--accent-ink)] text-[var(--text-primary)] font-semibold px-4 py-1.5 text-xs"
        aria-label="Scroll back to top"
      >
        <span data-lang="id">{translations.id.footer.backToTop}</span>
        <span data-lang="en">{translations.en.footer.backToTop}</span>
      </a>
    </div>
  </div>
</footer>

<script>
  document.getElementById('footer-arcade-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:open-arcade'));
  });
</script>
