---
import SectionHeader from './SectionHeader.astro';
import { profile } from '../data/profile';
import { translations } from '../data/i18n';
---

<section id="about" class="w-full py-16 sm:py-24 border-b border-[var(--border-subtle)]">
  <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-14">
    <SectionHeader
      index="01"
      title={{ id: 'TENTANG & FOKUS', en: 'ABOUT & FOCUS' }}
      path={translations.id.about.filePath}
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- Left Bento Card: Bio & Engineering Philosophy (7 cols) -->
      <div
        data-tilt
        class="lg:col-span-7 reveal-on-scroll bento-card p-6 sm:p-8 flex flex-col justify-between"
        style="--stagger: 0;"
      >
        <div class="space-y-5">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3 font-mono text-xs select-none">
            <span class="text-[var(--accent-primary)] font-semibold flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)]"></span>
              <span>$ cat about_me.md</span>
            </span>
            <span class="text-[var(--text-muted)]">{translations.id.about.bufferInfo}</span>
          </div>

          <h3 class="font-display text-xl sm:text-2xl font-bold text-[var(--text-primary)]">
            <span data-lang="id">Membangun Perangkat Lunak yang Terstruktur, Cepat, dan Pragmatis.</span>
            <span data-lang="en">Engineering Structured, Performant, and Pragmatic Software.</span>
          </h3>

          <!-- ID Bio -->
          <div data-lang="id" class="space-y-4 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            {profile.bio.id.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          <!-- EN Bio -->
          <div data-lang="en" class="space-y-4 text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
            {profile.bio.en.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

        <!-- Engineering Pillars -->
        <div class="pt-6 mt-6 border-t border-[var(--border-subtle)] flex flex-wrap gap-2.5 font-mono text-xs select-none">
          <span class="px-3 py-1.5 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--accent-primary)]">
            ✦ Clean Architecture
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--accent-secondary)]">
            ✦ Backend &amp; APIs
          </span>
          <span class="px-3 py-1.5 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--accent-tertiary)]">
            ✦ Applied Text Mining
          </span>
        </div>
      </div>

      <!-- Right Bento Card: Currently Exploring Interactive Tree (5 cols) -->
      <div
        data-tilt
        class="lg:col-span-5 reveal-on-scroll bento-card p-6 sm:p-8 flex flex-col justify-between font-mono text-xs select-none"
        style="--stagger: 1;"
      >
        <div>
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3 mb-5">
            <div class="flex items-center gap-3">
              <!-- Live Rotating R&D Radar -->
              <div class="relative w-8 h-8 rounded-full border border-[var(--border-focus)] bg-[var(--bg-base)] overflow-hidden flex items-center justify-center shrink-0">
                <div class="radar-sweep absolute inset-0 rounded-full"></div>
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)] relative z-10 shadow-[0_0_6px_var(--accent-primary)]"></span>
              </div>
              <span class="text-[var(--accent-secondary)] font-semibold">
                ~/workspace/{translations.id.about.treeTitle}
              </span>
            </div>
            <span class="px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--status-ok)] text-[10px]">
              ● ACTIVE_R&amp;D
            </span>
          </div>

          <!-- ID Exploring Cards -->
          <div data-lang="id" class="space-y-3">
            {profile.currentlyExploring.id.map((item, idx) => (
              <div class="group p-3.5 rounded-xl bg-[var(--bg-elevated)]/70 border border-[var(--border-subtle)] hover:border-[var(--accent-primary)] transition-all hover:translate-x-1 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] group-hover:border-[var(--accent-primary)] flex items-center justify-center text-[var(--accent-primary)] font-bold text-[11px]">
                    0{idx + 1}
                  </span>
                  <span class="text-[var(--text-primary)] font-medium text-xs sm:text-[13px]">{item}</span>
                </div>
                <span class="text-[10px] text-[var(--status-ok)] px-2 py-0.5 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] shrink-0">
                  {translations.id.about.activeTag}
                </span>
              </div>
            ))}
          </div>

          <!-- EN Exploring Cards -->
          <div data-lang="en" class="space-y-3">
            {profile.currentlyExploring.en.map((item, idx) => (
              <div class="group p-3.5 rounded-xl bg-[var(--bg-elevated)]/70 border border-[var(--border-subtle)] hover:border-[var(--accent-primary)] transition-all hover:translate-x-1 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="w-6 h-6 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] group-hover:border-[var(--accent-primary)] flex items-center justify-center text-[var(--accent-primary)] font-bold text-[11px]">
                    0{idx + 1}
                  </span>
                  <span class="text-[var(--text-primary)] font-medium text-xs sm:text-[13px]">{item}</span>
                </div>
                <span class="text-[10px] text-[var(--status-ok)] px-2 py-0.5 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] shrink-0">
                  {translations.en.about.activeTag}
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Bottom Live Clock & Location Strip -->
        <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between text-[11px] text-[var(--text-muted)]">
          <span>LOC: INDONESIA</span>
          <span id="about-local-clock" class="text-[var(--accent-primary)] font-semibold">UTC+8 // LIVE</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const clockEl = document.getElementById('about-local-clock');
  function updateLocalClock() {
    if (!clockEl) return;
    const now = new Date();
    const timeStr = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    clockEl.textContent = `LOCAL // ${timeStr}`;
  }
  updateLocalClock();
  setInterval(updateLocalClock, 1000);
</script>
