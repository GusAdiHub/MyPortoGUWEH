  });

  document.getElementById('hero-quick-copy-email')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLElement;
    const email = btn.getAttribute('data-email');
    if (!email) return;
    try {
      await navigator.clipboard.writeText(email);
