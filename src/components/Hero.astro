  function ensureLofiBus(): { ctx: AudioContext; out: GainNode } | null {
    const env = getCtx();
    if (!env) return null;
    const { ctx } = env;
    if (!lofiMasterGain) {
      lofiMasterGain = ctx.createGain();
      lofiMasterGain.gain.setValueAtTime(lofiVolume, ctx.currentTime);
      lofiMasterGain.connect(ctx.destination);
    }
    return { ctx, out: lofiMasterGain };
  }

  function startVinylTexture() {
    const bus = ensureLofiBus();
    if (!bus) return;
    stopVinylTexture();
    if (!lofiVinylOn) return;

    const { ctx, out } = bus;
    const bufLen = ctx.sampleRate * 3;
    const buffer = ctx.createBuffer(1, bufLen, ctx.sampleRate);
    const data = buffer.getChannelData(0);
    let b0 = 0;
    let b1 = 0;
    let b2 = 0;
    for (let i = 0; i < bufLen; i++) {
      const white = Math.random() * 2 - 1;
      b0 = 0.997 * b0 + white * 0.029;
      b1 = 0.985 * b1 + white * 0.032;
      b2 = 0.95 * b2 + white * 0.045;
      // Subtle vinyl dust pops
      const pop = Math.random() > 0.9985 ? (Math.random() * 2 - 1) * 0.35 : 0;
      data[i] = (b0 + b1 + b2) * 0.14 + pop;
    }

    const src = ctx.createBufferSource();
    src.buffer = buffer;
    src.loop = true;

    const filter = ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.setValueAtTime(1100, ctx.currentTime);
    filter.Q.setValueAtTime(0.7, ctx.currentTime);

    const vGain = ctx.createGain();
    const isRainTrack = LOFI_STATIONS[lofiIdx].style === 'rain';
    vGain.gain.setValueAtTime(isRainTrack ? 0.18 : 0.09, ctx.currentTime);

    src.connect(filter);
    filter.connect(vGain);
    vGain.connect(out);
    src.start();

    lofiVinylSource = src;
    lofiVinylGain = vGain;
  }

  function stopVinylTexture() {
    try {
      if (lofiVinylSource) {
        lofiVinylSource.stop();
        lofiVinylSource.disconnect();
        lofiVinylSource = null;
      }
      if (lofiVinylGain) {
        lofiVinylGain.disconnect();
        lofiVinylGain = null;
      }
    } catch (_) {}
  }

  function playLofiKick(ctx: AudioContext, out: AudioNode, time: number, punch = 0.26) {
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(118, time);
    osc.frequency.exponentialRampToValueAtTime(36, time + 0.14);
    gain.gain.setValueAtTime(punch, time);
    gain.gain.exponentialRampToValueAtTime(0.001, time + 0.22);
    osc.connect(gain);
    gain.connect(out);
    osc.start(time);
    osc.stop(time + 0.24);
  }

  function playLofiSnare(ctx: AudioContext, out: AudioNode, time: number, level = 0.12) {
    // Warm rimshot body + filtered noise snap
    const osc = ctx.createOscillator();
    const oscGain = ctx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(210, time);
    osc.frequency.exponentialRampToValueAtTime(95, time + 0.07);
    oscGain.gain.setValueAtTime(level, time);
    oscGain.gain.exponentialRampToValueAtTime(0.001, time + 0.09);
    osc.connect(oscGain);
    oscGain.connect(out);
    osc.start(time);
    osc.stop(time + 0.1);

    const len = Math.floor(ctx.sampleRate * 0.11);
    const nBuf = ctx.createBuffer(1, len, ctx.sampleRate);
    const ch = nBuf.getChannelData(0);
    for (let i = 0; i < len; i++) {
      ch[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ctx.sampleRate * 0.035));
    }
    const nSrc = ctx.createBufferSource();
    nSrc.buffer = nBuf;
    const filt = ctx.createBiquadFilter();
    filt.type = 'bandpass';
    filt.frequency.setValueAtTime(1650, time);
    const nGain = ctx.createGain();
    nGain.gain.setValueAtTime(level * 0.85, time);
    nGain.gain.exponentialRampToValueAtTime(0.001, time + 0.1);
    nSrc.connect(filt);
    filt.connect(nGain);
    nGain.connect(out);
    nSrc.start(time);
  }

  function playLofiHat(ctx: AudioContext, out: AudioNode, time: number, open = false) {
    const dur = open ? 0.14 : 0.045;
    const len = Math.floor(ctx.sampleRate * dur);
    const nBuf = ctx.createBuffer(1, len, ctx.sampleRate);
    const ch = nBuf.getChannelData(0);
    for (let i = 0; i < len; i++) {
      ch[i] = (Math.random() * 2 - 1) * Math.exp(-i / (ctx.sampleRate * (open ? 0.05 : 0.014)));
    }
    const nSrc = ctx.createBufferSource();
    nSrc.buffer = nBuf;
    const filt = ctx.createBiquadFilter();
    filt.type = 'highpass';
    filt.frequency.setValueAtTime(5200, time);
    const gain = ctx.createGain();
    gain.gain.setValueAtTime(open ? 0.05 : 0.035, time);
    gain.gain.exponentialRampToValueAtTime(0.001, time + dur);
    nSrc.connect(filt);
    filt.connect(gain);
    gain.connect(out);
    nSrc.start(time);
  }

  function playLofiChord(
    ctx: AudioContext,
    out: AudioNode,
    freqs: number[],
    station: LofiStation,
    durSec: number
  ) {
    const now = ctx.currentTime;
    const filter = ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.setValueAtTime(station.cutoff, now);
    filter.Q.setValueAtTime(1.2, now);
    filter.connect(out);

    freqs.forEach((f, idx) => {
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = station.wave;
      // Gentle analog tape detune
      const detune = (idx % 2 === 0 ? 1 : -1) * 4.5;
      osc.detune.setValueAtTime(detune, now);
      osc.frequency.setValueAtTime(f, now);

      const strumDelay = idx * 0.022;
      const noteStart = now + strumDelay;
      const peakGain = station.wave === 'sawtooth' || station.wave === 'square' ? 0.032 : 0.055;

      gain.gain.setValueAtTime(0.0001, noteStart);
      gain.gain.linearRampToValueAtTime(peakGain, noteStart + 0.08);
      gain.gain.exponentialRampToValueAtTime(0.0008, noteStart + durSec);

      osc.connect(gain);
      gain.connect(filter);
      osc.start(noteStart);
      osc.stop(noteStart + durSec + 0.04);
    });
  }

  function playLofiBassNote(ctx: AudioContext, out: AudioNode, freq: number, durSec: number) {
    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(freq, now);
    gain.gain.setValueAtTime(0.001, now);
    gain.gain.linearRampToValueAtTime(0.16, now + 0.03);
    gain.gain.exponentialRampToValueAtTime(0.001, now + durSec);
    osc.connect(gain);
    gain.connect(out);
    osc.start(now);
    osc.stop(now + durSec + 0.02);
  }

  function playLofiMelodyPluck(ctx: AudioContext, out: AudioNode, freq: number, station: LofiStation) {
    const now = ctx.currentTime;
    const osc = ctx.createOscillator();
    const filt = ctx.createBiquadFilter();
    const gain = ctx.createGain();

    osc.type = station.melodyWave;
    osc.frequency.setValueAtTime(freq, now);

    filt.type = 'lowpass';
    filt.frequency.setValueAtTime(station.cutoff * 1.6, now);

    const peak = station.melodyWave === 'square' ? 0.035 : 0.065;
    gain.gain.setValueAtTime(0.001, now);
    gain.gain.linearRampToValueAtTime(peak, now + 0.015);
    gain.gain.exponentialRampToValueAtTime(0.0008, now + 0.52);

    osc.connect(filt);
    filt.connect(gain);
    gain.connect(out);
    osc.start(now);
    osc.stop(now + 0.55);
  }

  function animateEqualizer() {
    if (!lofiEqBars) return;
    const spans = lofiEqBars.querySelectorAll<HTMLElement>('span');
    spans.forEach((bar) => {
      if (!lofiPlaying) {
        bar.style.height = '4px';
      } else {
        const h = 4 + Math.floor(Math.random() * 10);
        bar.style.height = `${h}px`;
      }
    });
  }

  function runLofiStep() {
    if (!lofiPlaying) return;
    const bus = ensureLofiBus();
    if (!bus) return;

    const { ctx, out } = bus;
    const station = LOFI_STATIONS[lofiIdx];
    const stepDurSec = 60 / station.bpm / 4; // 16th note duration
    const barStep = lofiStep % 16;
    const chordIdx = Math.floor(lofiStep / 16) % station.chords.length;
    // Slight MPC lo-fi swing on odd 16th steps
    const swingOffset = barStep % 2 === 1 ? stepDurSec * 0.18 : 0;
    const hitTime = ctx.currentTime + swingOffset;

    // 1. Trigger lush warm chord on beat 1 (barStep === 0) and gentle re-strum on beat 3 (barStep === 8)
    if (barStep === 0) {
      playLofiChord(ctx, out, station.chords[chordIdx], station, stepDurSec * 15.5);
      playLofiBassNote(ctx, out, station.bass[chordIdx], stepDurSec * 7.5);
    } else if (barStep === 8) {
      playLofiBassNote(ctx, out, station.bass[chordIdx], stepDurSec * 5.5);
    } else if (barStep === 14 && station.style === 'drive') {
      playLofiBassNote(ctx, out, station.bass[chordIdx] * 1.5, stepDurSec * 1.8);
    }

    // 2. Drum groove per station style
    if (station.style === 'boombap' || station.style === 'chip') {
      if (barStep === 0 || barStep === 7 || barStep === 10) playLofiKick(ctx, out, hitTime, 0.24);
      if (barStep === 4 || barStep === 12) playLofiSnare(ctx, out, hitTime, 0.11);
      if (barStep % 2 === 0) playLofiHat(ctx, out, hitTime, barStep === 14);
    } else if (station.style === 'rain') {
      if (barStep === 0 || barStep === 10) playLofiKick(ctx, out, hitTime, 0.18);
      if (barStep === 4 || barStep === 12) playLofiSnare(ctx, out, hitTime, 0.07);
      if (barStep % 4 === 0) playLofiHat(ctx, out, hitTime, false);
    } else if (station.style === 'drive') {
      if (barStep === 0 || barStep === 6 || barStep === 10) playLofiKick(ctx, out, hitTime, 0.27);
      if (barStep === 4 || barStep === 12) playLofiSnare(ctx, out, hitTime, 0.13);
      if (barStep % 2 === 0 || barStep === 15) playLofiHat(ctx, out, hitTime, barStep === 6);
    } else if (station.style === 'breeze') {
      if (barStep === 0 || barStep === 9) playLofiKick(ctx, out, hitTime, 0.2);
      if (barStep === 4 || barStep === 12) playLofiSnare(ctx, out, hitTime, 0.085);
      if (barStep % 2 === 0) playLofiHat(ctx, out, hitTime, false);
    }

    // 3. Improvised gentle Lo-Fi melody plucks
    const melodyTriggerSteps = [2, 6, 9, 11, 14];
    if (melodyTriggerSteps.includes(barStep) && Math.random() > 0.32) {
      const noteFreq = station.melody[(lofiStep + chordIdx * 2) % station.melody.length];
      playLofiMelodyPluck(ctx, out, noteFreq, station);
    }

    animateEqualizer();
    lofiStep++;
  }

  function syncLofiUI() {
    const station = LOFI_STATIONS[lofiIdx];
    if (lofiTitleEl) lofiTitleEl.textContent = station.title;
    if (lofiSubEl) lofiSubEl.textContent = station.sub;

    if (lofiStatusEl) {
      lofiStatusEl.textContent = lofiPlaying ? `LIVE · ${station.bpm} BPM` : 'STANDBY';
      lofiStatusEl.className = lofiPlaying
        ? 'px-2 py-0.5 rounded-full bg-[var(--tint-mint)] font-mono text-[10px] font-extrabold text-teal-950'
        : 'px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] font-mono text-[10px] font-bold text-[var(--text-muted)]';
    }

    if (lofiPlayLabel) lofiPlayLabel.textContent = lofiPlaying ? 'Pause' : 'Play';
    if (lofiIconPlay && lofiIconPause) {
      if (lofiPlaying) {
        lofiIconPlay.classList.add('hidden');
        lofiIconPause.classList.remove('hidden');
      } else {
        lofiIconPlay.classList.remove('hidden');
        lofiIconPause.classList.add('hidden');
      }
    }

    if (lofiEqBars) {
      lofiEqBars.style.opacity = lofiPlaying ? '1' : '0.35';
    }

    lofiStationBtns.forEach((btn, i) => {
      if (i === lofiIdx) {
        btn.className =
          'lofi-station-btn px-2.5 py-1 rounded-xl bg-[var(--accent-primary)] text-[var(--accent-ink)] text-[10px] font-extrabold cursor-pointer transition-all shadow-2xs';
      } else {
        btn.className =
          'lofi-station-btn px-2.5 py-1 rounded-xl bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] text-[10px] font-bold cursor-pointer transition-all';
      }
    });

    if (lofiRainBtn) {
      lofiRainBtn.className = lofiVinylOn
        ? 'px-2 py-0.5 rounded-lg bg-[var(--tint-sky)] text-blue-950 font-sans text-[10px] font-extrabold inline-flex items-center gap-1 cursor-pointer shrink-0'
        : 'px-2 py-0.5 rounded-lg bg-[var(--bg-surface)] text-[var(--text-muted)] font-sans text-[10px] font-bold inline-flex items-center gap-1 cursor-pointer shrink-0 opacity-60';
    }
  }

  function startLofiPlayback() {
    const bus = ensureLofiBus();
    if (!bus) return;
    if (lofiTimer) window.clearInterval(lofiTimer);

    lofiPlaying = true;
    const station = LOFI_STATIONS[lofiIdx];
    const stepMs = (60 / station.bpm / 4) * 1000;

    startVinylTexture();
    runLofiStep();
    lofiTimer = window.setInterval(runLofiStep, stepMs);
    syncLofiUI();

    window.dispatchEvent(
      new CustomEvent('portfolio:toast', {
        detail: { message: `🎧 Memutar Lo-Fi: ${station.title}` },
      })
    );
  }

  function stopLofiPlayback() {
    lofiPlaying = false;
    if (lofiTimer) {
      window.clearInterval(lofiTimer);
      lofiTimer = null;
    }
    stopVinylTexture();
    animateEqualizer();
    syncLofiUI();
  }

  function selectLofiStation(newIdx: number, autoPlay = true) {
    lofiIdx = (newIdx + LOFI_STATIONS.length) % LOFI_STATIONS.length;
    lofiStep = 0;
    if (autoPlay || lofiPlaying) {
      startLofiPlayback();
    } else {
      syncLofiUI();
    }
  }

  lofiPlayBtn?.addEventListener('click', () => {
    if (lofiPlaying) {
      stopLofiPlayback();
    } else {
      startLofiPlayback();
    }
  });

  lofiPrevBtn?.addEventListener('click', () => {
    selectLofiStation(lofiIdx - 1, true);
  });

  lofiNextBtn?.addEventListener('click', () => {
    selectLofiStation(lofiIdx + 1, true);
  });

  lofiStationBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-lofi-idx') || '0');
      if (idx === lofiIdx && lofiPlaying) {
        stopLofiPlayback();
      } else {
        selectLofiStation(idx, true);
      }
    });
  });

  lofiVolSlider?.addEventListener('input', () => {
    const val = Math.max(0, Math.min(100, Number(lofiVolSlider.value)));
    lofiVolume = val / 100;
    if (lofiVolLabel) lofiVolLabel.textContent = `${val}%`;
    if (lofiMasterGain && audioCtx) {
      lofiMasterGain.gain.setValueAtTime(lofiVolume, audioCtx.currentTime);
    }
    try {
      localStorage.setItem('portfolio-lofi-volume', String(val));
    } catch (_) {}
  });

  lofiRainBtn?.addEventListener('click', () => {
    lofiVinylOn = !lofiVinylOn;
    if (lofiPlaying) {
      if (lofiVinylOn) startVinylTexture();
      else stopVinylTexture();
    }
    syncLofiUI();
  });

  syncLofiUI();

  // 6. Studio Theme Accent Buttons, Background Ambience Worlds & Canvas FX
  const bgSceneBtns = document.querySelectorAll<HTMLButtonElement>('.hero-bg-scene-btn');

  function syncBgSceneButtons(activeScene: string) {
    bgSceneBtns.forEach((btn) => {
      const s = btn.getAttribute('data-bg-scene') || 'studio';
      if (s === activeScene) {
        btn.className =
          'hero-bg-scene-btn px-3 py-1 rounded-full bg-[var(--accent-primary)] text-[var(--accent-ink)] text-xs font-extrabold cursor-pointer transition-all hover:scale-105 shadow-2xs';
      } else {
        btn.className =
          'hero-bg-scene-btn px-3 py-1 rounded-full bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] border border-transparent text-xs font-bold cursor-pointer transition-all hover:scale-105';
      }
    });
  }

  syncBgSceneButtons(document.documentElement.getAttribute('data-bg-scene') || 'studio');

  bgSceneBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const scene = btn.getAttribute('data-bg-scene') || 'studio';
      const label = btn.getAttribute('data-bg-label') || scene;
      syncBgSceneButtons(scene);
      window.dispatchEvent(new CustomEvent('portfolio:set-bg-scene', { detail: { scene, label } }));
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.hero-accent-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const accent = btn.getAttribute('data-hero-accent') || 'emerald';
      const label = btn.getAttribute('data-hero-accent-label') || accent;
      window.dispatchEvent(new CustomEvent('portfolio:set-accent', { detail: { accent, label } }));
    });
  });

  document.getElementById('hero-fx-serpent')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:toggle-serpent'));
  });
  document.getElementById('hero-fx-matrix')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:toggle-matrix'));
  });
  document.getElementById('hero-fx-barrel')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:barrel-roll'));
  });

  // 6. Pocket CLI Shell
  const shellOutput = document.getElementById('hero-shell-output');
  const shellForm = document.getElementById('hero-shell-form') as HTMLFormElement | null;
  const shellInput = document.getElementById('hero-shell-input') as HTMLInputElement | null;

  function execShellCommand(rawCmd: string) {
    const cmd = rawCmd.trim().toLowerCase();
    if (!cmd || !shellOutput) return;

    if (cmd === 'clear') {
      shellOutput.innerHTML = '<div class="text-[var(--text-muted)]">// cleared</div>';
      return;
    }

    const promptLine = document.createElement('div');
    promptLine.className = 'text-[var(--accent-primary)] font-bold';
    promptLine.textContent = `$ ${cmd}`;
    shellOutput.appendChild(promptLine);

    const resLine = document.createElement('div');
    resLine.className = 'text-[var(--text-secondary)] animate-boot-line pl-1.5';

    if (cmd === 'help') {
      resLine.textContent = 'whoami, lofi, stack, projects, ular, party, clear';
    } else if (cmd === 'lofi') {
      if (lofiPlaying) {
        stopLofiPlayback();
        resLine.textContent = '⏸ Radio Lo-Fi dijeda.';
      } else {
        startLofiPlayback();
        resLine.textContent = `🎧 Memutar ${LOFI_STATIONS[lofiIdx].title}`;
      }
    } else if (cmd === 'game' || cmd === 'arcade' || cmd === 'ular') {
      window.dispatchEvent(new CustomEvent('portfolio:open-arcade', { detail: { tab: 'snake' } }));
      resLine.textContent = 'Membuka Arcade...';
    } else if (cmd === 'whoami') {
      resLine.textContent = 'Gus Adi — Software Developer (Bali, Indonesia)';
    } else if (cmd === 'stack') {
      resLine.textContent = 'TS, JS, Python, Astro, Tailwind, Node, SQL';
    } else if (cmd === 'projects') {
      resLine.textContent = '01: Plagiarism Checker | 02: SakuKu Web App';
    } else if (cmd === 'party') {
      window.dispatchEvent(new CustomEvent('portfolio:fireworks'));
      resLine.textContent = '🎉 Konfeti diluncurkan!';
    } else {
      resLine.textContent = `Perintah "${cmd}" tidak dikenal.`;
    }

    shellOutput.appendChild(resLine);
    shellOutput.scrollTop = shellOutput.scrollHeight;
  }

  shellForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!shellInput) return;
    execShellCommand(shellInput.value);
    shellInput.value = '';
  });

  document.querySelectorAll<HTMLButtonElement>('.shell-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-shell-cmd');
      if (cmd) execShellCommand(cmd);
    });
  });
</script>
