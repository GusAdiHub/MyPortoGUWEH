      </div>

      <!-- POD C (3 Cols): Pocket Interactive Terminal -->
      <div class="md:col-span-3 tactile-card p-5 flex flex-col justify-between gap-3 reveal-on-scroll font-mono text-xs" style="--stagger: 3;">
        <div class="flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 font-sans text-xs font-extrabold uppercase tracking-wider text-[var(--text-primary)]">
            <Terminal class="w-4 h-4 text-[var(--accent-primary)]" />
            <span>&gt;_ Pocket CLI</span>
          </span>
          <span id="hero-uptime-counter" class="text-[10px] text-[var(--text-muted)]">00:00:01</span>
        </div>

        <div class="flex flex-wrap gap-1 text-[10px]">
          <button type="button" data-shell-cmd="whoami" class="shell-preset-btn px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] hover:text-[var(--accent-primary)] cursor-pointer">whoami</button>
          <button type="button" data-shell-cmd="stack" class="shell-preset-btn px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] hover:text-[var(--accent-primary)] cursor-pointer">stack</button>
          <button type="button" data-shell-cmd="ular" class="shell-preset-btn px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] text-[var(--accent-primary)] cursor-pointer">ular</button>
          <button type="button" data-shell-cmd="party" class="shell-preset-btn px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] text-[var(--accent-secondary)] cursor-pointer">party</button>
        </div>

        <div id="hero-shell-output" class="space-y-1 text-[11px] h-[74px] overflow-y-auto p-2.5 rounded-xl bg-[var(--bg-elevated)]/70">
          <div class="text-[var(--status-ok)]">&gt; Ready. Ketik help / klik chip.</div>
        </div>

        <form id="hero-shell-form" class="border-b-2 border-[var(--border-subtle)] focus-within:border-[var(--accent-primary)] pb-1 flex items-center gap-1.5">
          <span class="text-[var(--accent-primary)] font-bold">$</span>
          <input
            id="hero-shell-input"
            type="text"
            placeholder="perintah..."
            autocomplete="off"
            class="w-full bg-transparent text-xs text-[var(--text-primary)] placeholder:text-[var(--text-muted)] focus:outline-none"
          />
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // 1. Uptime Counter
  const uptimeEl = document.getElementById('hero-uptime-counter');
  let seconds = 1;
  setInterval(() => {
    seconds++;
    if (uptimeEl) {
      const hrs = String(Math.floor(seconds / 3600)).padStart(2, '0');
      const mins = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
      const secs = String(seconds % 60).padStart(2, '0');
      uptimeEl.textContent = `${hrs}:${mins}:${secs}`;
    }
  }, 1000);

  // 2. Smooth Rotating Specialization Badge
  const rotatingBadge = document.getElementById('hero-rotating-badge');
  const rotatingTopics = [
    'Web & Backend Engineering',
    'Applied NLP & Text Mining',
    'Clean TypeScript & Python',
    'Interactive UI Architecture',
  ];
  let topicIdx = 0;

  if (rotatingBadge && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    setInterval(() => {
      topicIdx = (topicIdx + 1) % rotatingTopics.length;
      rotatingBadge.classList.remove('animate-word-slide');
      void rotatingBadge.offsetWidth;
      rotatingBadge.textContent = rotatingTopics[topicIdx];
      rotatingBadge.classList.add('animate-word-slide');
    }, 3000);
  }

  // 3. Indonesian Viral Meme Soundboard (id-ID Voice SpeechSynthesis + WebAudio Meme Stingers + Volume Control)
  let audioCtx: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  const noteStatus = document.getElementById('synth-note-status');
  const volSlider = document.getElementById('sfx-volume-slider') as HTMLInputElement | null;
  const volLabel = document.getElementById('sfx-volume-label');
  const muteBtn = document.getElementById('sfx-mute-btn');
  const volIconOn = document.getElementById('sfx-vol-icon-on');
  const volIconOff = document.getElementById('sfx-vol-icon-off');

  let sfxVolume = 0.75;
  let isSfxMuted = false;

  // Restore saved volume safely
  try {
    const savedVol = localStorage.getItem('portfolio-sfx-volume');
    if (savedVol !== null) {
      const parsed = Number(savedVol);
      if (!Number.isNaN(parsed) && parsed >= 0 && parsed <= 100) {
        sfxVolume = parsed / 100;
        if (volSlider) volSlider.value = String(parsed);
      }
    }
  } catch (_) {}

  function getEffectiveVolume(): number {
    return isSfxMuted ? 0 : sfxVolume;
  }

  function syncVolumeUI() {
    const effective = getEffectiveVolume();
    const pct = Math.round(effective * 100);
    if (volLabel) {
      volLabel.textContent = isSfxMuted || pct === 0 ? 'MUTE' : `${pct}%`;
    }
    if (volIconOn && volIconOff) {
      if (isSfxMuted || pct === 0) {
        volIconOn.classList.add('hidden');
        volIconOff.classList.remove('hidden');
      } else {
        volIconOn.classList.remove('hidden');
        volIconOff.classList.add('hidden');
      }
    }
    if (activeAudio) {
      activeAudio.volume = effective;
    }
    if (masterGain && audioCtx) {
      masterGain.gain.setValueAtTime(effective, audioCtx.currentTime);
    }
  }

  function getCtx(): { ctx: AudioContext; out: AudioNode } | null {
    try {
      const AudioContextClass =
        window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      if (!audioCtx) {
        audioCtx = new AudioContextClass();
        masterGain = audioCtx.createGain();
        masterGain.gain.setValueAtTime(getEffectiveVolume(), audioCtx.currentTime);
        masterGain.connect(audioCtx.destination);
      }
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return { ctx: audioCtx, out: masterGain || audioCtx.destination };
    } catch (_) {
      return null;
    }
  }

  function speakIndoMeme(text: string, pitch = 1.0, rate = 1.05) {
    try {
      const vol = getEffectiveVolume();
      if (vol <= 0 || !('speechSynthesis' in window)) return;
      window.speechSynthesis.cancel();
      const utter = new SpeechSynthesisUtterance(text);
      utter.lang = 'id-ID';
      utter.pitch = pitch;
      utter.rate = rate;
      utter.volume = vol;

      const voices = window.speechSynthesis.getVoices();
      const indoVoice =
        voices.find((v) => v.lang.toLowerCase().includes('id-id') || v.lang.toLowerCase().includes('id_id')) ||
        voices.find((v) => v.lang.toLowerCase().startsWith('id')) ||
        voices.find((v) => v.lang.toLowerCase().includes('ms'));
      if (indoVoice) utter.voice = indoVoice;

      window.speechSynthesis.speak(utter);
    } catch (_) {}
  }

  // Preload voices in browser
  if ('speechSynthesis' in window) {
    window.speechSynthesis.getVoices();
    window.speechSynthesis.onvoiceschanged = () => {
      window.speechSynthesis.getVoices();
    };
  }

  function playVineBoom(ctx: AudioContext, out: AudioNode, startAt = 0) {
    const now = ctx.currentTime + startAt;
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(135, now);
    osc.frequency.exponentialRampToValueAtTime(32, now + 0.55);
    gain.gain.setValueAtTime(0.28, now);
    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
    osc.connect(gain);
    gain.connect(out);
    osc.start(now);
    osc.stop(now + 0.62);
  }

  function playFunnySfx(type: string, label: string) {
    const audioEnv = getCtx();
    if (noteStatus) {
      noteStatus.textContent = label;
    }
    window.dispatchEvent(new CustomEvent('portfolio:toast', { detail: { message: label } }));

    if (!audioEnv || getEffectiveVolume() <= 0) return;
    const { ctx, out } = audioEnv;
    const now = ctx.currentTime;

    if (type === 'antek') {
      // "HEY ANTEK-ANTEK ASING!!" + Dramatic Podium Horn + Vine Boom
      speakIndoMeme('Hei! Antek antek asing! Jangan macam-macam!', 0.82, 1.08);
      playVineBoom(ctx, out, 0);
      [220, 277.18, 329.63].forEach((freq) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(freq, now);
        gain.gain.setValueAtTime(0.05, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);
        osc.connect(gain);
        gain.connect(out);
        osc.start(now);
        osc.stop(now + 0.46);
      });
    } else if (type === 'gokgok') {
      // "GOK GOK GOK GOK GOK!!" + Rapid Energetic Bark Synth
      speakIndoMeme('Gok! Gok! Gok! Gok! Gok! Guk guk guk!', 1.35, 1.35);
      [0, 0.14, 0.28, 0.42, 0.56].forEach((offset, idx) => {
        const osc = ctx.createOscillator();
        const filter = ctx.createBiquadFilter();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        const baseF = idx % 2 === 0 ? 320 : 390;
        osc.frequency.setValueAtTime(baseF, now + offset);
        osc.frequency.exponentialRampToValueAtTime(580, now + offset + 0.04);
        osc.frequency.exponentialRampToValueAtTime(190, now + offset + 0.11);

        filter.type = 'bandpass';
        filter.frequency.setValueAtTime(950, now + offset);
        filter.Q.setValueAtTime(3.5, now + offset);

        gain.gain.setValueAtTime(0.14, now + offset);
        gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.11);

        osc.connect(filter);
        filter.connect(gain);
        gain.connect(out);
        osc.start(now + offset);
        osc.stop(now + offset + 0.12);
      });
    } else if (type === 'basuri') {
      // "Om Telolet Om!" + Iconic Basuri V3 Snaking Bus Horn Melody!
      speakIndoMeme('Om, telolet om!', 1.2, 1.15);
      const basuriNotes = [
        { f: 523.25, t: 0.25, d: 0.11 }, // C5
        { f: 659.25, t: 0.37, d: 0.11 }, // E5
        { f: 783.99, t: 0.49, d: 0.11 }, // G5
        { f: 1046.5, t: 0.61, d: 0.16 }, // C6
        { f: 783.99, t: 0.78, d: 0.11 }, // G5
        { f: 1046.5, t: 0.90, d: 0.14 }, // C6
        { f: 987.77, t: 1.05, d: 0.11 }, // B5
        { f: 880.00, t: 1.17, d: 0.11 }, // A5
        { f: 783.99, t: 1.29, d: 0.11 }, // G5
        { f: 659.25, t: 1.41, d: 0.11 }, // E5
        { f: 783.99, t: 1.53, d: 0.28 }, // G5
      ];
      basuriNotes.forEach((n) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(n.f, now + n.t);
        gain.gain.setValueAtTime(0.08, now + n.t);
        gain.gain.exponentialRampToValueAtTime(0.001, now + n.t + n.d);
        osc.connect(gain);
        gain.connect(out);
        osc.start(now + n.t);
        osc.stop(now + n.t + n.d + 0.01);
      });
    } else if (type === 'bercyanda') {
      // "Bercyandaaa~ Bercyandaaa~" + Sparkle Chime
      speakIndoMeme('Bercyandaaa! Bercyandaaa!', 1.55, 1.05);
      [587.33, 880, 1174.66, 1567.98].forEach((f, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(f, now + i * 0.06);
        gain.gain.setValueAtTime(0.08, now + i * 0.06);
        gain.gain.exponentialRampToValueAtTime(0.001, now + i * 0.06 + 0.35);
        osc.connect(gain);
        gain.connect(out);
        osc.start(now + i * 0.06);
        osc.stop(now + i * 0.06 + 0.36);
      });
    } else if (type === 'chuaks') {
      // "CHUAAAKS!!" + Heavy Vine Boom Drop
      speakIndoMeme('Chuaaaks!', 1.25, 1.25);
      playVineBoom(ctx, out, 0.12);
      playVineBoom(ctx, out, 0.42);
    } else if (type === 'slebew') {
      // "SLEBEWWW!!" + Laser Drop + Confetti
      speakIndoMeme('Slebewww!', 0.9, 1.1);
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sawtooth';
      osc.frequency.setValueAtTime(980, now);
      osc.frequency.exponentialRampToValueAtTime(65, now + 0.45);
      gain.gain.setValueAtTime(0.11, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.48);
      osc.connect(gain);
      gain.connect(out);
      osc.start(now);
      osc.stop(now + 0.5);
      window.dispatchEvent(new CustomEvent('portfolio:fireworks'));
    } else if (type === 'kijang') {
      // HT Walkie-Talkie Beep + "Kijang satu, kijang satu, ganti!"
      [0, 0.07].forEach((offset) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'square';
        osc.frequency.setValueAtTime(1850, now + offset);
        gain.gain.setValueAtTime(0.06, now + offset);
        gain.gain.exponentialRampToValueAtTime(0.001, now + offset + 0.05);
        osc.connect(gain);
        gain.connect(out);
        osc.start(now + offset);
        osc.stop(now + offset + 0.055);
      });
      speakIndoMeme('Kijang satu, kijang satu, target terpantau aman, ganti!', 0.78, 1.15);
    } else if (type === 'mental') {
      // "Waduh, kena mental bos!" + Sad Trombone Womp Womp
      speakIndoMeme('Waduh, kena mental bos!', 1.1, 1.12);
      const notes = [
        { f1: 293.66, f2: 285, t: 0.15, d: 0.2 },
        { f1: 277.18, f2: 268, t: 0.38, d: 0.2 },
        { f1: 261.63, f2: 252, t: 0.61, d: 0.2 },
        { f1: 246.94, f2: 190, t: 0.84, d: 0.5 },
      ];
      notes.forEach((n) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sawtooth';
        osc.frequency.setValueAtTime(n.f1, now + n.t);
        osc.frequency.linearRampToValueAtTime(n.f2, now + n.t + n.d);
        gain.gain.setValueAtTime(0.06, now + n.t);
        gain.gain.exponentialRampToValueAtTime(0.001, now + n.t + n.d);
        osc.connect(gain);
        gain.connect(out);
        osc.start(now + n.t);
        osc.stop(now + n.t + n.d + 0.02);
      });
    }
  }

  let activeAudio: HTMLAudioElement | null = null;

  syncVolumeUI();

  volSlider?.addEventListener('input', () => {
    const val = Number(volSlider.value);
    sfxVolume = Math.max(0, Math.min(100, val)) / 100;
    if (sfxVolume > 0 && isSfxMuted) {
      isSfxMuted = false;
    }
    try {
      localStorage.setItem('portfolio-sfx-volume', String(Math.round(sfxVolume * 100)));
    } catch (_) {}
    syncVolumeUI();
  });

  muteBtn?.addEventListener('click', () => {
    isSfxMuted = !isSfxMuted;
    if (isSfxMuted) {
      stopAllSfx();
    }
    syncVolumeUI();
  });

  function stopAllSfx() {
    try {
      if (activeAudio) {
        activeAudio.pause();
        activeAudio.currentTime = 0;
        activeAudio = null;
      }
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      if (noteStatus) {
        noteStatus.textContent = '⏹ Dihentikan';
      }
    } catch (_) {}
  }

  function playMyInstantOrFallback(mp3Url: string, fallbackSfx: string, label: string) {
    stopAllSfx();
    const vol = getEffectiveVolume();
    if (noteStatus) {
      noteStatus.textContent = vol <= 0 ? `🔇 (Muted) ${label}` : label;
    }
    window.dispatchEvent(new CustomEvent('portfolio:toast', { detail: { message: label } }));

    if (vol <= 0) return;

    if (mp3Url) {
      try {
