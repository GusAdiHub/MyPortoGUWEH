  'bg-[var(--tint-sky)] text-blue-950 border-blue-600/20',
  'bg-[var(--tint-violet)] text-violet-950 border-violet-600/20',
];

// Verified working MyInstants CDN MP3s (enriched by live fetch from myinstants.com/en/categories/sound%20effects/gb/)
let memePads: MyInstantItem[] = [
