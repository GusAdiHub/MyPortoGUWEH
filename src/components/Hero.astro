        <!-- Lo-Fi Volume Slider + Rain/Vinyl Ambience Toggle -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-elevated)]/80 border border-[var(--border-subtle)]">
          <Volume2 class="w-3.5 h-3.5 text-[var(--accent-primary)] shrink-0" />
          <label for="lofi-volume-slider" class="sr-only">Volume Lo-Fi</label>
          <input
            id="lofi-volume-slider"
            type="range"
            min="0"
            max="100"
            value="65"
            class="w-full h-1.5 rounded-lg appearance-none bg-[var(--border-strong)] accent-[var(--accent-primary)] cursor-pointer"
          />
          <span id="lofi-volume-label" class="font-mono text-[10px] font-extrabold text-[var(--text-primary)] min-w-[30px] text-right">
            65%
          </span>
          <button
            type="button"
            id="lofi-rain-btn"
            class="px-2 py-0.5 rounded-lg bg-[var(--tint-sky)] text-blue-950 font-sans text-[10px] font-extrabold inline-flex items-center gap-1 cursor-pointer shrink-0"
            title="Toggle efek derau piringan hitam / hujan"
          >
            <CloudRain class="w-3 h-3 text-blue-700" />
            <span>Vinyl</span>
          </button>
        </div>

        <!-- Compact Studio Theme & Canvas FX Footer -->
        <div class="pt-2 border-t border-[var(--border-subtle)] flex items-center justify-between gap-1.5">
          <div class="flex items-center gap-1.5" role="group" aria-label="Pilih warna aksen">
            <Palette class="w-3.5 h-3.5 text-[var(--text-muted)] mr-0.5" />
            <button type="button" data-hero-accent="emerald" data-hero-accent-label="Mint Emerald" class="hero-accent-btn w-4 h-4 rounded-full bg-[#0d9488] hover:scale-125 transition-transform cursor-pointer" title="Mint Emerald"></button>
            <button type="button" data-hero-accent="coral" data-hero-accent-label="Sunset Coral" class="hero-accent-btn w-4 h-4 rounded-full bg-[#ea580c] hover:scale-125 transition-transform cursor-pointer" title="Sunset Coral"></button>
            <button type="button" data-hero-accent="ocean" data-hero-accent-label="Royal Ocean" class="hero-accent-btn w-4 h-4 rounded-full bg-[#2563eb] hover:scale-125 transition-transform cursor-pointer" title="Royal Ocean"></button>
            <button type="button" data-hero-accent="violet" data-hero-accent-label="Electric Violet" class="hero-accent-btn w-4 h-4 rounded-full bg-[#7c3aed] hover:scale-125 transition-transform cursor-pointer" title="Electric Violet"></button>
          </div>
          <div class="flex items-center gap-1">
            <button type="button" id="hero-fx-serpent" class="px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] hover:bg-[var(--accent-primary)] hover:text-white text-[10px] font-bold cursor-pointer transition-colors" title="Animasi Ular Latar">🐍</button>
            <button type="button" id="hero-fx-matrix" class="px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] hover:bg-[var(--accent-primary)] hover:text-white text-[10px] font-bold cursor-pointer transition-colors" title="Efek Matrix">🌧️</button>
            <button type="button" id="hero-fx-barrel" class="px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] hover:bg-[var(--accent-primary)] hover:text-white text-[10px] font-bold cursor-pointer transition-colors" title="360 Spin">🔄</button>
