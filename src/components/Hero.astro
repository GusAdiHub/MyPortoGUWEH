  // 5. Audio-Only YouTube Music Player + Interactive Clickable Tracklist (Default: PLqIiu63tUd9yTmMIbywqHleGYFx5K0cIc)
  interface YtVideoData {
    video_id?: string;
    title?: string;
    author?: string;
  }

  interface YtPlayerInstance {
    playVideo: () => void;
    pauseVideo: () => void;
    nextVideo: () => void;
    previousVideo: () => void;
    playVideoAt: (index: number) => void;
    setVolume: (volume: number) => void;
    setShuffle: (shufflePlaylist: boolean) => void;
    setLoop: (loopPlaylists: boolean) => void;
    getPlaylist: () => string[] | null;
    getPlaylistIndex: () => number;
    getVideoData: () => YtVideoData;
    getPlayerState: () => number;
    cueVideoById: (videoId: string) => void;
    loadVideoById: (videoId: string) => void;
    cuePlaylist: (playlist: string | string[] | { listType: string; list: string; index?: number }, index?: number) => void;
    loadPlaylist: (playlist: string | string[] | { listType: string; list: string; index?: number }, index?: number) => void;
  }

  interface TrackMeta {
    videoId: string;
    title: string;
    artist: string;
  }

  const ytExternalLink = document.getElementById('yt-music-external-link') as HTMLAnchorElement | null;
  const ytTrackBadge = document.getElementById('yt-track-badge');
  const ytCoverArt = document.getElementById('yt-cover-art') as HTMLImageElement | null;
  const ytEqBars = document.getElementById('yt-eq-bars');
  const ytNowTitle = document.getElementById('yt-now-title');
  const ytNowArtist = document.getElementById('yt-now-artist');
  const ytTracklistEl = document.getElementById('yt-tracklist');
  const ytPlaylistNameTag = document.getElementById('yt-playlist-name-tag');

  const lofiPlayBtn = document.getElementById('lofi-play-btn');
  const lofiPlayLabel = document.getElementById('lofi-play-label');
  const lofiIconPlay = document.getElementById('lofi-icon-play');
  const lofiIconPause = document.getElementById('lofi-icon-pause');
  const lofiPrevBtn = document.getElementById('lofi-prev-btn');
  const lofiNextBtn = document.getElementById('lofi-next-btn');
  const lofiShuffleBtn = document.getElementById('lofi-shuffle-btn');
  const lofiVolSlider = document.getElementById('lofi-volume-slider') as HTMLInputElement | null;
  const lofiVolLabel = document.getElementById('lofi-volume-label');
  const lofiStationBtns = document.querySelectorAll<HTMLButtonElement>('.lofi-station-btn');

  let ytPlayer: YtPlayerInstance | null = null;
  let ytReady = false;
  let ytPlaying = false;
  let ytShuffled = false;
  let ytVolume = 70;
  let currentStationType: 'playlist' | 'video' = 'playlist';
  let currentPlaylistId = 'PLqIiu63tUd9yTmMIbywqHleGYFx5K0cIc';
  let currentPlaylistTitle = 'Playlist Gus Adi';
  let currentTrackIndex = 0;
  let playlistTracks: TrackMeta[] = [];
  let stalePlaylistSignature = '';
  let syncTimers: ReturnType<typeof setTimeout>[] = [];

  // Preloaded playlists map from SSR/build-time (0ms instant tracklist for all 3 preset playlists!)
  const playlistsCacheMap: Record<string, TrackMeta[]> = {};
  const metaCache = new Map<string, { title: string; artist: string }>();

  try {
    const rawPreloaded = ytTracklistEl?.getAttribute('data-playlists-map');
    if (rawPreloaded) {
      const parsedPreloaded = JSON.parse(rawPreloaded) as Record<string, TrackMeta[]>;
      Object.entries(parsedPreloaded).forEach(([pid, tracks]) => {
        if (Array.isArray(tracks) && tracks.length > 0) {
          playlistsCacheMap[pid] = tracks;
          tracks.forEach((t) => {
            if (t.videoId && t.title) {
              metaCache.set(t.videoId, { title: t.title, artist: t.artist || 'YouTube Music' });
            }
          });
        }
      });
    }
  } catch (_) {}

  // Load any additional cached tracks & metadata from localStorage
  try {
    const rawCache = localStorage.getItem('portfolio-yt-meta-cache-v1');
    if (rawCache) {
      const parsed = JSON.parse(rawCache) as Record<string, { title: string; artist: string }>;
      Object.entries(parsed).forEach(([k, v]) => {
        if (v && v.title) metaCache.set(k, v);
      });
    }
    const rawPlaylistsCache = localStorage.getItem('portfolio-yt-playlists-cache-v3');
    if (rawPlaylistsCache) {
      const parsedPl = JSON.parse(rawPlaylistsCache) as Record<string, TrackMeta[]>;
      Object.entries(parsedPl).forEach(([pid, tracks]) => {
        if (Array.isArray(tracks) && tracks.length > (playlistsCacheMap[pid]?.length || 0)) {
          playlistsCacheMap[pid] = tracks;
        }
      });
    }
  } catch (_) {}

  function saveMetaCache() {
    try {
      const obj: Record<string, { title: string; artist: string }> = {};
      metaCache.forEach((v, k) => {
        obj[k] = v;
      });
      localStorage.setItem('portfolio-yt-meta-cache-v1', JSON.stringify(obj));
      if (playlistTracks.length > 0) {
        playlistsCacheMap[currentPlaylistId] = playlistTracks;
        localStorage.setItem('portfolio-yt-playlists-cache-v3', JSON.stringify(playlistsCacheMap));
      }
    } catch (_) {}
  }

  // Restore saved YT Music volume
  try {
    const savedLofiVol = localStorage.getItem('portfolio-lofi-volume');
    if (savedLofiVol !== null) {
      const parsed = Number(savedLofiVol);
      if (!Number.isNaN(parsed) && parsed >= 0 && parsed <= 100) {
        ytVolume = parsed;
        if (lofiVolSlider) lofiVolSlider.value = String(parsed);
        if (lofiVolLabel) lofiVolLabel.textContent = `${parsed}%`;
      }
    }
  } catch (_) {}

  // Read any SSR-rendered tracks or preloaded map immediately (0ms!)
  function readInitialDomTracks() {
    if (playlistsCacheMap[currentPlaylistId]?.length) {
      playlistTracks = [...playlistsCacheMap[currentPlaylistId]];
      bindTracklistButtons();
      return;
    }
    if (!ytTracklistEl) return;
    const items = ytTracklistEl.querySelectorAll<HTMLButtonElement>('.yt-track-item');
    if (!items.length) return;
    playlistTracks = Array.from(items).map((btn) => {
      const videoId = btn.getAttribute('data-video-id') || '';
      const title = btn.getAttribute('data-track-title') || 'Lagu';
      const artist = btn.getAttribute('data-track-artist') || 'YouTube Music';
      if (videoId) metaCache.set(videoId, { title, artist });
      return { videoId, title, artist };
    });
    playlistsCacheMap[currentPlaylistId] = [...playlistTracks];
    bindTracklistButtons();
  }

  function bindTracklistButtons() {
    if (!ytTracklistEl) return;
    const buttons = ytTracklistEl.querySelectorAll<HTMLButtonElement>('.yt-track-item');
    buttons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = Number(btn.getAttribute('data-track-idx') || '0');
        playTrackAtIndex(idx);
      });
    });
  }

  function renderTracklistUI() {
    if (!ytTracklistEl) return;
    const prevScroll = ytTracklistEl.scrollTop;
    if (!playlistTracks.length) {
      ytTracklistEl.innerHTML =
        '<div class="px-3 py-3 text-center text-[11px] font-semibold text-[var(--text-muted)]">⏳ Memuat daftar judul lagu...</div>';
      return;
    }

    ytTracklistEl.innerHTML = playlistTracks
      .map((t, idx) => {
        const active = idx === currentTrackIndex;
        const rowClass = active
          ? 'bg-[var(--accent-primary)] text-[var(--accent-ink)] font-extrabold shadow-2xs'
          : 'bg-[var(--bg-surface)]/85 hover:bg-[var(--bg-surface)] text-[var(--text-primary)] font-semibold';
        const safeTitle = t.title.replace(/</g, '&lt;').replace(/>/g, '&gt;');
        const safeArtist = t.artist.replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return `
          <button
            type="button"
            data-track-idx="${idx}"
            data-video-id="${t.videoId}"
            class="yt-track-item w-full text-left px-2.5 py-1.5 rounded-xl flex items-center justify-between gap-2 text-xs transition-all cursor-pointer ${rowClass}"
          >
            <div class="flex items-center gap-2 min-w-0">
              <span class="font-mono text-[10px] opacity-75 shrink-0">${String(idx + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <div class="truncate text-[11px] leading-tight">${safeTitle}</div>
                <div class="truncate text-[9px] opacity-75 leading-tight">${safeArtist}</div>
              </div>
            </div>
            <span class="font-mono text-[10px] shrink-0">${active && ytPlaying ? '🔊' : '▶'}</span>
          </button>
        `;
      })
      .join('');

    ytTracklistEl.scrollTop = prevScroll;
    bindTracklistButtons();
  }

  // Full parallel metadata resolution for any uncached video IDs
  async function resolveTrackMetadata(videoIds: string[], targetPid: string) {
    const toFetch = videoIds.filter((id) => !metaCache.has(id));
    if (!toFetch.length) {
      saveMetaCache();
      return;
    }

    let updatedCount = 0;
    await Promise.allSettled(
      toFetch.map(async (vid) => {
        try {
          const res = await fetch(`https://noembed.com/embed?url=https://www.youtube.com/watch?v=${vid}`);
          if (!res.ok) return;
          const data = (await res.json()) as { title?: string; author_name?: string };
          if (data.title) {
            const cleanArtist = (data.author_name || 'YouTube Music').replace(/\s*-\s*Topic$/i, '').trim();
            metaCache.set(vid, { title: data.title, artist: cleanArtist });
            updatedCount++;
            if (currentPlaylistId === targetPid) {
              playlistTracks = videoIds.map((id, idx) => {
                const cached = metaCache.get(id);
                return {
                  videoId: id,
                  title: cached?.title || `Lagu #${idx + 1}`,
                  artist: cached?.artist || 'YouTube Music',
                };
              });
              renderTracklistUI();
              syncNowPlayingDisplay();
            }
          }
        } catch (_) {}
      })
    );

    if (updatedCount > 0) {
      saveMetaCache();
    }
  }

  function syncPlaylistFromPlayer() {
    if (currentStationType === 'video') return;
    if (!ytPlayer || typeof ytPlayer.getPlaylist !== 'function') return;
    const ids = ytPlayer.getPlaylist();
    if (!ids || !ids.length) return;

    const nextIds = ids.join(',');
    // Ignore stale playlist IDs left over from the previous playlist before cuePlaylist finishes
    if (stalePlaylistSignature && nextIds === stalePlaylistSignature) return;

    const currentIds = playlistTracks.map((t) => t.videoId).join(',');
    if (currentIds !== nextIds && (playlistTracks.length === 0 || ids.length >= playlistTracks.length)) {
      playlistTracks = ids.map((vid, idx) => {
        const cached = metaCache.get(vid);
        return {
          videoId: vid,
          title: cached?.title || `Lagu #${idx + 1}`,
          artist: cached?.artist || 'YouTube Music',
        };
      });
      playlistsCacheMap[currentPlaylistId] = [...playlistTracks];
      renderTracklistUI();
      syncNowPlayingDisplay();
      resolveTrackMetadata(ids, currentPlaylistId);
    }
  }

  function schedulePlaylistSync(targetPid: string) {
    syncTimers.forEach((t) => clearTimeout(t));
    syncTimers = [250, 600, 1200, 2200].map((delay) =>
      setTimeout(() => {
        if (currentPlaylistId === targetPid) {
          syncPlaylistFromPlayer();
        }
      }, delay)
    );
  }

  function syncNowPlayingDisplay() {
    if (currentStationType === 'playlist' && ytPlayer && typeof ytPlayer.getPlaylistIndex === 'function') {
      const idx = ytPlayer.getPlaylistIndex();
      if (typeof idx === 'number' && idx >= 0 && idx < playlistTracks.length) {
        currentTrackIndex = idx;
      }
    }

    const total = playlistTracks.length;
    if (ytTrackBadge) {
      ytTrackBadge.textContent = total > 0 ? `${currentTrackIndex + 1} / ${total} Lagu` : 'Siap Diputar';
    }

    let activeTitle = playlistTracks[currentTrackIndex]?.title || 'Pilih Lagu di Daftar Playlist';
    let activeArtist = playlistTracks[currentTrackIndex]?.artist || currentPlaylistTitle;
    let activeVid = playlistTracks[currentTrackIndex]?.videoId || '';

    if (ytPlayer && typeof ytPlayer.getVideoData === 'function') {
      const vData = ytPlayer.getVideoData();
      if (vData && vData.title && vData.video_id) {
        // Only apply player videoData if it belongs to our active tracklist
        const matchIdx = playlistTracks.findIndex((t) => t.videoId === vData.video_id);
        if (matchIdx >= 0) {
          activeTitle = vData.title;
          activeArtist = (vData.author || activeArtist).replace(/\s*-\s*Topic$/i, '').trim();
          activeVid = vData.video_id;
          metaCache.set(vData.video_id, { title: activeTitle, artist: activeArtist });
          playlistTracks[matchIdx].title = activeTitle;
          playlistTracks[matchIdx].artist = activeArtist;
        }
      }
    }

    if (ytNowTitle) {
      ytNowTitle.textContent = activeTitle;
      ytNowTitle.title = activeTitle;
    }
    if (ytNowArtist) {
      ytNowArtist.textContent = activeArtist;
    }
    if (ytCoverArt && activeVid) {
      const nextThumb = `https://i.ytimg.com/vi/${activeVid}/mqdefault.jpg`;
      if (ytCoverArt.src !== nextThumb) {
        ytCoverArt.src = nextThumb;
      }
    }
  }

  function syncYtUI() {
    if (lofiPlayLabel) lofiPlayLabel.textContent = ytPlaying ? 'Pause' : 'Play';
    if (lofiIconPlay && lofiIconPause) {
      if (ytPlaying) {
        lofiIconPlay.classList.add('hidden');
        lofiIconPause.classList.remove('hidden');
      } else {
        lofiIconPlay.classList.remove('hidden');
        lofiIconPause.classList.add('hidden');
      }
    }
    if (ytEqBars) {
      ytEqBars.style.opacity = ytPlaying ? '1' : '0.35';
    }
    if (ytPlaylistNameTag) {
      ytPlaylistNameTag.textContent = currentPlaylistTitle;
    }

    lofiStationBtns.forEach((btn) => {
      const pid = btn.getAttribute('data-playlist-id') || '';
      if (pid === currentPlaylistId) {
        btn.className =
          'lofi-station-btn px-3 py-1 rounded-xl bg-[var(--accent-primary)] text-[var(--accent-ink)] text-[11px] font-extrabold cursor-pointer transition-all shadow-2xs';
      } else {
        btn.className =
          'lofi-station-btn px-3 py-1 rounded-xl bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] text-[11px] font-bold cursor-pointer transition-all';
      }
    });

    syncNowPlayingDisplay();
    renderTracklistUI();
  }

  function playTrackAtIndex(index: number) {
    if (index < 0) return;
    currentTrackIndex = index;
    ytPlaying = true;
    const chosenTrack = playlistTracks[index];

    if (ytPlayer && ytReady) {
      ytPlayer.setVolume(ytVolume);
      if (currentStationType === 'video' && chosenTrack?.videoId) {
        ytPlayer.loadVideoById(chosenTrack.videoId);
      } else {
        const playerIds = ytPlayer.getPlaylist?.() || [];
        const hasCurrentPlaylistLoaded =
          playerIds.length > index &&
          (!chosenTrack?.videoId || playerIds.includes(chosenTrack.videoId));
        if (hasCurrentPlaylistLoaded) {
          ytPlayer.playVideoAt(index);
        } else {
          const knownIds = playlistTracks.map((t) => t.videoId).filter(Boolean);
          if (knownIds.length > 0) {
            ytPlayer.loadPlaylist(knownIds, index);
          } else {
            ytPlayer.loadPlaylist({
              listType: 'playlist',
              list: currentPlaylistId,
              index,
            });
          }
        }
      }
    }
    syncYtUI();
    const chosenTitle = chosenTrack?.title || `Lagu #${index + 1}`;
    window.dispatchEvent(
      new CustomEvent('portfolio:toast', {
        detail: { message: `🎵 Memutar: ${chosenTitle}` },
      })
    );
  }

  function toggleYtPlayback(forceState?: boolean) {
    ytPlaying = typeof forceState === 'boolean' ? forceState : !ytPlaying;
    if (ytPlayer && ytReady) {
      if (ytPlaying) {
        ytPlayer.setVolume(ytVolume);
        if (currentStationType === 'video') {
          const vid = playlistTracks[0]?.videoId || currentPlaylistId;
          const vData = ytPlayer.getVideoData?.();
          if (vData?.video_id === vid) {
            ytPlayer.playVideo();
          } else {
            ytPlayer.loadVideoById(vid);
          }
        } else {
          ytPlayer.playVideo();
        }
      } else {
        ytPlayer.pauseVideo();
      }
    }
    syncYtUI();
  }

  // Equalizer bar animation while audio is playing
  setInterval(() => {
    if (!ytEqBars) return;
    const bars = ytEqBars.querySelectorAll<HTMLElement>('span');
    bars.forEach((bar) => {
      if (!ytPlaying) {
        bar.style.height = '4px';
      } else {
        bar.style.height = `${4 + Math.floor(Math.random() * 8)}px`;
      }
    });
  }, 220);

  // Attach Official YouTube IFrame Player API to existing 200x200 off-screen iframe
  function initYoutubeAudioEngine() {
    const w = window as unknown as {
      YT?: {
        Player: new (
          id: string,
          opts: Record<string, unknown>
        ) => YtPlayerInstance;
      };
      onYouTubeIframeAPIReady?: () => void;
    };

    const createPlayer = () => {
      if (!w.YT || !w.YT.Player) return;
      ytPlayer = new w.YT.Player('yt-hidden-player', {
        events: {
          onReady: () => {
            ytReady = true;
            ytPlayer?.setVolume(ytVolume);
            ytPlayer?.setLoop(true);
            syncPlaylistFromPlayer();
            syncYtUI();
          },
          onStateChange: (event: { data: number }) => {
            // YT.PlayerState: UNSTARTED === -1, ENDED === 0, PLAYING === 1, PAUSED === 2, BUFFERING === 3, CUED === 5
            if (event.data === 1) {
              ytPlaying = true;
              syncPlaylistFromPlayer();
              syncYtUI();
            } else if (event.data === 2 || event.data === 0) {
              ytPlaying = false;
              syncYtUI();
            } else if (event.data === 5 || event.data === -1 || event.data === 3) {
              syncPlaylistFromPlayer();
              syncYtUI();
            }
          },
        },
      });
    };

    if (w.YT && w.YT.Player) {
      createPlayer();
    } else {
      const prevCallback = w.onYouTubeIframeAPIReady;
      w.onYouTubeIframeAPIReady = () => {
        if (typeof prevCallback === 'function') prevCallback();
        createPlayer();
      };
      if (!document.getElementById('yt-iframe-api-script')) {
        const tag = document.createElement('script');
        tag.id = 'yt-iframe-api-script';
        tag.src = 'https://www.youtube.com/iframe_api';
        tag.async = true;
        document.head.appendChild(tag);
      }
    }
  }

  readInitialDomTracks();
  initYoutubeAudioEngine();

  lofiPlayBtn?.addEventListener('click', () => {
    toggleYtPlayback();
  });

  lofiPrevBtn?.addEventListener('click', () => {
    if (ytPlayer && ytReady) {
      if (currentStationType === 'video') {
        playTrackAtIndex(0);
      } else {
        ytPlayer.previousVideo();
        ytPlaying = true;
        syncYtUI();
      }
    }
  });

  lofiNextBtn?.addEventListener('click', () => {
    if (ytPlayer && ytReady) {
      if (currentStationType === 'video') {
        playTrackAtIndex(0);
      } else {
        ytPlayer.nextVideo();
        ytPlaying = true;
        syncYtUI();
      }
    }
  });

  lofiShuffleBtn?.addEventListener('click', () => {
    if (!playlistTracks.length) return;
    ytShuffled = !ytShuffled;
    const randomIdx = Math.floor(Math.random() * playlistTracks.length);
    if (ytPlayer && ytReady && currentStationType === 'playlist') {
      ytPlayer.setShuffle(ytShuffled);
    }
    playTrackAtIndex(randomIdx);
  });

  lofiVolSlider?.addEventListener('input', () => {
    const val = Math.max(0, Math.min(100, Number(lofiVolSlider.value)));
    ytVolume = val;
    if (lofiVolLabel) lofiVolLabel.textContent = `${val}%`;
    if (ytPlayer && ytReady) {
      ytPlayer.setVolume(val);
    }
    try {
      localStorage.setItem('portfolio-lofi-volume', String(val));
    } catch (_) {}
  });

  lofiStationBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const pid = btn.getAttribute('data-playlist-id') || 'PLqIiu63tUd9yTmMIbywqHleGYFx5K0cIc';
      const stype = (btn.getAttribute('data-station-type') as 'playlist' | 'video') || 'playlist';
      if (pid === currentPlaylistId && playlistTracks.length > 0) return;

      const purl =
        btn.getAttribute('data-playlist-url') ||
        (stype === 'video'
          ? `https://music.youtube.com/watch?v=${pid}`
          : `https://music.youtube.com/playlist?list=${pid}`);
      const ptitle = btn.getAttribute('data-playlist-title') || 'Playlist';

      // Remember current player playlist IDs so syncPlaylistFromPlayer ignores stale IDs while cueing
      if (ytPlayer && typeof ytPlayer.getPlaylist === 'function') {
        const prevIds = ytPlayer.getPlaylist();
        if (prevIds && prevIds.length > 0) {
          stalePlaylistSignature = prevIds.join(',');
        }
      }

      currentStationType = stype;
      currentPlaylistId = pid;
      currentPlaylistTitle = ptitle;
      currentTrackIndex = 0;
      ytPlaying = false;

      if (stype === 'video') {
        const vid = btn.getAttribute('data-video-id') || pid;
        if (playlistsCacheMap[pid]?.length) {
          playlistTracks = [...playlistsCacheMap[pid]];
        } else {
          const cached = metaCache.get(vid);
          playlistTracks = [
            {
              videoId: vid,
              title: cached?.title || `${ptitle} — Lofi & Chill Mix`,
              artist: cached?.artist || 'YouTube Music',
            },
          ];
          playlistsCacheMap[pid] = [...playlistTracks];
        }
        resolveTrackMetadata([vid], pid);
      } else {
        // Load pre-fetched tracks for this playlist in 0ms!
        playlistTracks = playlistsCacheMap[pid] ? [...playlistsCacheMap[pid]] : [];
      }

      renderTracklistUI();

      if (ytExternalLink) {
        ytExternalLink.href = purl;
      }
      if (ytPlayer && ytReady) {
        ytPlayer.pauseVideo();
        if (stype === 'video') {
          const vid = btn.getAttribute('data-video-id') || pid;
          ytPlayer.cueVideoById(vid);
        } else {
          const knownIds = playlistTracks.map((t) => t.videoId).filter(Boolean);
          if (knownIds.length > 0) {
            ytPlayer.cuePlaylist(knownIds, 0);
          } else {
            ytPlayer.cuePlaylist({
              listType: 'playlist',
              list: pid,
              index: 0,
            });
          }
          schedulePlaylistSync(pid);
        }
        ytPlayer.setVolume(ytVolume);
      }
      syncYtUI();
      window.dispatchEvent(
        new CustomEvent('portfolio:toast', {
          detail: { message: `📋 Daftar lagu siap: ${ptitle} (Klik lagu / Play untuk memutar)` },
        })
      );
    });
  });

  syncYtUI();

  // 6. Studio Theme Accent Buttons, Background Ambience Worlds & Canvas FX
  const bgSceneBtns = document.querySelectorAll<HTMLButtonElement>('.hero-bg-scene-btn');

  function syncBgSceneButtons(activeScene: string) {
    bgSceneBtns.forEach((btn) => {
      const s = btn.getAttribute('data-bg-scene') || 'studio';
      if (s === activeScene) {
        btn.className =
          'hero-bg-scene-btn px-3 py-1 rounded-full bg-[var(--accent-primary)] text-[var(--accent-ink)] text-xs font-extrabold cursor-pointer transition-all hover:scale-105 shadow-2xs';
      } else {
        btn.className =
          'hero-bg-scene-btn px-3 py-1 rounded-full bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] border border-transparent text-xs font-bold cursor-pointer transition-all hover:scale-105';
      }
    });
  }

  syncBgSceneButtons(document.documentElement.getAttribute('data-bg-scene') || 'studio');

  bgSceneBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const scene = btn.getAttribute('data-bg-scene') || 'studio';
      const label = btn.getAttribute('data-bg-label') || scene;
      syncBgSceneButtons(scene);
      window.dispatchEvent(new CustomEvent('portfolio:set-bg-scene', { detail: { scene, label } }));
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.hero-accent-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const accent = btn.getAttribute('data-hero-accent') || 'emerald';
      const label = btn.getAttribute('data-hero-accent-label') || accent;
      window.dispatchEvent(new CustomEvent('portfolio:set-accent', { detail: { accent, label } }));
    });
  });

  document.getElementById('hero-fx-serpent')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:toggle-serpent'));
  });
  document.getElementById('hero-fx-matrix')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:toggle-matrix'));
  });
  document.getElementById('hero-fx-barrel')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:barrel-roll'));
  });

  // 6. Pocket CLI Shell
  const shellOutput = document.getElementById('hero-shell-output');
  const shellForm = document.getElementById('hero-shell-form') as HTMLFormElement | null;
  const shellInput = document.getElementById('hero-shell-input') as HTMLInputElement | null;

  function execShellCommand(rawCmd: string) {
    const cmd = rawCmd.trim().toLowerCase();
    if (!cmd || !shellOutput) return;

    if (cmd === 'clear') {
      shellOutput.innerHTML = '<div class="text-[var(--text-muted)]">// cleared</div>';
      return;
    }

    const promptLine = document.createElement('div');
    promptLine.className = 'text-[var(--accent-primary)] font-bold';
    promptLine.textContent = `$ ${cmd}`;
    shellOutput.appendChild(promptLine);

    const resLine = document.createElement('div');
    resLine.className = 'text-[var(--text-secondary)] animate-boot-line pl-1.5';

    if (cmd === 'help') {
      resLine.textContent = 'whoami, lofi, stack, projects, ular, party, clear';
    } else if (cmd === 'lofi' || cmd === 'music') {
      toggleYtPlayback();
      resLine.textContent = ytPlaying
        ? `🎧 Memutar ${currentPlaylistTitle}`
        : '⏸ Playlist YT Music dijeda.';
    } else if (cmd === 'game' || cmd === 'arcade' || cmd === 'ular') {
      window.dispatchEvent(new CustomEvent('portfolio:open-arcade', { detail: { tab: 'snake' } }));
      resLine.textContent = 'Membuka Arcade...';
    } else if (cmd === 'whoami') {
      resLine.textContent = 'Gus Adi — Software Developer (Bali, Indonesia)';
    } else if (cmd === 'stack') {
      resLine.textContent = 'TS, JS, Python, Astro, Tailwind, Node, SQL';
    } else if (cmd === 'projects') {
      resLine.textContent = '01: Plagiarism Checker | 02: SakuKu Web App';
    } else if (cmd === 'party') {
      window.dispatchEvent(new CustomEvent('portfolio:fireworks'));
      resLine.textContent = '🎉 Konfeti diluncurkan!';
    } else {
      resLine.textContent = `Perintah "${cmd}" tidak dikenal.`;
    }

    shellOutput.appendChild(resLine);
    shellOutput.scrollTop = shellOutput.scrollHeight;
  }

  shellForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!shellInput) return;
    execShellCommand(shellInput.value);
    shellInput.value = '';
  });

  document.querySelectorAll<HTMLButtonElement>('.shell-preset-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.getAttribute('data-shell-cmd');
      if (cmd) execShellCommand(cmd);
    });
  });
</script>
