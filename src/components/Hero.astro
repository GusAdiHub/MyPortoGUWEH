    mp3Url: 'https://www.myinstants.com/media/sounds/emotional-damage-meme.mp3',
    tint: TINT_STYLES[1],
  },
  {
    id: 'animewow',
    emoji: '✨',
    shortTitle: 'Anime Wow',
    fullTitle: '✨ Anime Wow Sound Effect',
    mp3Url: 'https://www.myinstants.com/media/sounds/anime-wow-sound-effect.mp3',
    tint: TINT_STYLES[2],
  },
  {
    id: 'bruh',
    emoji: '😐',
    shortTitle: 'Bruh',
    fullTitle: '😐 Bruh Sound Effect',
    mp3Url: 'https://www.myinstants.com/media/sounds/movie_1.mp3',
    tint: TINT_STYLES[3],
  },
  {
