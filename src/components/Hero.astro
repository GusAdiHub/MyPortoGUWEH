    mp3Url: 'https://www.myinstants.com/media/sounds/spongebob-fail.mp3',
    tint: TINT_STYLES[4],
  },
  {
    id: 'winxp',
    emoji: '💻',
    shortTitle: 'XP Error',
    fullTitle: '💻 Windows XP Error',
    mp3Url: 'https://www.myinstants.com/media/sounds/erro.mp3',
    tint: TINT_STYLES[0],
  },
  {
    id: 'fbi',
    emoji: '🚨',
    shortTitle: 'FBI Open Up',
    fullTitle: '🚨 FBI Open Up!',
    mp3Url: 'https://www.myinstants.com/media/sounds/fbi-open-up-sfx.mp3',
    tint: TINT_STYLES[1],
  },
  {
