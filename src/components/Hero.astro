            class="lofi-station-btn px-2.5 py-1 rounded-xl bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] text-[10px] font-bold cursor-pointer transition-all"
          >
            🌙 Night Drive
          </button>
          <button
            type="button"
            data-lofi-idx="3"
            class="lofi-station-btn px-2.5 py-1 rounded-xl bg-[var(--bg-elevated)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] text-[10px] font-bold cursor-pointer transition-all"
          >
