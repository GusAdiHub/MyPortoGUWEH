---
interface Props {
  index: string;
  title: {
    id: string;
    en: string;
  };
  path:
    | string
    | {
        id: string;
        en: string;
      };
}

const { index, title, path } = Astro.props;
---

<div class="reveal-on-scroll w-full mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
  <div class="flex items-center gap-3.5">
    <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-[var(--accent-primary)] text-[var(--accent-ink)] font-display font-extrabold text-base shadow-sm select-none shrink-0">
      {index}
    </span>
    <div>
      <div class="font-mono text-[11px] font-bold uppercase tracking-widest text-[var(--accent-primary)]">
        {typeof path === 'string' ? (
          <span>{path}</span>
        ) : (
          <span>
            <span data-lang="id">{path.id}</span>
            <span data-lang="en">{path.en}</span>
          </span>
        )}
      </div>
      <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
        <span data-lang="id">{title.id}</span>
        <span data-lang="en">{title.en}</span>
      </h2>
    </div>
  </div>

  <div class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-xs font-semibold text-[var(--text-secondary)]">
    <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)]"></span>
    <span>Interactive Studio Module</span>
  </div>
</div>
