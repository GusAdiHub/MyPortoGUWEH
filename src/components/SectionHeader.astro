---
interface Props {
  index: string;
  title: {
    id: string;
    en: string;
  };
  path: string;
}

const { index, title, path } = Astro.props;
---

<div class="reveal-on-scroll w-full mb-8 sm:mb-10 flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-[var(--border-subtle)] select-none">
  <div class="flex items-center gap-3.5">
    <span class="inline-flex items-center justify-center w-10 h-10 rounded-xl bg-[var(--bg-elevated)] border border-[var(--border-focus)] font-mono text-sm font-bold text-[var(--accent-primary)] shadow-[0_0_20px_var(--accent-glow)]">
      {index}
    </span>
    <div>
      <div class="font-mono text-[11px] uppercase tracking-widest text-[var(--accent-secondary)] mb-0.5">
        {path}
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
        <span data-lang="id">{title.id}</span>
        <span data-lang="en">{title.en}</span>
      </h2>
    </div>
  </div>

  <div class="hidden sm:flex items-center gap-2 font-mono text-xs text-[var(--text-muted)]">
    <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)] animate-pulse"></span>
    <span>SECTION_{index} // ACTIVE</span>
  </div>
</div>
