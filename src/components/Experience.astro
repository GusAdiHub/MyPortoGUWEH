---
import SectionHeader from './SectionHeader.astro';
import { experiences } from '../data/profile';
import { translations } from '../data/i18n';
---

<section id="experience" class="w-full py-16 sm:py-24 border-b border-[var(--border-subtle)]">
  <div class="w-full max-w-5xl mx-auto px-5 sm:px-8">
    <SectionHeader
      index="04"
      title={{ id: translations.id.experience.header, en: translations.en.experience.header }}
      path={{ id: translations.id.experience.filePath, en: translations.en.experience.filePath }}
    />

    <div class="space-y-4 reveal-on-scroll">
      {experiences.map((exp) => (
        <div class="soft-panel hover-lift spotlight-surface p-6 sm:p-7 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
          <div class="md:col-span-4 space-y-2 font-sans">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--bg-elevated)] text-xs font-bold text-[var(--accent-primary)]">
              <span class="w-2 h-2 rounded-full bg-[var(--status-ok)] status-pulse-dot"></span>
              <span>{exp.period}</span>
            </div>
            <div class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider pl-1">
              {exp.type}
            </div>
          </div>

          <div class="md:col-span-8 space-y-2 font-sans">
            <h3 class="font-display text-xl sm:text-2xl font-bold text-[var(--text-primary)] leading-snug">
              <span data-lang="id">{exp.role.id}</span>
              <span data-lang="en">{exp.role.en}</span>
            </h3>
            <div class="text-sm font-semibold text-[var(--accent-primary)]">
              {exp.institution}
            </div>
            <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed pt-1">
              <span data-lang="id">{exp.description.id}</span>
              <span data-lang="en">{exp.description.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
