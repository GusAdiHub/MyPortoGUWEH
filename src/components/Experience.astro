---
import SectionHeader from './SectionHeader.astro';
import { experiences } from '../data/profile';
import { translations } from '../data/i18n';
---

<section id="experience" class="w-full py-16 sm:py-24 border-b border-[var(--border-subtle)]">
  <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-14">
    <SectionHeader
      index="04"
      title={{ id: 'PENDIDIKAN & RIWAYAT', en: 'EXPERIENCE & EDUCATION' }}
      path={translations.id.experience.filePath}
    />

    <!-- Timeline List with Animated Laser Spine -->
    <div class="space-y-6 relative ml-4 sm:ml-6 pl-6 sm:pl-8 border-l-2 border-[var(--border-subtle)]">
      <!-- Animated Glowing Laser Pulse Traveling Down Timeline -->
      <div class="absolute left-[-2px] top-0 bottom-0 w-[2px] overflow-hidden pointer-events-none" aria-hidden="true">
        <div class="animate-timeline-drop absolute left-0 w-full h-24 bg-gradient-to-b from-transparent via-[var(--accent-primary)] to-[var(--accent-secondary)] shadow-[0_0_12px_var(--accent-primary)]"></div>
      </div>

      {experiences.map((exp, idx) => (
        <div class="reveal-on-scroll relative group" style={`--stagger: ${idx + 1};`}>
          <!-- Glowing Timeline Node with Pulse Ring -->
          <div class="absolute -left-[33px] sm:-left-[41px] top-6 w-4 h-4 rounded-full bg-[var(--bg-base)] border-2 border-[var(--accent-primary)] flex items-center justify-center group-hover:scale-125 transition-transform shadow-[0_0_15px_var(--accent-primary)]">
            <span class="animate-pulse-ring absolute inline-flex h-full w-full rounded-full bg-[var(--accent-primary)] opacity-60"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--accent-primary)] relative z-10"></span>
          </div>

          <div data-tilt class="bento-card p-6 sm:p-8">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3 pb-3 border-b border-[var(--border-subtle)] font-mono text-xs">
              <div class="flex items-center gap-2.5">
                <span class="px-2.5 py-1 rounded-lg bg-[var(--bg-elevated)] border border-[var(--border-subtle)] text-[var(--accent-primary)] font-bold">
                  {exp.period}
                </span>
                <span class="text-[var(--text-muted)]">//</span>
                <span class="text-[var(--accent-secondary)]">{exp.institution}</span>
              </div>
              <span class="text-[var(--status-ok)] text-[11px] rounded-full border border-[var(--border-subtle)] px-3 py-1 bg-[var(--bg-elevated)] font-medium">
                {exp.type}
              </span>
            </div>

            <h3 class="font-display text-xl sm:text-2xl font-bold text-[var(--text-primary)] mb-2">
              <span data-lang="id">{exp.role.id}</span>
              <span data-lang="en">{exp.role.en}</span>
            </h3>

            <p class="font-sans text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
              <span data-lang="id">{exp.description.id}</span>
              <span data-lang="en">{exp.description.en}</span>
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
