---
import { projects } from '../data/profile';
import { translations } from '../data/i18n';
import { FlaskConical, Layers, Play, Sparkles, X, Wallet, Plus, RotateCcw, Disc3 } from 'lucide-astro';

const featuredProject = projects.find((p) => p.featured) || projects[0];
const secondProject = projects.find((p) => !p.featured) || projects[1];
---

<section id="projects" class="w-full py-8 sm:py-12">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-8">
    <!-- Non-Template Master-Detail Interactive App Cartridge Stage -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <!-- LEFT 4 COLS: Interactive Cartridge Selector Dock + Live Pipeline Telemetry -->
      <div class="lg:col-span-4 flex flex-col justify-between gap-5 reveal-on-scroll" style="--stagger: 0;">
        <div class="tactile-card p-5 sm:p-6 space-y-5 font-sans">
          <div class="flex items-center justify-between">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[var(--tint-mint)] text-teal-950 font-mono text-xs font-extrabold">
              <Disc3 class="w-3.5 h-3.5 text-teal-700 animate-spin" style="animation-duration: 9s;" />
              <span>APP CARTRIDGE DECK</span>
            </span>
            <span class="font-mono text-xs font-bold text-[var(--text-muted)]">2 APPS</span>
          </div>

          <div class="space-y-1.5">
            <h2 class="font-display text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text-primary)]">
              <span data-lang="id">{translations.id.projects.header}</span>
              <span data-lang="en">{translations.en.projects.header}</span>
            </h2>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
              <span data-lang="id">Pilih salah satu katrid proyek di bawah untuk memuat studi kasus &amp; simulator interaktifnya di panggung utama.</span>
              <span data-lang="en">Select a project cartridge below to load its case study &amp; interactive simulator onto the main stage.</span>
            </p>
          </div>

          <!-- Cartridge Buttons -->
          <div class="space-y-3" role="tablist" aria-label="Select project cartridge">
            {featuredProject && (
              <button
                type="button"
                data-cartridge="0"
                class="cartridge-btn w-full text-left p-4 rounded-2xl border-2 border-[var(--accent-primary)] bg-[var(--tint-mint)] transition-all cursor-pointer space-y-1.5 shadow-sm"
              >
                <div class="flex items-center justify-between text-[11px] font-mono font-extrabold text-teal-900">
                  <span>CARTRIDGE #01 · NLP</span>
                  <span class="px-2 py-0.5 rounded-full bg-white text-teal-900">{featuredProject.status}</span>
                </div>
                <div class="font-display text-lg font-extrabold text-teal-950 leading-snug">
                  {featuredProject.title}
                </div>
                <div class="text-xs text-teal-800 font-medium">
                  Python · TF-IDF Cosine · Live Lab
                </div>
              </button>
            )}

            {secondProject && (
              <button
                type="button"
                data-cartridge="1"
                class="cartridge-btn w-full text-left p-4 rounded-2xl border-2 border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:border-[var(--accent-primary)] transition-all cursor-pointer space-y-1.5"
              >
                <div class="flex items-center justify-between text-[11px] font-mono font-extrabold text-[var(--text-muted)]">
                  <span>CARTRIDGE #02 · WEB APP</span>
                  <span class="px-2 py-0.5 rounded-full bg-[var(--bg-elevated)] text-[var(--text-secondary)]">{secondProject.status}</span>
                </div>
                <div class="font-display text-lg font-extrabold text-[var(--text-primary)] leading-snug">
                  {secondProject.title}
                </div>
                <div class="text-xs text-[var(--text-secondary)] font-medium">
                  JavaScript · SQL · Cashflow Simulator
                </div>
              </button>
            )}
          </div>
        </div>

        <!-- Compact NLP Pipeline Telemetry Box -->
        <div class="tactile-card p-5 space-y-3 font-sans" id="pipeline-simulator">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold uppercase tracking-wider text-[var(--text-primary)]">
              <span data-lang="id">⚙️ Engine Telemetry</span>
              <span data-lang="en">⚙️ Engine Telemetry</span>
            </span>
            <button
              type="button"
              id="run-pipeline-btn"
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-[var(--accent-primary)] text-white font-bold text-[11px] cursor-pointer"
            >
              <Play class="w-3 h-3" />
              <span>Test Run</span>
            </button>
          </div>

          <div class="space-y-1.5 text-xs">
            <div data-pipe-step="0" class="pipe-step px-3 py-2 rounded-xl bg-[var(--bg-elevated)]/60 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="pipe-dot w-2 h-2 rounded-full bg-[var(--status-ok)]"></span>
                <span class="font-semibold text-[var(--text-primary)]">1. Tokenization</span>
              </div>
              <span class="pipe-badge font-mono text-[10px] text-[var(--status-ok)] font-bold">READY</span>
            </div>
            <div data-pipe-step="1" class="pipe-step px-3 py-2 rounded-xl bg-[var(--bg-elevated)]/60 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="pipe-dot w-2 h-2 rounded-full bg-[var(--status-ok)]"></span>
                <span class="font-semibold text-[var(--text-primary)]">2. Stopword Filter</span>
              </div>
              <span class="pipe-badge font-mono text-[10px] text-[var(--status-ok)] font-bold">READY</span>
            </div>
            <div data-pipe-step="2" class="pipe-step px-3 py-2 rounded-xl bg-[var(--bg-elevated)]/60 flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="pipe-dot w-2 h-2 rounded-full bg-[var(--status-ok)]"></span>
                <span class="font-semibold text-[var(--text-primary)]">3. Vector Scoring</span>
              </div>
              <span class="pipe-badge font-mono text-[10px] text-[var(--status-ok)] font-bold">READY</span>
            </div>
          </div>
          <span id="pipe-vector-status" class="hidden">ready</span>
        </div>
      </div>

      <!-- RIGHT 8 COLS: Active Cartridge Live Interactive Stage -->
      <div class="lg:col-span-8 reveal-on-scroll" style="--stagger: 1;">
        <!-- STAGE 0: Plagiarism Checker + Live NLP Lab -->
        {featuredProject && (
          <article id="cartridge-stage-0" class="tactile-card spotlight-surface h-full flex flex-col justify-between overflow-hidden">
            <div class="bg-[var(--tint-mint)] border-b-2 border-[var(--border-subtle)] px-6 py-4 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2 font-sans text-xs">
                <span class="px-2.5 py-1 rounded-xl bg-teal-800 text-white font-display font-extrabold">STAGE #01</span>
                <span class="font-extrabold text-teal-950">{featuredProject.category}</span>
              </div>

              <div class="inline-flex items-center gap-1 font-sans text-xs bg-white/90 p-1 rounded-full border border-teal-600/20">
                <button
                  type="button"
                  data-proj-view="overview"
                  class="proj-view-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[var(--accent-primary)] text-[var(--accent-ink)] font-bold cursor-pointer transition-all"
                >
                  <Layers class="w-3.5 h-3.5" />
                  <span data-lang="id">Studi Kasus</span>
                  <span data-lang="en">Case Study</span>
                </button>
                <button
                  type="button"
                  data-proj-view="sandbox"
                  class="proj-view-btn inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-semibold cursor-pointer transition-all"
                >
                  <FlaskConical class="w-3.5 h-3.5" />
                  <span data-lang="id">🔬 Live NLP Lab</span>
                  <span data-lang="en">🔬 Live NLP Lab</span>
                </button>
              </div>
            </div>

            <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
              <!-- Overview Mode -->
              <div id="proj-panel-overview" class="space-y-6 font-sans">
                <div class="space-y-2.5">
                  <h3 class="font-display text-2xl sm:text-4xl font-extrabold tracking-tight text-[var(--text-primary)]">
                    {featuredProject.title}
                  </h3>
                  <p class="text-base leading-relaxed text-[var(--text-secondary)]">
                    <span data-lang="id">{featuredProject.summary.id}</span>
                    <span data-lang="en">{featuredProject.summary.en}</span>
                  </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  {featuredProject.problem && (
                    <div class="p-4 rounded-2xl bg-[var(--tint-amber)] border border-amber-500/20 space-y-1.5">
                      <div class="text-xs font-extrabold uppercase tracking-wider text-amber-900">
                        <span data-lang="id">{translations.id.projects.problem}</span>
                        <span data-lang="en">{translations.en.projects.problem}</span>
                      </div>
                      <p class="text-sm text-amber-950/85 leading-relaxed">
                        <span data-lang="id">{featuredProject.problem.id}</span>
                        <span data-lang="en">{featuredProject.problem.en}</span>
                      </p>
                    </div>
                  )}

                  {featuredProject.solution && (
                    <div class="p-4 rounded-2xl bg-[var(--tint-mint)] border border-teal-500/20 space-y-1.5">
                      <div class="text-xs font-extrabold uppercase tracking-wider text-teal-900">
                        <span data-lang="id">{translations.id.projects.solution}</span>
                        <span data-lang="en">{translations.en.projects.solution}</span>
                      </div>
                      <p class="text-sm text-teal-950/85 leading-relaxed">
                        <span data-lang="id">{featuredProject.solution.id}</span>
                        <span data-lang="en">{featuredProject.solution.en}</span>
                      </p>
                    </div>
                  )}
                </div>

                <div class="flex flex-wrap items-center gap-2 text-xs font-bold text-[var(--text-primary)]">
                  {featuredProject.techStack.map((t) => (
                    <span class="px-3.5 py-1.5 rounded-full bg-[var(--bg-elevated)] border border-[var(--border-subtle)]">{t}</span>
                  ))}
                </div>

                <div class="pt-2 flex flex-wrap items-center gap-3 text-xs sm:text-sm">
                  <button
                    type="button"
                    id="jump-to-sandbox-btn"
                    class="pill-btn inline-flex items-center gap-2 bg-[var(--accent-primary)] text-[var(--accent-ink)] font-bold px-5 py-2.5 cursor-pointer"
                  >
                    <Sparkles class="w-4 h-4" />
                    <span data-lang="id">Coba Simulator Kemiripan Dokumen</span>
                    <span data-lang="en">Try Document Similarity Simulator</span>
                  </button>

                  <button
                    type="button"
                    class="project-detail-btn pill-btn border-2 border-[var(--border-subtle)] hover:border-[var(--accent-primary)] text-[var(--text-primary)] font-bold px-4 py-2.5 cursor-pointer"
                    data-project-slug={featuredProject.slug}
                  >
                    <span data-lang="id">{translations.id.projects.details}</span>
                    <span data-lang="en">{translations.en.projects.details}</span>
                  </button>
                </div>
              </div>

              <!-- Live NLP Lab Mode -->
              <div id="proj-panel-sandbox" class="hidden space-y-5 font-sans">
                <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-[var(--border-subtle)]">
                  <div>
                    <h4 class="text-lg font-extrabold text-[var(--text-primary)]">
                      <span data-lang="id">{translations.id.projects.sandboxTitle}</span>
                      <span data-lang="en">{translations.en.projects.sandboxTitle}</span>
                    </h4>
                    <p class="text-xs text-[var(--text-secondary)]">
                      <span data-lang="id">{translations.id.projects.sandboxSub}</span>
                      <span data-lang="en">{translations.en.projects.sandboxSub}</span>
                    </p>
                  </div>

                  <div class="flex items-center gap-2 text-xs">
                    <button type="button" id="nlp-preset-1" class="pill-btn bg-[var(--tint-mint)] text-teal-900 font-bold px-3 py-1 cursor-pointer">
                      Preset 1
                    </button>
                    <button type="button" id="nlp-preset-2" class="pill-btn bg-[var(--tint-sky)] text-blue-900 font-bold px-3 py-1 cursor-pointer">
                      Preset 2
                    </button>
                  </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label for="nlp-doc-a" class="text-xs font-bold text-[var(--text-secondary)] flex justify-between">
                      <span>Dokumen A</span>
                      <span id="nlp-count-a" class="font-mono text-[var(--accent-primary)]">0 tokens</span>
                    </label>
                    <textarea
                      id="nlp-doc-a"
                      rows="4"
                      class="w-full rounded-2xl border-2 border-[var(--border-subtle)] focus:border-[var(--accent-primary)] bg-[var(--bg-elevated)]/40 p-3 font-sans text-sm text-[var(--text-primary)] leading-relaxed focus:outline-none resize-none"
                    >Sistem deteksi kemiripan dokumen memproses teks melalui tahap tokenisasi, penghapusan stopword, dan pembobotan vektor TF-IDF untuk mengukur skor kemiripan secara terstruktur.</textarea>
                  </div>

                  <div class="space-y-1.5">
                    <label for="nlp-doc-b" class="text-xs font-bold text-[var(--text-secondary)] flex justify-between">
                      <span>Dokumen B</span>
                      <span id="nlp-count-b" class="font-mono text-[var(--accent-secondary)]">0 tokens</span>
                    </label>
                    <textarea
                      id="nlp-doc-b"
                      rows="4"
                      class="w-full rounded-2xl border-2 border-[var(--border-subtle)] focus:border-[var(--accent-primary)] bg-[var(--bg-elevated)]/40 p-3 font-sans text-sm text-[var(--text-primary)] leading-relaxed focus:outline-none resize-none"
                    >Metode pemrosesan teks menggunakan tokenisasi dan representasi vektor dokumen untuk menghitung tingkat kemiripan antar teks akademik dengan cepat.</textarea>
                  </div>
                </div>

                <div class="p-4 rounded-2xl bg-[var(--tint-mint)] border border-teal-500/20 flex flex-wrap items-center justify-between gap-4">
                  <div class="flex items-center gap-4">
                    <div class="relative w-14 h-14 flex items-center justify-center shrink-0">
                      <svg class="w-14 h-14 -rotate-90" viewBox="0 0 64 64">
                        <circle cx="32" cy="32" r="26" fill="none" stroke="rgba(13,148,136,0.18)" stroke-width="6"></circle>
                        <circle
                          id="nlp-gauge-circle"
                          cx="32"
                          cy="32"
                          r="26"
                          fill="none"
                          stroke="var(--accent-primary)"
                          stroke-width="6"
                          stroke-linecap="round"
                          stroke-dasharray="163.36"
                          stroke-dashoffset="163.36"
                        ></circle>
                      </svg>
                      <span id="nlp-match-badge" class="absolute font-mono text-[10px] font-bold text-teal-950">--</span>
                    </div>
                    <div>
                      <div class="text-xs font-bold text-teal-800 uppercase">Cosine Similarity</div>
                      <div id="nlp-cosine-score" class="font-display text-3xl font-extrabold text-teal-950">0%</div>
                      <div class="text-xs text-teal-800">Jaccard: <strong id="nlp-jaccard-score">0%</strong></div>
                    </div>
                  </div>

                  <div class="flex-1 min-w-[180px] space-y-1">
                    <div class="text-xs font-bold text-teal-800">Shared Vocabulary Tokens:</div>
                    <div id="nlp-shared-tokens" class="flex flex-wrap gap-1.5"></div>
                  </div>
                </div>
              </div>
            </div>
          </article>
        )}

        <!-- STAGE 1: SakuKu Web App + Interactive Cashflow Simulator -->
        {secondProject && (
          <article id="cartridge-stage-1" class="hidden tactile-card spotlight-surface h-full flex flex-col justify-between overflow-hidden">
            <div class="bg-[var(--tint-sky)] border-b-2 border-[var(--border-subtle)] px-6 py-4 flex flex-wrap items-center justify-between gap-3">
              <div class="flex items-center gap-2 font-sans text-xs">
                <span class="px-2.5 py-1 rounded-xl bg-blue-800 text-white font-display font-extrabold">STAGE #02</span>
                <span class="font-extrabold text-blue-950">{secondProject.category}</span>
              </div>

              <button
                type="button"
                class="project-detail-btn pill-btn bg-white text-blue-950 border border-blue-600/20 font-sans text-xs font-bold px-3.5 py-1.5 cursor-pointer"
                data-project-slug={secondProject.slug}
              >
                <span data-lang="id">{translations.id.projects.details}</span>
                <span data-lang="en">{translations.en.projects.details}</span>
              </button>
            </div>

            <div class="p-6 sm:p-8 space-y-6 font-sans">
              <div class="space-y-2">
                <h3 class="font-display text-2xl sm:text-4xl font-extrabold text-[var(--text-primary)]">
                  {secondProject.title}
                </h3>
                <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
                  <span data-lang="id">{secondProject.summary.id}</span>
                  <span data-lang="en">{secondProject.summary.en}</span>
                </p>
              </div>

              <!-- Interactive SakuKu Cashflow Simulator right inside Stage #02 -->
              <div class="p-5 rounded-2xl bg-[var(--bg-elevated)]/60 border-2 border-[var(--border-subtle)] space-y-4">
                <div class="flex items-center justify-between pb-2.5 border-b border-[var(--border-subtle)]">
                  <div class="inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-[var(--text-primary)]">
                    <Wallet class="w-4 h-4 text-[var(--accent-secondary)]" />
                    <span data-lang="id">Simulasi Interaktif UI SakuKu (Demo Lokal)</span>
                    <span data-lang="en">SakuKu Interactive UI Simulator (Local Demo)</span>
                  </div>
                  <button
                    type="button"
                    id="sakuku-reset-btn"
                    class="inline-flex items-center gap-1 text-xs text-[var(--text-muted)] hover:text-[var(--text-primary)] cursor-pointer font-bold"
                  >
                    <RotateCcw class="w-3.5 h-3.5" />
                    <span>Reset</span>
                  </button>
                </div>

                <div class="grid grid-cols-3 gap-2.5">
                  <div class="p-3 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                    <div class="text-[10px] font-bold uppercase text-[var(--text-muted)]">Pemasukan</div>
                    <div id="sakuku-inc-val" class="font-display text-sm sm:text-base font-extrabold text-emerald-600 mt-0.5">Rp 2.500.000</div>
                  </div>
                  <div class="p-3 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
                    <div class="text-[10px] font-bold uppercase text-[var(--text-muted)]">Pengeluaran</div>
                    <div id="sakuku-exp-val" class="font-display text-sm sm:text-base font-extrabold text-rose-600 mt-0.5">Rp 650.000</div>
                  </div>
                  <div class="p-3 rounded-xl bg-[var(--tint-sky)] border border-blue-500/20">
                    <div class="text-[10px] font-bold uppercase text-blue-800">Saldo Bersih</div>
                    <div id="sakuku-net-val" class="font-display text-sm sm:text-base font-extrabold text-blue-950 mt-0.5">Rp 1.850.000</div>
                  </div>
                </div>

                <div class="space-y-1">
                  <div class="flex justify-between text-[11px] font-semibold text-[var(--text-secondary)]">
                    <span>Rasio Kas Simulasi</span>
                    <span id="sakuku-ratio-label" class="font-mono text-[var(--accent-primary)]">74% Tersimpan</span>
                  </div>
                  <div class="w-full h-2.5 rounded-full bg-rose-200 overflow-hidden flex">
                    <div id="sakuku-ratio-bar" class="h-full bg-emerald-500 transition-all duration-300" style="width: 74%;"></div>
                  </div>
                </div>

                <div class="flex flex-wrap items-center gap-2">
                  <button
                    type="button"
                    data-saku-title="Freelance Web"
                    data-saku-amount="500000"
                    data-saku-type="in"
                    class="sakuku-add-btn inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-[var(--tint-mint)] text-teal-900 text-xs font-bold hover:scale-105 transition-transform cursor-pointer"
                  >
                    <Plus class="w-3 h-3" />
                    <span>+ Rp 500rb (Freelance)</span>
                  </button>
                  <button
                    type="button"
                    data-saku-title="Buku & Kursus"
                    data-saku-amount="150000"
                    data-saku-type="out"
                    class="sakuku-add-btn inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-[var(--tint-rose)] text-rose-900 text-xs font-bold hover:scale-105 transition-transform cursor-pointer"
                  >
                    <span>- Rp 150rb (Buku)</span>
                  </button>
                  <button
                    type="button"
                    data-saku-title="Kopi & Makan"
                    data-saku-amount="45000"
                    data-saku-type="out"
                    class="sakuku-add-btn inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-[var(--tint-amber)] text-amber-900 text-xs font-bold hover:scale-105 transition-transform cursor-pointer"
                  >
                    <span>- Rp 45rb (Kopi)</span>
                  </button>
                </div>

                <div id="sakuku-log-list" class="space-y-1.5 max-h-[100px] overflow-y-auto pr-1 text-xs"></div>
              </div>
            </div>
          </article>
        )}
      </div>
    </div>
  </div>

  <!-- Project Detail Modal -->
  <div
    id="project-modal"
    class="modal-backdrop fixed inset-0 z-50 hidden bg-black/50 p-4 flex items-center justify-center select-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-project-title"
  >
    <div class="modal-panel w-full max-w-xl rounded-3xl border-2 border-[var(--border-subtle)] bg-[var(--bg-surface)] shadow-2xl overflow-hidden font-sans">
      <div class="border-b border-[var(--border-subtle)] px-6 py-4 flex items-center justify-between bg-[var(--tint-mint)]">
        <span id="modal-project-header-slug" class="font-mono text-xs text-teal-900 font-bold">
          project
        </span>
        <button
          type="button"
          id="modal-close-btn"
          class="inline-flex items-center gap-1 rounded-full bg-white text-teal-950 px-3 py-1 text-xs font-bold cursor-pointer"
          aria-label="Close dialog"
        >
          <X class="w-3.5 h-3.5" />
          <span data-lang="id">{translations.id.projects.closeModal}</span>
          <span data-lang="en">{translations.en.projects.closeModal}</span>
        </button>
      </div>

      <div class="p-6 sm:p-8 space-y-5 text-sm">
        <div>
          <p id="modal-project-category" class="text-xs text-[var(--accent-primary)] font-bold mb-1">
            Category
          </p>
          <h3 id="modal-project-title" class="text-2xl font-extrabold tracking-tight text-[var(--text-primary)]">
            Project Title
          </h3>
        </div>

        <div id="modal-project-summary" class="text-[var(--text-secondary)] leading-relaxed"></div>

        <div class="space-y-4 border-t border-[var(--border-subtle)] pt-4 text-sm">
          <div class="border-l-2 border-[var(--border-strong)] pl-4">
            <div class="text-xs font-bold text-[var(--text-primary)] mb-1">
              <span data-lang="id">{translations.id.projects.problem}</span>
              <span data-lang="en">{translations.en.projects.problem}</span>
            </div>
            <div id="modal-project-problem" class="text-[var(--text-secondary)] leading-relaxed"></div>
          </div>
          <div class="border-l-2 border-[var(--accent-primary)] pl-4">
            <div class="text-xs font-bold text-[var(--accent-primary)] mb-1">
              <span data-lang="id">{translations.id.projects.solution}</span>
              <span data-lang="en">{translations.en.projects.solution}</span>
            </div>
            <div id="modal-project-solution" class="text-[var(--text-secondary)] leading-relaxed"></div>
          </div>
          <div class="text-xs">
            <strong class="font-bold text-[var(--text-primary)]">
              <span data-lang="id">{translations.id.projects.role}:</span>
              <span data-lang="en">{translations.en.projects.role}:</span>
            </strong>{' '}
            <span id="modal-project-role" class="text-[var(--text-secondary)]"></span>
          </div>
        </div>

        <div class="pt-4 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-3 text-xs">
          <div id="modal-project-stack" class="flex flex-wrap gap-2"></div>
          <div id="modal-project-link"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ projectsData: projects }}>
  // 0. Cartridge Switcher (Stage #01 vs Stage #02)
  const cartridgeBtns = document.querySelectorAll('.cartridge-btn');
  const stage0 = document.getElementById('cartridge-stage-0');
  const stage1 = document.getElementById('cartridge-stage-1');

  cartridgeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-cartridge');
      cartridgeBtns.forEach((b) => {
        if (b === btn) {
          b.classList.add('border-[var(--accent-primary)]', 'bg-[var(--tint-mint)]', 'shadow-sm');
          b.classList.remove('border-[var(--border-subtle)]', 'bg-[var(--bg-surface)]');
        } else {
          b.classList.remove('border-[var(--accent-primary)]', 'bg-[var(--tint-mint)]', 'shadow-sm');
          b.classList.add('border-[var(--border-subtle)]', 'bg-[var(--bg-surface)]');
        }
      });

      if (idx === '1') {
        stage0?.classList.add('hidden');
        stage1?.classList.remove('hidden');
      } else {
        stage1?.classList.add('hidden');
        stage0?.classList.remove('hidden');
      }
    });
  });

  // 1. Plagiarism Checker Case Study vs Live NLP Lab Switcher
  const viewBtns = document.querySelectorAll('.proj-view-btn');
  const overviewPanel = document.getElementById('proj-panel-overview');
  const sandboxPanel = document.getElementById('proj-panel-sandbox');

  function setProjectView(view) {
    viewBtns.forEach((b) => {
      const active = b.getAttribute('data-proj-view') === view;
      if (active) {
        b.classList.add('bg-[var(--accent-primary)]', 'text-[var(--accent-ink)]', 'font-bold');
        b.classList.remove('text-[var(--text-secondary)]', 'font-semibold');
      } else {
        b.classList.remove('bg-[var(--accent-primary)]', 'text-[var(--accent-ink)]', 'font-bold');
        b.classList.add('text-[var(--text-secondary)]', 'font-semibold');
      }
    });
    if (view === 'sandbox') {
      overviewPanel?.classList.add('hidden');
      sandboxPanel?.classList.remove('hidden');
    } else {
      sandboxPanel?.classList.add('hidden');
      overviewPanel?.classList.remove('hidden');
    }
  }

  viewBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      setProjectView(btn.getAttribute('data-proj-view') || 'overview');
    });
  });

  document.getElementById('jump-to-sandbox-btn')?.addEventListener('click', () => {
    setProjectView('sandbox');
  });

  // 2. Step-by-Step Pipeline Animation
  const runPipelineBtn = document.getElementById('run-pipeline-btn');
  const pipeSteps = document.querySelectorAll('.pipe-step');
  let isSimulating = false;

  function runPipelineSimulation() {
    if (isSimulating || !pipeSteps.length) return;
    isSimulating = true;

    pipeSteps.forEach((step) => {
      const dot = step.querySelector('.pipe-dot');
      const badge = step.querySelector('.pipe-badge');
      if (dot) dot.className = 'pipe-dot w-2 h-2 rounded-full bg-[var(--text-muted)]';
      if (badge) {
        badge.textContent = 'RUN...';
        badge.className = 'pipe-badge text-[10px] text-[var(--text-muted)] font-mono';
      }
    });

    pipeSteps.forEach((step, idx) => {
      setTimeout(() => {
        const dot = step.querySelector('.pipe-dot');
        const badge = step.querySelector('.pipe-badge');
        if (dot) dot.className = 'pipe-dot w-2 h-2 rounded-full bg-[var(--status-ok)]';
        if (badge) {
          badge.textContent = 'DONE';
          badge.className = 'pipe-badge text-[10px] text-[var(--status-ok)] font-mono font-bold';
        }
        if (idx === pipeSteps.length - 1) isSimulating = false;
      }, (idx + 1) * 260);
    });
  }

  runPipelineBtn?.addEventListener('click', runPipelineSimulation);

  // 3. Live NLP Similarity Engine
  const docAInput = document.getElementById('nlp-doc-a');
  const docBInput = document.getElementById('nlp-doc-b');
  const countAEl = document.getElementById('nlp-count-a');
  const countBEl = document.getElementById('nlp-count-b');
  const cosineScoreEl = document.getElementById('nlp-cosine-score');
  const jaccardScoreEl = document.getElementById('nlp-jaccard-score');
  const gaugeCircle = document.getElementById('nlp-gauge-circle');
  const matchBadgeEl = document.getElementById('nlp-match-badge');
  const sharedTokensEl = document.getElementById('nlp-shared-tokens');

  const STOPWORDS = new Set([
    'yang', 'dan', 'di', 'ke', 'dari', 'untuk', 'pada', 'dengan', 'ini', 'itu', 'atau', 'dalam', 'secara', 'antar',
    'the', 'and', 'to', 'of', 'in', 'for', 'with', 'on', 'is', 'are', 'by', 'as', 'an', 'a', 'through',
  ]);

  function tokenizeText(raw) {
    return String(raw || '')
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, ' ')
      .split(/\s+/)
      .filter((w) => w.length > 2 && !STOPWORDS.has(w));
  }

  function computeSimilarityLive() {
    if (!docAInput || !docBInput) return;
    const tokensA = tokenizeText(docAInput.value);
    const tokensB = tokenizeText(docBInput.value);

    if (countAEl) countAEl.textContent = `${tokensA.length} tokens`;
    if (countBEl) countBEl.textContent = `${tokensB.length} tokens`;

    const freqA = {};
    const freqB = {};
    const vocab = new Set();

    tokensA.forEach((t) => {
      freqA[t] = (freqA[t] || 0) + 1;
      vocab.add(t);
    });
    tokensB.forEach((t) => {
      freqB[t] = (freqB[t] || 0) + 1;
      vocab.add(t);
    });

    let dot = 0;
    let magA = 0;
    let magB = 0;
    const shared = [];

    vocab.forEach((term) => {
      const a = freqA[term] || 0;
      const b = freqB[term] || 0;
      dot += a * b;
      magA += a * a;
      magB += b * b;
      if (a > 0 && b > 0) shared.push(term);
    });

    const cosine = magA > 0 && magB > 0 ? dot / (Math.sqrt(magA) * Math.sqrt(magB)) : 0;
    const setA = new Set(tokensA);
    const setB = new Set(tokensB);
    const unionSize = new Set([...setA, ...setB]).size;
    const jaccard = unionSize > 0 ? shared.length / unionSize : 0;

    const cosinePct = Math.round(cosine * 100);
    const jaccardPct = Math.round(jaccard * 100);

    if (cosineScoreEl) cosineScoreEl.textContent = `${cosinePct}%`;
    if (jaccardScoreEl) jaccardScoreEl.textContent = `${jaccardPct}%`;
    if (matchBadgeEl) matchBadgeEl.textContent = cosinePct >= 60 ? 'HIGH' : cosinePct >= 30 ? 'MED' : 'LOW';

    if (gaugeCircle) {
      const circumference = 163.36;
      const offset = circumference - (cosinePct / 100) * circumference;
      gaugeCircle.style.strokeDashoffset = String(offset);
    }

    if (sharedTokensEl) {
      sharedTokensEl.innerHTML = '';
      if (shared.length === 0) {
        const empty = document.createElement('span');
        empty.className = 'text-xs text-teal-800/70';
        empty.textContent = '0 shared tokens';
        sharedTokensEl.appendChild(empty);
      } else {
        shared.forEach((word) => {
          const badge = document.createElement('span');
          badge.className =
            'px-2.5 py-0.5 rounded-full bg-white text-xs text-teal-900 font-bold border border-teal-600/20';
          badge.textContent = word;
          sharedTokensEl.appendChild(badge);
        });
      }
    }
  }

  docAInput?.addEventListener('input', computeSimilarityLive);
  docBInput?.addEventListener('input', computeSimilarityLive);

  document.getElementById('nlp-preset-1')?.addEventListener('click', () => {
    if (docAInput && docBInput) {
      docAInput.value = 'Sistem deteksi kemiripan dokumen memproses teks melalui tahap tokenisasi, penghapusan stopword, dan pembobotan vektor TF-IDF untuk mengukur skor kemiripan.';
      docBInput.value = 'Metode pemrosesan teks menggunakan tokenisasi dan vektor TF-IDF dokumen untuk menghitung skor kemiripan antar dokumen akademik.';
      computeSimilarityLive();
    }
  });

  document.getElementById('nlp-preset-2')?.addEventListener('click', () => {
    if (docAInput && docBInput) {
      docAInput.value = 'Arsitektur backend bersih memisahkan routing REST API, logika layanan bisnis, dan kueri basis data relasional PostgreSQL menggunakan TypeScript.';
      docBInput.value = 'Layanan backend modern menggunakan TypeScript, handler REST API modular, dan repositori basis data PostgreSQL terstruktur.';
      computeSimilarityLive();
    }
  });

  computeSimilarityLive();

  // 4. Interactive SakuKu Cashflow Mini-Simulator
  const incEl = document.getElementById('sakuku-inc-val');
  const expEl = document.getElementById('sakuku-exp-val');
  const netEl = document.getElementById('sakuku-net-val');
  const ratioBar = document.getElementById('sakuku-ratio-bar');
  const ratioLabel = document.getElementById('sakuku-ratio-label');
  const logList = document.getElementById('sakuku-log-list');

  const defaultSakuItems = [
    { title: 'Saldo Awal Bulan', amount: 2500000, type: 'in' },
    { title: 'Kebutuhan Kampus & Internet', amount: 650000, type: 'out' },
  ];
  let sakuItems = [...defaultSakuItems];

  function formatRupiah(n) {
    return 'Rp ' + Number(n).toLocaleString('id-ID');
  }

  function renderSakuSimulator() {
    let inc = 0;
    let exp = 0;
    sakuItems.forEach((item) => {
      if (item.type === 'in') inc += item.amount;
      else exp += item.amount;
    });
    const net = inc - exp;
    const savedPct = inc > 0 ? Math.max(0, Math.min(100, Math.round((net / inc) * 100))) : 0;

    if (incEl) incEl.textContent = formatRupiah(inc);
    if (expEl) expEl.textContent = formatRupiah(exp);
    if (netEl) netEl.textContent = formatRupiah(net);
    if (ratioBar) ratioBar.style.width = `${savedPct}%`;
    if (ratioLabel) ratioLabel.textContent = `${savedPct}% Tersimpan`;

    if (logList) {
      logList.innerHTML = '';
      sakuItems
        .slice()
        .reverse()
        .forEach((item) => {
          const row = document.createElement('div');
          row.className =
            'flex items-center justify-between px-3 py-1.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)]';
          const left = document.createElement('span');
          left.className = 'font-medium text-[var(--text-primary)]';
          left.textContent = item.title;
          const right = document.createElement('span');
          right.className =
            item.type === 'in' ? 'font-mono font-bold text-emerald-600' : 'font-mono font-bold text-rose-600';
          right.textContent = `${item.type === 'in' ? '+' : '-'} ${formatRupiah(item.amount)}`;
          row.appendChild(left);
          row.appendChild(right);
          logList.appendChild(row);
        });
    }
  }

  document.querySelectorAll('.sakuku-add-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const title = btn.getAttribute('data-saku-title') || 'Transaksi';
      const amount = parseInt(btn.getAttribute('data-saku-amount') || '0', 10);
      const type = btn.getAttribute('data-saku-type') || 'out';
      if (amount > 0) {
        sakuItems.push({ title, amount, type });
        renderSakuSimulator();
      }
    });
  });

  document.getElementById('sakuku-reset-btn')?.addEventListener('click', () => {
    sakuItems = [...defaultSakuItems];
    renderSakuSimulator();
  });

  renderSakuSimulator();

  // 5. Project Detail Modal
  const modal = document.getElementById('project-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const titleEl = document.getElementById('modal-project-title');
  const catEl = document.getElementById('modal-project-category');
  const summaryEl = document.getElementById('modal-project-summary');
  const problemEl = document.getElementById('modal-project-problem');
  const solutionEl = document.getElementById('modal-project-solution');
  const roleEl = document.getElementById('modal-project-role');
  const stackEl = document.getElementById('modal-project-stack');
  const linkEl = document.getElementById('modal-project-link');
  const headerSlugEl = document.getElementById('modal-project-header-slug');

  let lastActiveElement = null;

  function openModal(slug) {
    const proj = projectsData.find((p) => p.slug === slug);
    if (!proj) return;

    lastActiveElement = document.activeElement;

    const setBilingualText = (el, obj) => {
      if (!el) return;
      el.innerHTML = '';
      const spanId = document.createElement('span');
      spanId.setAttribute('data-lang', 'id');
      spanId.textContent = obj?.id || '-';
      const spanEn = document.createElement('span');
      spanEn.setAttribute('data-lang', 'en');
      spanEn.textContent = obj?.en || obj?.id || '-';
      el.appendChild(spanId);
      el.appendChild(spanEn);
    };

    if (headerSlugEl) headerSlugEl.textContent = proj.slug;
    if (titleEl) titleEl.textContent = proj.title;
    if (catEl) catEl.textContent = proj.category;
    setBilingualText(summaryEl, proj.summary);
    setBilingualText(problemEl, proj.problem);
    setBilingualText(solutionEl, proj.solution);
    setBilingualText(roleEl, proj.role);

    if (stackEl) {
      stackEl.innerHTML = '';
      proj.techStack.forEach((t) => {
        const chip = document.createElement('span');
        chip.className = 'px-2.5 py-1 rounded-full bg-[var(--bg-elevated)] text-[var(--text-primary)] font-bold text-xs';
        chip.textContent = t;
        stackEl.appendChild(chip);
      });
    }

    if (linkEl) {
      if (proj.repoUrl) {
        linkEl.innerHTML = `<a href="${proj.repoUrl}" target="_blank" rel="noopener noreferrer" class="text-[var(--accent-primary)] font-bold hover:underline">Repository ↗</a>`;
      } else {
        linkEl.innerHTML = `<span class="text-[var(--text-muted)]">Private / In Progress</span>`;
      }
    }

    modal?.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal?.classList.add('is-open');
    });
    closeBtn?.focus();
  }

  function closeModal() {
    modal?.classList.remove('is-open');
    setTimeout(() => {
      modal?.classList.add('hidden');
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }, 200);
  }

  document.querySelectorAll('.project-detail-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-project-slug');
      if (slug) openModal(slug);
    });
  });

  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>
