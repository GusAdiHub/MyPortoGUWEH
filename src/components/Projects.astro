---
import SectionHeader from './SectionHeader.astro';
import { projects } from '../data/profile';
import { translations } from '../data/i18n';

const featuredProject = projects.find((p) => p.featured) || projects[0];
const supportingProjects = projects.filter((p) => !p.featured);
---

<section id="projects" class="w-full py-16 sm:py-24 border-b border-[var(--border-subtle)]">
  <div class="w-full max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-14 space-y-10">
    <SectionHeader
      index="03"
      title={{ id: 'PROYEK PILIHAN', en: 'FEATURED PROJECTS' }}
      path={translations.id.projects.filePath}
    />

    <!-- 1. Featured Project Widescreen Bento Showcase -->
    {featuredProject && (
      <div
        class="reveal-on-scroll bento-card border border-[var(--border-focus)] shadow-2xl overflow-hidden"
        style="--stagger: 0;"
      >
        <!-- Top Status Bar -->
        <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-6 py-3.5 font-mono text-xs flex flex-wrap items-center justify-between gap-2 select-none">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-primary)] animate-pulse"></span>
            <span class="text-[var(--accent-primary)] font-bold uppercase tracking-wider">
              ✦ {translations.id.projects.featuredBadge} // {featuredProject.slug}
            </span>
          </div>
          <span class="px-3 py-1 rounded-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-[var(--status-warn)] text-[11px] font-medium">
            status: {featuredProject.status}
          </span>
        </div>

        <!-- Main Split Body -->
        <div class="p-6 sm:p-8 lg:p-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
          <!-- Left: Interactive Pipeline Simulator (5 cols) -->
          <div class="lg:col-span-5 flex flex-col">
            {featuredProject.image ? (
              <div class="aspect-[16/10] w-full rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-base)] overflow-hidden">
                <img
                  src={featuredProject.image}
                  alt={featuredProject.title}
                  loading="lazy"
                  class="w-full h-full object-cover brightness-95 hover:brightness-105 hover:scale-105 transition-all duration-500"
                />
              </div>
            ) : (
              <div
                id="pipeline-simulator"
                class="w-full flex-1 min-h-[280px] rounded-2xl border border-[var(--border-subtle)] bg-[var(--bg-base)] p-5 font-mono text-xs flex flex-col justify-between select-none relative overflow-hidden"
              >
                <!-- Header -->
                <div class="flex items-center justify-between text-[11px] text-[var(--text-muted)] border-b border-[var(--border-subtle)] pb-3">
                  <span class="text-[var(--accent-secondary)] font-semibold">{featuredProject.slug}.engine</span>
                  <button
                    type="button"
                    id="run-pipeline-btn"
                    class="rounded-lg border border-[var(--border-focus)] bg-[var(--bg-elevated)] hover:bg-[var(--accent-primary)] hover:text-[#05070b] text-[var(--accent-primary)] font-bold px-3 py-1 cursor-pointer transition-all text-[11px]"
                  >
                    <span data-lang="id">{translations.id.projects.runPipeline}</span>
                    <span data-lang="en">{translations.en.projects.runPipeline}</span>
                  </button>
                </div>

                <!-- Pipeline Stages -->
                <div class="space-y-3 my-auto py-4">
                  <div class="text-[var(--text-secondary)] text-[11px] truncate">
                    <span class="text-[var(--accent-primary)]">$</span> analyze_docs --source doc_a.txt --target doc_b.txt
                  </div>

                  <!-- Stage 1 -->
                  <div
                    data-pipe-step="0"
                    class="pipe-step rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-3 flex items-center justify-between transition-all duration-300"
                  >
                    <div class="flex items-center gap-2.5">
                      <span class="pipe-dot w-2.5 h-2.5 rounded-full bg-[var(--text-muted)]"></span>
                      <span class="text-[var(--text-primary)] font-medium">01. Tokenize &amp; Normalize</span>
                    </div>
                    <span class="pipe-badge text-[10px] px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)]">IDLE</span>
                  </div>

                  <!-- Stage 2 -->
                  <div
                    data-pipe-step="1"
                    class="pipe-step rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-3 flex items-center justify-between transition-all duration-300"
                  >
                    <div class="flex items-center gap-2.5">
                      <span class="pipe-dot w-2.5 h-2.5 rounded-full bg-[var(--text-muted)]"></span>
                      <span class="text-[var(--text-primary)] font-medium">02. Stopword &amp; Stemming</span>
                    </div>
                    <span class="pipe-badge text-[10px] px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)]">IDLE</span>
                  </div>

                  <!-- Stage 3 -->
                  <div
                    data-pipe-step="2"
                    class="pipe-step rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] p-3 flex items-center justify-between transition-all duration-300"
                  >
                    <div class="flex items-center gap-2.5">
                      <span class="pipe-dot w-2.5 h-2.5 rounded-full bg-[var(--text-muted)]"></span>
                      <span class="text-[var(--text-primary)] font-medium">03. Similarity Scoring Matrix</span>
                    </div>
                    <span class="pipe-badge text-[10px] px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)]">IDLE</span>
                  </div>

                  <!-- Animated Token Stream & Vector Bar -->
                  <div class="rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]/70 p-2.5 space-y-2">
                    <div class="flex items-center justify-between text-[10px] text-[var(--text-muted)]">
                      <span>token.stream</span>
                      <span id="pipe-vector-status" class="text-[var(--accent-secondary)]">vec[0..n]</span>
                    </div>
                    <div id="pipe-token-chips" class="flex flex-wrap gap-1.5 text-[10px]">
                      <span class="pipe-token px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-secondary)] transition-all">"algoritma"</span>
                      <span class="pipe-token px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-secondary)] transition-all">"kemiripan"</span>
                      <span class="pipe-token px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-secondary)] transition-all">"dokumen"</span>
                      <span class="pipe-token px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-secondary)] transition-all">"teks"</span>
                    </div>
                  </div>
                </div>

                <!-- Footer Status -->
                <div class="text-[11px] text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-3 flex items-center justify-between">
                  <span class="text-[var(--status-ok)] font-medium">
                    <span data-lang="id">{translations.id.projects.pipelineReady}</span>
                    <span data-lang="en">{translations.en.projects.pipelineReady}</span>
                  </span>
                  <span class="text-[var(--accent-primary)]">NLP // PIPELINE</span>
                </div>
              </div>
            )}
          </div>

          <!-- Right: Project Details, Problem/Solution Cards & Actions (7 cols) -->
          <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div>
                <div class="font-mono text-xs text-[var(--accent-secondary)] mb-1">
                  // {featuredProject.category}
                </div>
                <h3 class="font-display text-2xl sm:text-3xl font-bold text-[var(--text-primary)]">
                  {featuredProject.title}
                </h3>
              </div>

              <p class="text-sm sm:text-base leading-relaxed text-[var(--text-secondary)]">
                <span data-lang="id">{featuredProject.summary.id}</span>
                <span data-lang="en">{featuredProject.summary.en}</span>
              </p>

              <!-- Structured Problem / Solution / Role Grid -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2 text-xs sm:text-sm">
                {featuredProject.problem && (
                  <div class="rounded-xl bg-[var(--bg-elevated)]/80 border border-[var(--border-subtle)] p-4 space-y-1.5">
                    <div class="font-mono text-xs font-bold text-[var(--accent-secondary)]">
                      <span data-lang="id">{translations.id.projects.problem}</span>
                      <span data-lang="en">{translations.en.projects.problem}</span>
                    </div>
                    <p class="text-[var(--text-secondary)] leading-relaxed text-xs">
                      <span data-lang="id">{featuredProject.problem.id}</span>
                      <span data-lang="en">{featuredProject.problem.en}</span>
                    </p>
                  </div>
                )}

                {featuredProject.solution && (
                  <div class="rounded-xl bg-[var(--bg-elevated)]/80 border border-[var(--border-subtle)] p-4 space-y-1.5">
                    <div class="font-mono text-xs font-bold text-[var(--accent-primary)]">
                      <span data-lang="id">{translations.id.projects.solution}</span>
                      <span data-lang="en">{translations.en.projects.solution}</span>
                    </div>
                    <p class="text-[var(--text-secondary)] leading-relaxed text-xs">
                      <span data-lang="id">{featuredProject.solution.id}</span>
                      <span data-lang="en">{featuredProject.solution.en}</span>
                    </p>
                  </div>
                )}
              </div>

              {featuredProject.role && (
                <div class="rounded-xl bg-[var(--bg-base)]/60 border border-[var(--border-subtle)] px-4 py-2.5 text-xs">
                  <span class="font-mono font-bold text-[var(--text-primary)]">
                    <span data-lang="id">{translations.id.projects.role}</span>
                    <span data-lang="en">{translations.en.projects.role}</span>
                  </span>{' '}
                  <span class="text-[var(--text-secondary)]">
                    <span data-lang="id">{featuredProject.role.id}</span>
                    <span data-lang="en">{featuredProject.role.en}</span>
                  </span>
                </div>
              )}

              <!-- Tech Stack Pills -->
              <div class="flex flex-wrap gap-2 font-mono text-xs pt-1">
                {featuredProject.techStack.map((t) => (
                  <span class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-3 py-1 text-[var(--accent-primary)] font-medium">
                    {t}
                  </span>
                ))}
              </div>
            </div>

            <!-- Action Row -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-[var(--border-subtle)] font-mono text-xs">
              <div class="flex flex-wrap items-center gap-2.5">
                {featuredProject.repoUrl ? (
                  <a
                    href={featuredProject.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="kinetic-btn bg-[var(--accent-primary)] text-[#05070b] font-bold px-4 py-2"
                  >
                    <span data-lang="id">{translations.id.projects.repo}</span>
                    <span data-lang="en">{translations.en.projects.repo}</span>
                  </a>
                ) : (
                  <span class="rounded-lg border border-[var(--border-subtle)] border-dashed text-[var(--text-muted)] px-3 py-2 text-[11px] select-none">
                    <span data-lang="id">{translations.id.projects.repoPrivate}</span>
                    <span data-lang="en">{translations.en.projects.repoPrivate}</span>
                  </span>
                )}

                {featuredProject.demoUrl ? (
                  <a
                    href={featuredProject.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="kinetic-btn border border-[var(--border-subtle)] bg-[var(--bg-elevated)] text-[var(--text-primary)] px-4 py-2"
                  >
                    <span data-lang="id">{translations.id.projects.demo}</span>
                    <span data-lang="en">{translations.en.projects.demo}</span>
                  </a>
                ) : (
                  <span class="rounded-lg border border-[var(--border-subtle)] border-dashed text-[var(--text-muted)] px-3 py-2 text-[11px] select-none">
                    <span data-lang="id">{translations.id.projects.demoUnavailable}</span>
                    <span data-lang="en">{translations.en.projects.demoUnavailable}</span>
                  </span>
                )}
              </div>

              <button
                type="button"
                class="project-detail-btn kinetic-btn border border-[var(--border-focus)] bg-[var(--bg-elevated)] hover:bg-[var(--accent-primary)] hover:text-[#05070b] text-[var(--accent-primary)] font-bold px-4 py-2 cursor-pointer"
                data-project-slug={featuredProject.slug}
                aria-label={`View details for ${featuredProject.title}`}
              >
                <span data-lang="id">{translations.id.projects.details}</span>
                <span data-lang="en">{translations.en.projects.details}</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Interactive Live NLP Document Similarity Sandbox -->
        <div class="border-t border-[var(--border-subtle)] bg-[var(--bg-base)]/60 p-6 sm:p-8 lg:px-10 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <div class="flex items-center gap-2 font-mono text-xs text-[var(--accent-primary)] font-bold">
                <span class="w-2 h-2 rounded-full bg-[var(--status-ok)] animate-pulse"></span>
                <span data-lang="id">{translations.id.projects.sandboxTitle}</span>
                <span data-lang="en">{translations.en.projects.sandboxTitle}</span>
              </div>
              <p class="text-xs text-[var(--text-secondary)] mt-0.5">
                <span data-lang="id">{translations.id.projects.sandboxSub}</span>
                <span data-lang="en">{translations.en.projects.sandboxSub}</span>
              </p>
            </div>

            <div class="flex flex-wrap items-center gap-2 font-mono text-[11px]">
              <button
                type="button"
                id="nlp-preset-1"
                class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] hover:border-[var(--accent-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] px-3 py-1.5 cursor-pointer transition-all"
              >
                <span data-lang="id">{translations.id.projects.presetAcademic}</span>
                <span data-lang="en">{translations.en.projects.presetAcademic}</span>
              </button>
              <button
                type="button"
                id="nlp-preset-2"
                class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] hover:border-[var(--accent-secondary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] px-3 py-1.5 cursor-pointer transition-all"
              >
                <span data-lang="id">{translations.id.projects.presetTech}</span>
                <span data-lang="en">{translations.en.projects.presetTech}</span>
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
            <!-- Doc A Input -->
            <div class="lg:col-span-4 flex flex-col gap-1.5">
              <label for="nlp-doc-a" class="font-mono text-xs text-[var(--text-secondary)] flex justify-between">
                <span>
                  <span data-lang="id">{translations.id.projects.docALabel}</span>
                  <span data-lang="en">{translations.en.projects.docALabel}</span>
                </span>
                <span id="nlp-count-a" class="text-[var(--text-muted)]">0 tokens</span>
              </label>
              <textarea
                id="nlp-doc-a"
                rows="4"
                class="w-full flex-1 rounded-xl border border-[var(--border-subtle)] focus:border-[var(--accent-primary)] bg-[var(--bg-surface)] p-3.5 font-mono text-xs text-[var(--text-primary)] leading-relaxed focus:outline-none transition-colors resize-none"
              >Sistem deteksi kemiripan dokumen memproses teks melalui tahap tokenisasi, penghapusan stopword, dan pembobotan vektor TF-IDF untuk mengukur skor kemiripan secara terstruktur.</textarea>
            </div>

            <!-- Doc B Input -->
            <div class="lg:col-span-4 flex flex-col gap-1.5">
              <label for="nlp-doc-b" class="font-mono text-xs text-[var(--text-secondary)] flex justify-between">
                <span>
                  <span data-lang="id">{translations.id.projects.docBLabel}</span>
                  <span data-lang="en">{translations.en.projects.docBLabel}</span>
                </span>
                <span id="nlp-count-b" class="text-[var(--text-muted)]">0 tokens</span>
              </label>
              <textarea
                id="nlp-doc-b"
                rows="4"
                class="w-full flex-1 rounded-xl border border-[var(--border-subtle)] focus:border-[var(--accent-secondary)] bg-[var(--bg-surface)] p-3.5 font-mono text-xs text-[var(--text-primary)] leading-relaxed focus:outline-none transition-colors resize-none"
              >Metode pemrosesan teks menggunakan tokenisasi dan representasi vektor dokumen untuk menghitung tingkat kemiripan antar teks akademik dengan cepat.</textarea>
            </div>

            <!-- Live Similarity Telemetry Result -->
            <div class="lg:col-span-4 rounded-xl border border-[var(--border-focus)] bg-[var(--bg-surface)] p-4 flex flex-col justify-between gap-3 font-mono text-xs">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <div class="text-[11px] text-[var(--text-muted)]">Cosine Similarity</div>
                  <div id="nlp-cosine-score" class="font-display text-3xl font-bold text-[var(--accent-primary)]">
                    0%
                  </div>
                  <div class="text-[11px] text-[var(--text-secondary)] mt-0.5">
                    Jaccard Index: <strong id="nlp-jaccard-score" class="text-[var(--accent-secondary)]">0%</strong>
                  </div>
                </div>

                <!-- Animated SVG Circular Gauge -->
                <div class="relative w-16 h-16 flex items-center justify-center shrink-0">
                  <svg class="w-16 h-16 -rotate-90" viewBox="0 0 64 64">
                    <circle cx="32" cy="32" r="26" fill="none" stroke="var(--bg-elevated)" stroke-width="6"></circle>
                    <circle
                      id="nlp-gauge-circle"
                      cx="32"
                      cy="32"
                      r="26"
                      fill="none"
                      stroke="var(--accent-primary)"
                      stroke-width="6"
                      stroke-linecap="round"
                      stroke-dasharray="163.36"
                      stroke-dashoffset="163.36"
                      style="transition: stroke-dashoffset 500ms cubic-bezier(0.16, 1, 0.3, 1);"
                    ></circle>
                  </svg>
                  <span id="nlp-match-badge" class="absolute text-[10px] font-bold text-[var(--text-primary)]">--</span>
                </div>
              </div>

              <!-- Shared Tokens Chips -->
              <div class="space-y-1.5 border-t border-[var(--border-subtle)] pt-2.5">
                <div class="text-[10px] text-[var(--text-muted)]">
                  <span data-lang="id">{translations.id.projects.sharedTokens}</span>
                  <span data-lang="en">{translations.en.projects.sharedTokens}</span>
                </div>
                <div id="nlp-shared-tokens" class="flex flex-wrap gap-1.5 max-h-[54px] overflow-y-auto"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- 2. Supporting Projects Widescreen Grid -->
    {supportingProjects.length > 0 && (
      <div class="space-y-4">
        <div class="font-mono text-xs text-[var(--text-muted)] uppercase tracking-wider select-none flex items-center gap-2">
          <span class="text-[var(--accent-secondary)]">✦</span>
          <span>Supporting Systems &amp; Applications</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {supportingProjects.map((project, idx) => (
            <div
              data-tilt
              class="reveal-on-scroll bento-card p-6 sm:p-7 flex flex-col justify-between"
              style={`--stagger: ${idx + 1};`}
            >
              <div class="space-y-4">
                <div class="flex items-start justify-between border-b border-[var(--border-subtle)] pb-3">
                  <div>
                    <p class="font-mono text-xs text-[var(--accent-secondary)] mb-1">
                      // {project.category}
                    </p>
                    <h3 class="font-display text-xl font-bold text-[var(--text-primary)]">
                      {project.title}
                    </h3>
                  </div>
                  <span class="font-mono text-[11px] text-[var(--status-warn)] rounded-full border border-[var(--border-subtle)] px-3 py-1 bg-[var(--bg-elevated)]">
                    {project.status}
                  </span>
                </div>

                <p class="text-sm leading-relaxed text-[var(--text-secondary)]">
                  <span data-lang="id">{project.summary.id}</span>
                  <span data-lang="en">{project.summary.en}</span>
                </p>

                <!-- Stack -->
                <div class="flex flex-wrap gap-2 font-mono text-xs pt-1">
                  {project.techStack.map((stk) => (
                    <span class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-2.5 py-1 text-[var(--text-primary)]">
                      {stk}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Action links row -->
              <div class="flex items-center justify-between pt-5 mt-5 border-t border-[var(--border-subtle)] font-mono text-xs">
                <div class="flex items-center gap-2">
                  {project.repoUrl ? (
                    <a
                      href={project.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--accent-primary)] hover:underline"
                    >
                      <span data-lang="id">{translations.id.projects.repo}</span>
                      <span data-lang="en">{translations.en.projects.repo}</span>
                    </a>
                  ) : (
                    <span class="text-[var(--text-muted)] text-[11px]">
                      <span data-lang="id">{translations.id.projects.repoPrivate}</span>
                      <span data-lang="en">{translations.en.projects.repoPrivate}</span>
                    </span>
                  )}
                </div>

                <button
                  type="button"
                  class="project-detail-btn kinetic-btn border border-[var(--border-subtle)] bg-[var(--bg-elevated)] hover:border-[var(--accent-primary)] text-[var(--text-primary)] px-3.5 py-1.5 cursor-pointer"
                  data-project-slug={project.slug}
                  aria-label={`View details for ${project.title}`}
                >
                  <span data-lang="id">{translations.id.projects.details}</span>
                  <span data-lang="en">{translations.en.projects.details}</span>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Project Detail Modal -->
  <div
    id="project-modal"
    class="modal-backdrop fixed inset-0 z-50 hidden bg-black/75 p-4 flex items-center justify-center select-none"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-project-title"
  >
    <div class="modal-panel w-full max-w-xl rounded-2xl border border-[var(--border-focus)] bg-[var(--bg-surface)] shadow-2xl overflow-hidden">
      <div class="border-b border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-5 py-3.5 font-mono text-xs flex items-center justify-between">
        <span id="modal-project-header-slug" class="text-[var(--accent-primary)] font-bold">
          [ details // buffer ]
        </span>
        <button
          type="button"
          id="modal-close-btn"
          class="rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:border-[var(--accent-primary)] px-2.5 py-1 cursor-pointer transition-all"
          aria-label="Close dialog"
        >
          <span data-lang="id">{translations.id.projects.closeModal}</span>
          <span data-lang="en">{translations.en.projects.closeModal}</span>
        </button>
      </div>

      <div class="p-6 sm:p-7 space-y-4 font-sans text-sm">
        <div>
          <p id="modal-project-category" class="font-mono text-xs text-[var(--accent-secondary)] mb-1">
            Category
          </p>
          <h3 id="modal-project-title" class="font-display text-2xl font-bold text-[var(--text-primary)]">
            Project Title
          </h3>
        </div>

        <div id="modal-project-summary" class="text-[var(--text-secondary)] leading-relaxed"></div>

        <div class="space-y-3 border-t border-[var(--border-subtle)] pt-4 text-xs">
          <div class="rounded-xl bg-[var(--bg-elevated)] p-3.5">
            <span class="font-mono font-bold text-[var(--accent-secondary)]">
              <span data-lang="id">{translations.id.projects.problem}</span>
              <span data-lang="en">{translations.en.projects.problem}</span>
            </span>{' '}
            <span id="modal-project-problem" class="text-[var(--text-secondary)]"></span>
          </div>
          <div class="rounded-xl bg-[var(--bg-elevated)] p-3.5">
            <span class="font-mono font-bold text-[var(--accent-primary)]">
              <span data-lang="id">{translations.id.projects.solution}</span>
              <span data-lang="en">{translations.en.projects.solution}</span>
            </span>{' '}
            <span id="modal-project-solution" class="text-[var(--text-secondary)]"></span>
          </div>
          <div class="px-2 py-1">
            <span class="font-mono font-bold text-[var(--text-primary)]">
              <span data-lang="id">{translations.id.projects.role}</span>
              <span data-lang="en">{translations.en.projects.role}</span>
            </span>{' '}
            <span id="modal-project-role" class="text-[var(--text-secondary)]"></span>
          </div>
        </div>

        <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between font-mono text-xs">
          <div id="modal-project-stack" class="flex flex-wrap gap-1.5"></div>
          <div id="modal-project-link"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ projectsData: projects }}>
  // 1. Interactive Pipeline Simulation in Featured Project
  const runPipelineBtn = document.getElementById('run-pipeline-btn');
  const pipeSteps = document.querySelectorAll('.pipe-step');
  let isSimulating = false;

  function runPipelineSimulation() {
    if (isSimulating || !pipeSteps.length) return;
    isSimulating = true;

    const tokens = document.querySelectorAll('.pipe-token');
    const vecStatus = document.getElementById('pipe-vector-status');
    tokens.forEach((t) => {
      t.classList.remove('text-[var(--accent-primary)]', 'border', 'border-[var(--border-focus)]');
    });
    if (vecStatus) vecStatus.textContent = 'indexing...';

    pipeSteps.forEach((step) => {
      step.classList.remove('border-[var(--accent-primary)]', 'bg-[var(--bg-elevated)]');
      const dot = step.querySelector('.pipe-dot');
      const badge = step.querySelector('.pipe-badge');
      if (dot) dot.className = 'pipe-dot w-2.5 h-2.5 rounded-full bg-[var(--text-muted)]';
      if (badge) {
        badge.textContent = 'QUEUE';
        badge.className = 'pipe-badge text-[10px] px-2 py-0.5 rounded bg-[var(--bg-elevated)] text-[var(--text-muted)]';
      }
    });

    tokens.forEach((t, i) => {
      setTimeout(() => {
        t.classList.add('text-[var(--accent-primary)]', 'border', 'border-[var(--border-focus)]');
      }, (i + 1) * 180);
    });

    pipeSteps.forEach((step, idx) => {
      setTimeout(() => {
        step.classList.add('border-[var(--accent-primary)]', 'bg-[var(--bg-elevated)]');
        const dot = step.querySelector('.pipe-dot');
        const badge = step.querySelector('.pipe-badge');
        if (dot) dot.className = 'pipe-dot w-2.5 h-2.5 rounded-full bg-[var(--status-ok)] shadow-[0_0_8px_var(--status-ok)]';
        if (badge) {
          badge.textContent = '✓ DONE';
          badge.className = 'pipe-badge text-[10px] px-2 py-0.5 rounded bg-[var(--bg-surface)] text-[var(--status-ok)] font-bold';
        }
        if (idx === pipeSteps.length - 1) {
          if (vecStatus) vecStatus.textContent = '✓ vectors aligned';
          isSimulating = false;
        }
      }, (idx + 1) * 340);
    });
  }

  runPipelineBtn?.addEventListener('click', runPipelineSimulation);

  const simulatorEl = document.getElementById('pipeline-simulator');
  if (simulatorEl && 'IntersectionObserver' in window) {
    const simObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runPipelineSimulation();
            simObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    simObserver.observe(simulatorEl);
  }

  // 2. Real-Time NLP Cosine & Jaccard Similarity Sandbox
  const docAInput = document.getElementById('nlp-doc-a');
  const docBInput = document.getElementById('nlp-doc-b');
  const countAEl = document.getElementById('nlp-count-a');
  const countBEl = document.getElementById('nlp-count-b');
  const cosineScoreEl = document.getElementById('nlp-cosine-score');
  const jaccardScoreEl = document.getElementById('nlp-jaccard-score');
  const gaugeCircle = document.getElementById('nlp-gauge-circle');
  const matchBadgeEl = document.getElementById('nlp-match-badge');
  const sharedTokensEl = document.getElementById('nlp-shared-tokens');

  const STOPWORDS = new Set([
    'yang', 'dan', 'di', 'ke', 'dari', 'untuk', 'pada', 'dengan', 'ini', 'itu', 'atau', 'dalam', 'secara', 'antar',
    'the', 'and', 'to', 'of', 'in', 'for', 'with', 'on', 'is', 'are', 'by', 'as', 'an', 'a', 'through',
  ]);

  function tokenizeText(raw) {
    return String(raw || '')
      .toLowerCase()
      .replace(/[^a-z0-9\s-]/g, ' ')
      .split(/\s+/)
      .filter((w) => w.length > 2 && !STOPWORDS.has(w));
  }

  function computeSimilarityLive() {
    if (!docAInput || !docBInput) return;
    const tokensA = tokenizeText(docAInput.value);
    const tokensB = tokenizeText(docBInput.value);

    if (countAEl) countAEl.textContent = `${tokensA.length} tokens`;
    if (countBEl) countBEl.textContent = `${tokensB.length} tokens`;

    const freqA = {};
    const freqB = {};
    const vocab = new Set();

    tokensA.forEach((t) => {
      freqA[t] = (freqA[t] || 0) + 1;
      vocab.add(t);
    });
    tokensB.forEach((t) => {
      freqB[t] = (freqB[t] || 0) + 1;
      vocab.add(t);
    });

    let dot = 0;
    let magA = 0;
    let magB = 0;
    const shared = [];

    vocab.forEach((term) => {
      const a = freqA[term] || 0;
      const b = freqB[term] || 0;
      dot += a * b;
      magA += a * a;
      magB += b * b;
      if (a > 0 && b > 0) shared.push(term);
    });

    const cosine = magA > 0 && magB > 0 ? dot / (Math.sqrt(magA) * Math.sqrt(magB)) : 0;
    const setA = new Set(tokensA);
    const setB = new Set(tokensB);
    const unionSize = new Set([...setA, ...setB]).size;
    const jaccard = unionSize > 0 ? shared.length / unionSize : 0;

    const cosinePct = Math.round(cosine * 100);
    const jaccardPct = Math.round(jaccard * 100);

    if (cosineScoreEl) cosineScoreEl.textContent = `${cosinePct}%`;
    if (jaccardScoreEl) jaccardScoreEl.textContent = `${jaccardPct}%`;
    if (matchBadgeEl) matchBadgeEl.textContent = cosinePct >= 60 ? 'HIGH' : cosinePct >= 30 ? 'MED' : 'LOW';

    if (gaugeCircle) {
      const circumference = 163.36;
      const offset = circumference - (cosinePct / 100) * circumference;
      gaugeCircle.style.strokeDashoffset = String(offset);
    }

    if (sharedTokensEl) {
      sharedTokensEl.innerHTML = '';
      if (shared.length === 0) {
        const empty = document.createElement('span');
        empty.className = 'text-[10px] text-[var(--text-muted)]';
        empty.textContent = '0 shared tokens';
        sharedTokensEl.appendChild(empty);
      } else {
        shared.forEach((word) => {
          const badge = document.createElement('span');
          badge.className =
            'px-2 py-0.5 rounded-md bg-[var(--bg-elevated)] border border-[var(--border-focus)] text-[10px] text-[var(--accent-primary)] font-semibold animate-boot-line';
          badge.textContent = word;
          sharedTokensEl.appendChild(badge);
        });
      }
    }
  }

  docAInput?.addEventListener('input', computeSimilarityLive);
  docBInput?.addEventListener('input', computeSimilarityLive);

  document.getElementById('nlp-preset-1')?.addEventListener('click', () => {
    const isEn = document.documentElement.getAttribute('lang') === 'en';
    if (docAInput && docBInput) {
      docAInput.value = isEn
        ? 'Document similarity detection preprocesses text using tokenization, stopword removal, and TF-IDF vector weighting to measure cosine similarity.'
        : 'Sistem deteksi kemiripan dokumen memproses teks melalui tahap tokenisasi, penghapusan stopword, dan pembobotan vektor TF-IDF untuk mengukur skor kemiripan.';
      docBInput.value = isEn
        ? 'Text preprocessing applies tokenization and TF-IDF document vectors to calculate cosine similarity scores across academic documents.'
        : 'Metode pemrosesan teks menggunakan tokenisasi dan vektor TF-IDF dokumen untuk menghitung skor kemiripan antar dokumen akademik.';
      computeSimilarityLive();
      runPipelineSimulation();
    }
  });

  document.getElementById('nlp-preset-2')?.addEventListener('click', () => {
    const isEn = document.documentElement.getAttribute('lang') === 'en';
    if (docAInput && docBInput) {
      docAInput.value = isEn
        ? 'Clean backend architecture separates REST API routing, business service logic, and PostgreSQL relational database queries with TypeScript.'
        : 'Arsitektur backend bersih memisahkan routing REST API, logika layanan bisnis, dan kueri basis data relasional PostgreSQL menggunakan TypeScript.';
      docBInput.value = isEn
        ? 'Modern backend services use TypeScript, modular REST API handlers, and structured PostgreSQL database repositories for maintainable software.'
        : 'Layanan backend modern menggunakan TypeScript, handler REST API modular, dan repositori basis data PostgreSQL terstruktur.';
      computeSimilarityLive();
      runPipelineSimulation();
    }
  });

  computeSimilarityLive();

  // 3. Modal Logic
  const modal = document.getElementById('project-modal');
  const closeBtn = document.getElementById('modal-close-btn');
  const titleEl = document.getElementById('modal-project-title');
  const catEl = document.getElementById('modal-project-category');
  const summaryEl = document.getElementById('modal-project-summary');
  const problemEl = document.getElementById('modal-project-problem');
  const solutionEl = document.getElementById('modal-project-solution');
  const roleEl = document.getElementById('modal-project-role');
  const stackEl = document.getElementById('modal-project-stack');
  const linkEl = document.getElementById('modal-project-link');
  const headerSlugEl = document.getElementById('modal-project-header-slug');

  let lastActiveElement = null;

  function openModal(slug) {
    const proj = projectsData.find((p) => p.slug === slug);
    if (!proj) return;

    lastActiveElement = document.activeElement;

    const setBilingualText = (el, obj) => {
      if (!el) return;
      el.innerHTML = '';
      const spanId = document.createElement('span');
      spanId.setAttribute('data-lang', 'id');
      spanId.textContent = obj?.id || '-';
      const spanEn = document.createElement('span');
      spanEn.setAttribute('data-lang', 'en');
      spanEn.textContent = obj?.en || obj?.id || '-';
      el.appendChild(spanId);
      el.appendChild(spanEn);
    };

    if (headerSlugEl) headerSlugEl.textContent = `[ buffer // ${proj.slug} ]`;
    if (titleEl) titleEl.textContent = proj.title;
    if (catEl) catEl.textContent = `// ${proj.category}`;
    setBilingualText(summaryEl, proj.summary);
    setBilingualText(problemEl, proj.problem);
    setBilingualText(solutionEl, proj.solution);
    setBilingualText(roleEl, proj.role);

    if (stackEl) {
      stackEl.innerHTML = '';
      proj.techStack.forEach((t) => {
        const chip = document.createElement('span');
        chip.className = 'rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-elevated)] px-2.5 py-1 text-[var(--accent-primary)] text-[11px]';
        chip.textContent = t;
        stackEl.appendChild(chip);
      });
    }

    if (linkEl) {
      if (proj.repoUrl) {
        linkEl.innerHTML = `<a href="${proj.repoUrl}" target="_blank" rel="noopener noreferrer" class="text-[var(--accent-primary)] hover:underline">[ ↗ repo ]</a>`;
      } else {
        linkEl.innerHTML = `<span class="text-[var(--text-muted)]">[ repo: private/wip ]</span>`;
      }
    }

    modal?.classList.remove('hidden');
    requestAnimationFrame(() => {
      modal?.classList.add('is-open');
    });
    closeBtn?.focus();
  }

  function closeModal() {
    modal?.classList.remove('is-open');
    setTimeout(() => {
      modal?.classList.add('hidden');
      if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
        lastActiveElement.focus();
      }
    }, 200);
  }

  document.querySelectorAll('.project-detail-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.getAttribute('data-project-slug');
      if (slug) openModal(slug);
    });
  });

  closeBtn?.addEventListener('click', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (modal?.classList.contains('hidden')) return;
    if (e.key === 'Escape') {
      closeModal();
      return;
    }
    if (e.key === 'Tab') {
      const focusable = modal.querySelectorAll(
        'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
      );
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
