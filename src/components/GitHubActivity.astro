---
import { profile } from '../data/profile';
import { translations } from '../data/i18n';

const primaryUsername = (import.meta.env.PUBLIC_GITHUB_USERNAME || profile.githubUsername).trim();
const serverGithubToken = import.meta.env.GITHUB_TOKEN;

interface InitialStats {
  login: string;
  displayName: string;
  public_repos: number;
  followers: number;
  public_gists: number;
  loaded: boolean;
}

interface InitialRepo {
  name: string;
  html_url: string;
  description: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  pushed_at: string | null;
}

let initialStats: InitialStats = {
  login: primaryUsername,
  displayName: 'GusAdi',
  public_repos: 0,
  followers: 0,
  public_gists: 0,
  loaded: false,
};

let initialRepos: InitialRepo[] = [];

async function tryFetchGithubUser(user: string, headers: Record<string, string>, signal: AbortSignal) {
  const res = await fetch(`https://api.github.com/users/${user}`, { headers, signal });
  if (!res.ok) return null;
  return res.json();
}

// Build/Dev-time server prefetch (uses optional GITHUB_TOKEN from .env if set, or public API)
try {
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
    'User-Agent': 'gusadi-portfolio-astro',
  };
  if (serverGithubToken) {
    headers.Authorization = `Bearer ${serverGithubToken}`;
  }

  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), 4500);

  const userData = await tryFetchGithubUser(primaryUsername, headers, controller.signal);

  if (userData) {
    initialStats = {
      login: String(userData.login || primaryUsername),
      displayName: String(userData.name || 'GusAdi'),
      public_repos: typeof userData.public_repos === 'number' ? userData.public_repos : 0,
      followers: typeof userData.followers === 'number' ? userData.followers : 0,
      public_gists: typeof userData.public_gists === 'number' ? userData.public_gists : 0,
      loaded: true,
    };
  }

  const reposRes = await fetch(
    `https://api.github.com/users/${initialStats.login}/repos?sort=updated&per_page=6`,
    { headers, signal: controller.signal }
  );

  clearTimeout(timer);

  if (reposRes.ok) {
    const reposData = await reposRes.json();
    if (Array.isArray(reposData)) {
      const nonFork = reposData.filter((r) => !r.fork).slice(0, 4);
      const source = nonFork.length > 0 ? nonFork : reposData.slice(0, 4);
      initialRepos = source.map((r) => ({
        name: String(r.name || 'repository'),
        html_url: String(r.html_url || `https://github.com/${initialStats.login}`),
        description: r.description ? String(r.description) : null,
        language: r.language ? String(r.language) : null,
        stargazers_count: Number(r.stargazers_count) || 0,
        forks_count: Number(r.forks_count) || 0,
        pushed_at: r.pushed_at ? String(r.pushed_at) : null,
      }));
      if (!initialStats.loaded) {
        initialStats.public_repos = reposData.length;
      }
    }
  }
} catch (_) {
  // Silent fallback: client-side live fetch will run in the browser
}
---

<section id="github" class="w-full py-8 sm:py-12">
  <div class="w-full max-w-6xl mx-auto px-4 sm:px-8 space-y-6">
    <!-- Unified GitHub Live Telemetry Board (Wrapped in Tactile Card so text never collides with background canvas) -->
    <div class="reveal-on-scroll tactile-card p-5 sm:p-7 space-y-5 font-sans">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3">
          <span class="px-3 py-1 rounded-full bg-[var(--tint-violet)] text-violet-950 font-mono text-xs font-extrabold">
            LIVE GITHUB TELEMETRY
          </span>
          <h2 class="font-display text-2xl sm:text-3xl font-extrabold text-[var(--text-primary)]">
            <span data-lang="id">{translations.id.github.header}</span>
            <span data-lang="en">{translations.en.github.header}</span>
          </h2>
        </div>
        <span class="px-3 py-1 rounded-full bg-[var(--bg-elevated)] font-mono text-xs font-bold text-[var(--text-primary)]">
          GusAdi (@{initialStats.login})
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="tactile-card hover-lift p-5 bg-[var(--tint-mint)]">
          <div class="text-xs text-teal-900 font-bold mb-1">
            <span data-lang="id">{translations.id.github.statsRepos}</span>
            <span data-lang="en">{translations.en.github.statsRepos}</span>
          </div>
          <div id="github-stat-repos" class="font-display text-3xl sm:text-4xl font-extrabold text-teal-950">
            {initialStats.public_repos}
          </div>
        </div>

        <div class="tactile-card hover-lift p-5 bg-[var(--tint-sky)]">
          <div class="text-xs text-blue-900 font-bold mb-1">
            <span data-lang="id">{translations.id.github.statsFollowers}</span>
            <span data-lang="en">{translations.en.github.statsFollowers}</span>
          </div>
          <div id="github-stat-followers" class="font-display text-3xl sm:text-4xl font-extrabold text-blue-950">
            {initialStats.followers}
          </div>
        </div>

        <div class="tactile-card hover-lift p-5 bg-[var(--tint-amber)]">
          <div class="text-xs text-amber-900 font-bold mb-1">
            <span data-lang="id">{translations.id.github.statsGists}</span>
            <span data-lang="en">{translations.en.github.statsGists}</span>
          </div>
          <div id="github-stat-gists" class="font-display text-3xl sm:text-4xl font-extrabold text-amber-950">
            {initialStats.public_gists}
          </div>
        </div>

        <div class="tactile-card hover-lift p-5 flex flex-col justify-between bg-[var(--tint-violet)]">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs text-violet-900 font-bold">GitHub Profile</span>
            <button
              type="button"
              id="github-live-refresh-btn"
              class="text-xs text-violet-800 hover:underline font-bold cursor-pointer"
              title="Force live sync from GitHub API"
            >
              ↻ Sync Live
            </button>
          </div>
          <a
            id="github-profile-link"
            href={`https://github.com/${initialStats.login}`}
            target="_blank"
            rel="noopener noreferrer"
            class="font-display text-base sm:text-lg font-extrabold text-violet-950 hover:underline truncate mt-1"
          >
            <span id="github-display-name">{initialStats.displayName}</span>
            <span id="github-handle-sub" class="text-xs font-sans font-semibold text-violet-800 ml-1">
              (@{initialStats.login})
            </span> ↗
          </a>
        </div>
      </div>

      <!-- Live Sync Status Line -->
      <div id="github-sync-status" class="text-xs text-[var(--text-muted)] hidden"></div>
    </div>

    <!-- 2. Contribution Heatmap + Interactive Snake in Soft Panel -->
    <div class="reveal-on-scroll soft-panel spotlight-surface p-6 sm:p-7 space-y-5 font-sans select-none" style="--stagger: 1;">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]">
            <span data-lang="id">{translations.id.github.calendarTitle}</span>
            <span data-lang="en">{translations.en.github.calendarTitle}</span>
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-0.5">
            <span data-lang="id">{translations.id.github.calendarSub}</span>
            <span data-lang="en">{translations.en.github.calendarSub}</span>
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span id="calendar-hover-info" class="text-xs text-[var(--accent-primary)] hidden md:inline font-medium mr-1"></span>

          <span
            id="snake-score-badge"
            class="hidden font-mono text-xs text-[var(--text-secondary)]"
          >
            🐍 0 / 0
          </span>

          <button
            type="button"
            id="snake-toggle-btn"
            class="hidden pill-btn bg-[var(--accent-primary)] text-[var(--accent-ink)] font-semibold px-3.5 py-1 text-xs cursor-pointer"
            aria-label="Toggle contribution snake animation"
          >
            <span id="snake-toggle-label">🐍 Jeda</span>
          </button>

          <button
            type="button"
            id="snake-reset-btn"
            class="hidden pill-btn border border-[var(--border-strong)] hover:border-[var(--accent-primary)] text-[var(--text-primary)] font-medium px-3 py-1 text-xs cursor-pointer"
            title="Reset eaten contributions"
