          <span id="calendar-total-count" class="text-[var(--text-secondary)] font-semibold text-xs"></span>
        </div>
      </div>

      <!-- Loading State -->
      <div id="calendar-loading" class="py-6 text-[var(--text-muted)] text-sm">
        <span data-lang="id">{translations.id.github.calendarLoading}</span>
        <span data-lang="en">{translations.en.github.calendarLoading}</span>
      </div>

      <!-- Error / Fallback State -->
      <div id="calendar-fallback" class="hidden py-6 space-y-3">
        <div class="text-[var(--status-warn)] text-sm font-medium">
          <span data-lang="id">{translations.id.github.calendarError}</span>
          <span data-lang="en">{translations.en.github.calendarError}</span>
        </div>
        <div>
          <a
            id="github-fallback-link"
            href={`https://github.com/${initialStats.login}`}
            target="_blank"
            rel="noopener noreferrer"
            class="pill-btn inline-flex items-center gap-2 border border-[var(--border-strong)] text-[var(--accent-primary)] px-4 py-2 text-xs font-semibold"
          >
            <span data-lang="id">{translations.id.github.openGithub}</span>
            <span data-lang="en">{translations.en.github.openGithub}</span>
          </a>
        </div>
      </div>

      <!-- Heatmap Grid Container -->
      <div
        id="calendar-container"
        class="hidden overflow-x-auto pb-2"
        role="region"
        aria-label="GitHub contribution heatmap for the past 12 months"
      >
        <div id="calendar-matrix" class="flex justify-between gap-[4px] min-w-[720px] py-2"></div>

        <div class="flex flex-wrap items-center justify-between gap-2 pt-3 text-xs text-[var(--text-muted)]">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-xs bg-[var(--accent-secondary)]"></span>
            <span data-lang="id">Ular memakan kontribusi aktif secara otomatis</span>
            <span data-lang="en">Snake traverses active contribution cells</span>
          </div>
          <div class="flex items-center gap-1.5">
            <span>
              <span data-lang="id">{translations.id.github.less}</span>
              <span data-lang="en">{translations.en.github.less}</span>
            </span>
            <span class="w-3 h-3 rounded-xs bg-[var(--bg-elevated)]"></span>
            <span class="w-3 h-3 rounded-xs bg-[var(--gh-lvl-1)]"></span>
            <span class="w-3 h-3 rounded-xs bg-[var(--gh-lvl-2)]"></span>
            <span class="w-3 h-3 rounded-xs bg-[var(--gh-lvl-3)]"></span>
            <span class="w-3 h-3 rounded-xs bg-[var(--gh-lvl-4)]"></span>
            <span>
              <span data-lang="id">{translations.id.github.more}</span>
              <span data-lang="en">{translations.en.github.more}</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. Recent Public Repositories: Tactile Card Container for High Contrast -->
    <div class="reveal-on-scroll tactile-card p-6 sm:p-7 space-y-4 font-sans" style="--stagger: 2;">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <div>
          <h3 class="text-lg sm:text-xl font-bold text-[var(--text-primary)]">
            <span data-lang="id">{translations.id.github.recentReposTitle}</span>
            <span data-lang="en">{translations.en.github.recentReposTitle}</span>
          </h3>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-0.5">
            <span data-lang="id">{translations.id.github.recentReposSub}</span>
            <span data-lang="en">{translations.en.github.recentReposSub}</span>
          </p>
        </div>
        <a
          id="github-all-repos-link"
          href={`https://github.com/${initialStats.login}?tab=repositories`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs sm:text-sm text-[var(--accent-primary)] hover:underline font-semibold"
        >
          <span data-lang="id">Lihat semua repositori ↗</span>
          <span data-lang="en">View all repositories ↗</span>
        </a>
      </div>

      <div id="github-repos-grid" class="divide-y divide-[var(--border-subtle)]">
        {initialRepos.length > 0 ? (
          initialRepos.map((repo) => (
            <a
              href={repo.html_url}
              target="_blank"
              rel="noopener noreferrer"
              class="py-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 group transition-colors font-sans"
            >
              <div class="space-y-1 max-w-2xl">
                <span class="font-sans text-base sm:text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors">
                  {repo.name} ↗
                </span>
                <p class="font-sans text-sm text-[var(--text-secondary)] leading-relaxed">
                  {repo.description || 'Public repository on GitHub.'}
                </p>
              </div>
              <div class="flex items-center gap-3 text-xs text-[var(--text-muted)] shrink-0">
                <span class="text-[var(--text-secondary)] font-medium">{repo.language || 'Code'}</span>
                <span>
                  ★ {repo.stargazers_count}
                  {repo.pushed_at ? ` · ${repo.pushed_at.slice(0, 10)}` : ''}
                </span>
              </div>
            </a>
          ))
        ) : (
          <div class="py-4 text-sm text-[var(--text-muted)]">
            <span data-lang="id">{translations.id.github.reposEmpty}</span>
            <span data-lang="en">{translations.en.github.reposEmpty}</span>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script define:vars={{ username: initialStats.login, serverStats: initialStats }}>
  const activeUsername = username;
  const CACHE_TTL_MS = 15 * 60 * 1000;

  const syncStatusEl = document.getElementById('github-sync-status');

  function setSyncStatus(msg, isWarn = false) {
    if (!syncStatusEl) return;
    if (!msg) {
      syncStatusEl.classList.add('hidden');
      syncStatusEl.textContent = '';
      return;
    }
    syncStatusEl.textContent = msg;
    syncStatusEl.classList.remove('hidden');
    syncStatusEl.className = isWarn
      ? 'text-xs text-[var(--status-warn)] font-medium'
      : 'text-xs text-[var(--text-muted)]';
  }

  function readCache(key, allowStale = false) {
    try {
      const raw = localStorage.getItem(key);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed.ts !== 'number') return null;
      if (!allowStale && Date.now() - parsed.ts > CACHE_TTL_MS) return null;
      return parsed.data;
    } catch (_) {
      return null;
    }
  }

  function writeCache(key, data) {
    try {
      localStorage.setItem(key, JSON.stringify({ ts: Date.now(), data }));
    } catch (_) {}
  }

  async function fetchWithTimeout(url, timeoutMs = 8000) {
    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeoutMs);
    try {
      const res = await fetch(url, {
        headers: { Accept: 'application/vnd.github+json' },
        signal: controller.signal,
      });
      return res;
    } finally {
      clearTimeout(timer);
    }
  }

  function animateCount(el, targetValue) {
    if (!el) return;
    const target = Number(targetValue);
    if (Number.isNaN(target) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = String(targetValue ?? '0');
      return;
    }
    const duration = 650;
    const startTime = performance.now();
    function tick(now) {
      const elapsed = now - startTime;
      const progress = Math.min(elapsed / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = String(Math.round(target * eased));
      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        el.textContent = String(target);
      }
    }
    requestAnimationFrame(tick);
  }

  function updateProfileLinks(loginHandle, displayName) {
    const profileLink = document.getElementById('github-profile-link');
    const displayEl = document.getElementById('github-display-name');
    const handleSubEl = document.getElementById('github-handle-sub');
    const fallbackLink = document.getElementById('github-fallback-link');
    const allReposLink = document.getElementById('github-all-repos-link');
    const contactLink = document.getElementById('contact-github-link');
    const contactText = document.getElementById('contact-github-text');

    if (profileLink) profileLink.setAttribute('href', `https://github.com/${loginHandle}`);
    if (fallbackLink) fallbackLink.setAttribute('href', `https://github.com/${loginHandle}`);
    if (allReposLink) allReposLink.setAttribute('href', `https://github.com/${loginHandle}?tab=repositories`);
    if (contactLink) contactLink.setAttribute('href', `https://github.com/${loginHandle}`);
    if (contactText) contactText.textContent = `github.com/${loginHandle}`;
    if (displayEl) displayEl.textContent = displayName || loginHandle;
    if (handleSubEl) handleSubEl.textContent = `(@${loginHandle})`;
  }

  function renderUserStats(data) {
    const repoEl = document.getElementById('github-stat-repos');
    const followersEl = document.getElementById('github-stat-followers');
    const gistsEl = document.getElementById('github-stat-gists');

    animateCount(repoEl, data.public_repos ?? 0);
    animateCount(followersEl, data.followers ?? 0);
    animateCount(gistsEl, data.public_gists ?? 0);

    updateProfileLinks(activeUsername, data.name || 'GusAdi');
  }

  async function fetchUserStats(forceRefresh = false) {
    const cacheKey = `gh_stats_v4_${activeUsername}`;
    if (!forceRefresh) {
      const cached = readCache(cacheKey, false);
      if (cached) {
        renderUserStats(cached);
        return;
      }
    }

    try {
      const res = await fetchWithTimeout(`https://api.github.com/users/${activeUsername}`);

      if (!res.ok) {
        const stale = readCache(cacheKey, true);
        if (stale) {
          renderUserStats(stale);
        } else if (serverStats) {
          renderUserStats(serverStats);
        }
        if (res.status === 403 || res.status === 429) {
          setSyncStatus(
            'Info: Batas 60 request/jam GitHub API publik tercapai. Tambahkan GITHUB_TOKEN di .env untuk kuota 5.000/jam.',
            true
          );
        }
        return;
      }

      const data = await res.json();
      const subset = {
        login: activeUsername,
        name: data.name || 'GusAdi',
        public_repos: data.public_repos ?? 0,
        followers: data.followers ?? 0,
        public_gists: data.public_gists ?? 0,
      };
      writeCache(cacheKey, subset);
      renderUserStats(subset);
      setSyncStatus('');
    } catch (_) {
      const stale = readCache(cacheKey, true);
      if (stale) renderUserStats(stale);
    }
  }

  let snakeInterval = null;
  let snakeRunning = false;
  let gridCells = [];
  let foodCoords = new Set();
  let initialFoodCoords = [];
  let snakeSegments = [];
  let maxSnakeLength = 7;
  let eatenCount = 0;
  let totalFoodCount = 0;

  const SNAKE_CLASSES = ['snake-head', 'snake-body-1', 'snake-body-2', 'snake-body-3', 'snake-tail'];

  function updateSnakeScoreUI() {
    const scoreBadge = document.getElementById('snake-score-badge');
    if (scoreBadge) {
      scoreBadge.textContent = `🐍 ${eatenCount} / ${totalFoodCount}`;
    }
  }

  function clearSnakeClasses() {
    for (let c = 0; c < gridCells.length; c++) {
      for (let r = 0; r < (gridCells[c]?.length || 0); r++) {
        const el = gridCells[c][r];
        if (el) el.classList.remove(...SNAKE_CLASSES);
      }
    }
  }

  function drawSnake() {
    clearSnakeClasses();
    snakeSegments.forEach(([c, r], idx) => {
      const cell = gridCells[c]?.[r];
      if (!cell) return;
      if (idx === 0) {
        cell.classList.add('snake-head');
      } else if (idx === 1) {
        cell.classList.add('snake-body-1');
      } else if (idx === 2) {
        cell.classList.add('snake-body-2');
      } else if (idx <= 4) {
        cell.classList.add('snake-body-3');
      } else {
        cell.classList.add('snake-tail');
      }
    });
  }

  function resetFoodAndSnake() {
    foodCoords.clear();
    initialFoodCoords.forEach(([c, r]) => {
      foodCoords.add(`${c},${r}`);
      const cell = gridCells[c]?.[r];
      if (cell) cell.classList.remove('is-eaten');
    });
    eatenCount = 0;
    totalFoodCount = initialFoodCoords.length;
    maxSnakeLength = 7;
    snakeSegments = [
      [0, 0],
      [0, 1],
      [0, 2],
    ];
    updateSnakeScoreUI();
    drawSnake();
  }

  function findNextTarget(headC, headR) {
    if (foodCoords.size === 0) return null;
    let bestTarget = null;
    let bestScore = Infinity;

    foodCoords.forEach((key) => {
      const [fc, fr] = key.split(',').map(Number);
      const dist = Math.abs(fc - headC) + Math.abs(fr - headR);
      const score = dist + fc * 0.15;
      if (score < bestScore) {
        bestScore = score;
        bestTarget = [fc, fr];
      }
    });

    return bestTarget;
  }

  function stepSnake() {
    if (!gridCells.length) return;

    if (foodCoords.size === 0 && totalFoodCount > 0) {
      resetFoodAndSnake();
      return;
    }

    const [headC, headR] = snakeSegments[0];
    const target = findNextTarget(headC, headR) || [
      Math.floor(Math.random() * gridCells.length),
      Math.floor(Math.random() * 7),
    ];

    const dirs = [
      [1, 0],
      [-1, 0],
      [0, 1],
      [0, -1],
    ];

    const bodySet = new Set(snakeSegments.slice(0, -1).map(([c, r]) => `${c},${r}`));

    const validMoves = [];
    for (const [dc, dr] of dirs) {
      const nc = headC + dc;
      const nr = headR + dr;
      if (nc >= 0 && nc < gridCells.length && nr >= 0 && nr < (gridCells[nc]?.length || 0)) {
        const inBody = bodySet.has(`${nc},${nr}`);
        const dist = Math.abs(target[0] - nc) + Math.abs(target[1] - nr);
        validMoves.push({ nc, nr, inBody, dist });
      }
    }

    if (!validMoves.length) return;

    validMoves.sort((a, b) => {
      if (a.inBody !== b.inBody) return a.inBody ? 1 : -1;
      return a.dist - b.dist;
    });

    const bestMove = validMoves[0];
    const nextCoord = [bestMove.nc, bestMove.nr];
    const nextKey = `${bestMove.nc},${bestMove.nr}`;

    snakeSegments.unshift(nextCoord);

    if (foodCoords.has(nextKey)) {
      foodCoords.delete(nextKey);
      eatenCount++;
      if (maxSnakeLength < 11 && eatenCount % 4 === 0) {
        maxSnakeLength++;
      }
      const eatenCell = gridCells[bestMove.nc]?.[bestMove.nr];
      if (eatenCell) {
        eatenCell.classList.add('is-eaten');
      }
      updateSnakeScoreUI();
    }

    while (snakeSegments.length > maxSnakeLength) {
      snakeSegments.pop();
    }

    drawSnake();
  }

  function startSnake() {
    if (snakeInterval) clearInterval(snakeInterval);
    snakeRunning = true;
    snakeInterval = setInterval(stepSnake, 85);
    const toggleLabel = document.getElementById('snake-toggle-label');
    if (toggleLabel) toggleLabel.textContent = '🐍 Jeda';
  }

  function pauseSnake() {
    if (snakeInterval) clearInterval(snakeInterval);
    snakeInterval = null;
    snakeRunning = false;
    const toggleLabel = document.getElementById('snake-toggle-label');
    if (toggleLabel) toggleLabel.textContent = '🐍 Main';
  }

  let snakeControlsBound = false;

  function initSnakeGame() {
    const scoreBadge = document.getElementById('snake-score-badge');
    const toggleBtn = document.getElementById('snake-toggle-btn');
    const resetBtn = document.getElementById('snake-reset-btn');

    scoreBadge?.classList.remove('hidden');
    toggleBtn?.classList.remove('hidden');
    resetBtn?.classList.remove('hidden');

    resetFoodAndSnake();

    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      startSnake();
    } else {
      pauseSnake();
    }

    if (!snakeControlsBound) {
      snakeControlsBound = true;
      toggleBtn?.addEventListener('click', () => {
        if (snakeRunning) {
          pauseSnake();
        } else {
          startSnake();
        }
      });

      resetBtn?.addEventListener('click', () => {
        resetFoodAndSnake();
        if (!snakeRunning) startSnake();
      });
    }
  }

  function renderContributions(data) {
    const loadingEl = document.getElementById('calendar-loading');
    const containerEl = document.getElementById('calendar-container');
    const fallbackEl = document.getElementById('calendar-fallback');
    const matrixEl = document.getElementById('calendar-matrix');
    const totalCountEl = document.getElementById('calendar-total-count');
    const hoverInfoEl = document.getElementById('calendar-hover-info');

    const contributions = data.contributions || [];
    if (!contributions.length) throw new Error('Empty contributions');

    if (totalCountEl && data.total?.lastYear !== undefined) {
      totalCountEl.textContent = `· ${data.total.lastYear} contributions`;
    }

    const weeks = [];
    let currentWeek = [];

    contributions.forEach((day, index) => {
      currentWeek.push(day);
      if (currentWeek.length === 7 || index === contributions.length - 1) {
        weeks.push(currentWeek);
        currentWeek = [];
      }
    });

    const levelClasses = [
      'bg-[var(--bg-elevated)]',
      'bg-[var(--gh-lvl-1)]',
      'bg-[var(--gh-lvl-2)]',
      'bg-[var(--gh-lvl-3)]',
      'bg-[var(--gh-lvl-4)]',
    ];

    if (matrixEl) {
      initialFoodCoords = [];

      matrixEl.innerHTML = weeks
        .map((week, wIdx) => {
          const daysHtml = week
            .map((d, dIdx) => {
              const lvl = Math.min(Math.max(Number(d.level) || 0, 0), 4);
              const colorClass = levelClasses[lvl];
              const safeDate = String(d.date || '').replace(/[^0-9-]/g, '');
              const safeCount = Number(d.count) || 0;
              if (lvl > 0) {
                initialFoodCoords.push([wIdx, dIdx]);
              }
              return `<div class="gh-cell w-3 h-3 ${colorClass}" data-col="${wIdx}" data-row="${dIdx}" data-level="${lvl}" data-date="${safeDate}" data-count="${safeCount}" title="${safeDate}: ${safeCount} contributions"></div>`;
            })
            .join('');
          return `<div class="flex flex-col gap-[4px] animate-boot-line" style="animation-delay: ${wIdx * 8}ms;">${daysHtml}</div>`;
        })
        .join('');

      gridCells = weeks.map(() => []);
      matrixEl.querySelectorAll('.gh-cell').forEach((cell) => {
        const c = Number(cell.getAttribute('data-col'));
        const r = Number(cell.getAttribute('data-row'));
        if (!Number.isNaN(c) && !Number.isNaN(r)) {
          gridCells[c][r] = cell;
        }

        cell.addEventListener('mouseenter', () => {
          const dt = cell.getAttribute('data-date');
          const cnt = cell.getAttribute('data-count');
          if (hoverInfoEl && dt) {
            hoverInfoEl.textContent = `${dt} · ${cnt} contributions`;
          }
        });
      });

      matrixEl.addEventListener('mouseleave', () => {
        if (hoverInfoEl) hoverInfoEl.textContent = '';
      });

      initSnakeGame();
    }

    loadingEl?.classList.add('hidden');
    fallbackEl?.classList.add('hidden');
    containerEl?.classList.remove('hidden');
  }

  async function fetchContributions(forceRefresh = false) {
    const loadingEl = document.getElementById('calendar-loading');
    const fallbackEl = document.getElementById('calendar-fallback');
    const cacheKey = `gh_contrib_v4_${activeUsername}`;

    if (!forceRefresh) {
      const cached = readCache(cacheKey, false);
      if (cached) {
        try {
          renderContributions(cached);
          return;
        } catch (_) {}
      }
    }

    try {
      const res = await fetchWithTimeout(
        `https://github-contributions-api.jogruber.de/v4/${activeUsername}?y=last`
      );
      if (!res.ok) throw new Error('API failed');

      const data = await res.json();
      renderContributions(data);
      writeCache(cacheKey, data);
    } catch (_) {
      const stale = readCache(cacheKey, true);
      if (stale) {
        try {
          renderContributions(stale);
          return;
        } catch (_) {}
      }
      loadingEl?.classList.add('hidden');
      fallbackEl?.classList.remove('hidden');
    }
  }

  function renderRecentRepos(repos) {
    const gridEl = document.getElementById('github-repos-grid');
    if (!gridEl || !Array.isArray(repos) || repos.length === 0) return;

    gridEl.innerHTML = '';

    repos.slice(0, 4).forEach((repo) => {
      const row = document.createElement('a');
      row.href = String(repo.html_url || `https://github.com/${activeUsername}`);
      row.target = '_blank';
      row.rel = 'noopener noreferrer';
      row.className =
        'py-4 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 group transition-colors font-sans';

      const leftDiv = document.createElement('div');
      leftDiv.className = 'space-y-1 max-w-2xl';

      const nameSpan = document.createElement('span');
      nameSpan.className =
        'font-sans text-base sm:text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--accent-primary)] transition-colors';
      nameSpan.textContent = `${repo.name || 'repository'} ↗`;

      const descP = document.createElement('p');
      descP.className = 'font-sans text-sm text-[var(--text-secondary)] leading-relaxed';
      descP.textContent = repo.description || 'Public repository on GitHub.';

      leftDiv.appendChild(nameSpan);
      leftDiv.appendChild(descP);

      const rightDiv = document.createElement('div');
      rightDiv.className = 'flex items-center gap-3 text-xs text-[var(--text-muted)] shrink-0';

      const langText = document.createElement('span');
      langText.className = 'text-[var(--text-secondary)] font-medium';
      langText.textContent = repo.language || 'Code';

      const statsWrap = document.createElement('span');
      const stars = Number(repo.stargazers_count) || 0;
      const updatedDate = repo.pushed_at ? String(repo.pushed_at).slice(0, 10) : '';
      statsWrap.textContent = `★ ${stars}${updatedDate ? ` · ${updatedDate}` : ''}`;

      rightDiv.appendChild(langText);
      rightDiv.appendChild(statsWrap);

      row.appendChild(leftDiv);
      row.appendChild(rightDiv);
      gridEl.appendChild(row);
    });
  }

  async function fetchRecentRepos(forceRefresh = false) {
    const cacheKey = `gh_repos_v4_${activeUsername}`;
    if (!forceRefresh) {
      const cached = readCache(cacheKey, false);
      if (cached) {
        renderRecentRepos(cached);
        return;
      }
    }

    try {
      const res = await fetchWithTimeout(
        `https://api.github.com/users/${activeUsername}/repos?sort=updated&per_page=6`
      );
      if (!res.ok) {
        const stale = readCache(cacheKey, true);
        if (stale) renderRecentRepos(stale);
        return;
      }
      const data = await res.json();
      if (!Array.isArray(data)) return;
      const cleanRepos = data
        .filter((r) => !r.fork)
        .slice(0, 4)
        .map((r) => ({
          name: r.name,
          html_url: r.html_url,
          description: r.description,
          language: r.language,
          stargazers_count: r.stargazers_count,
          forks_count: r.forks_count,
          pushed_at: r.pushed_at,
        }));
      const listToSave = cleanRepos.length > 0 ? cleanRepos : data.slice(0, 4);
      writeCache(cacheKey, listToSave);
      renderRecentRepos(listToSave);
    } catch (_) {
      const stale = readCache(cacheKey, true);
      if (stale) renderRecentRepos(stale);
    }
  }

  document.getElementById('github-live-refresh-btn')?.addEventListener('click', async () => {
    setSyncStatus('Menyinkronkan data live dari GitHub...', false);
    await fetchUserStats(true);
    await Promise.all([
      fetchContributions(true),
      fetchRecentRepos(true),
    ]);
    window.dispatchEvent(
      new CustomEvent('portfolio:toast', { detail: { message: '✓ Data GitHub diperbarui' } })
    );
  });

  (async () => {
    await fetchUserStats(false);
    fetchContributions(false);
    fetchRecentRepos(false);
  })();
</script>
