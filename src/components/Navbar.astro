---
import { translations } from '../data/i18n';
import { experiences } from '../data/profile';
import { Sun, Moon, Menu, X, Search, Gamepad2, Palette } from 'lucide-astro';

const hasExperience = experiences.length > 0;
---

<!-- Top Floating Interactive Studio Capsule Bar (No Sidebar) -->
<header class="sticky top-4 z-40 px-4 sm:px-6 pointer-events-none select-none">
  <div class="max-w-6xl mx-auto flex items-center justify-between gap-2 rounded-full bg-[var(--bg-surface)]/95 backdrop-blur-md border-2 border-[var(--border-subtle)] shadow-[var(--card-shadow)] px-4 sm:px-5 py-2.5 pointer-events-auto transition-all duration-200">
    <!-- Brand Name + Live Studio Badge -->
    <div class="flex items-center gap-3 pl-1">
      <a
        href="#hero"
        class="inline-flex items-center gap-2 font-display font-bold text-base sm:text-lg tracking-tight text-[var(--text-primary)] hover:text-[var(--accent-primary)] transition-colors"
      >
        <span class="w-2.5 h-2.5 rounded-full bg-[var(--accent-primary)] status-pulse-dot" aria-hidden="true"></span>
        <span>Gus Adi<span class="text-[var(--accent-primary)]">.</span></span>
      </a>
      <span class="hidden lg:inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-[var(--tint-mint)] text-[var(--accent-primary)] font-sans text-[11px] font-bold">
        Bali, Indonesia
      </span>
    </div>

    <!-- Clean Pill Links (Desktop — Reordered Spatial Studio Flow) -->
    <nav class="hidden md:flex items-center gap-1 font-sans text-xs sm:text-sm font-medium text-[var(--text-secondary)]" aria-label="Main Navigation">
      <a href="#projects" data-nav-section="projects" class="nav-anchor px-3.5 py-1.5 rounded-full hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] transition-all">
        <span data-lang="id">{translations.id.nav.projects}</span>
        <span data-lang="en">{translations.en.nav.projects}</span>
      </a>
      <a href="#stack" data-nav-section="stack" class="nav-anchor px-3.5 py-1.5 rounded-full hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] transition-all">
        <span data-lang="id">{translations.id.nav.stack}</span>
        <span data-lang="en">{translations.en.nav.stack}</span>
      </a>
      <a href="#about" data-nav-section="about" class="nav-anchor px-3.5 py-1.5 rounded-full hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] transition-all">
        <span data-lang="id">{translations.id.nav.about}</span>
        <span data-lang="en">{translations.en.nav.about}</span>
      </a>
      {hasExperience && (
        <a href="#experience" data-nav-section="experience" class="nav-anchor px-3.5 py-1.5 rounded-full hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] transition-all">
          <span data-lang="id">{translations.id.nav.experience}</span>
          <span data-lang="en">{translations.en.nav.experience}</span>
        </a>
      )}
      <a href="#github" data-nav-section="github" class="nav-anchor px-3.5 py-1.5 rounded-full hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] transition-all">
        <span data-lang="id">{translations.id.nav.github}</span>
        <span data-lang="en">{translations.en.nav.github}</span>
      </a>
      <a href="#contact" data-nav-section="contact" class="nav-anchor px-3.5 py-1.5 rounded-full hover:text-[var(--text-primary)] hover:bg-[var(--bg-elevated)] transition-all">
        <span data-lang="id">{translations.id.nav.contact}</span>
        <span data-lang="en">{translations.en.nav.contact}</span>
      </a>
    </nav>

    <!-- Interactive Studio Controls (Accent Dots + Search + Arcade + Lang + Theme) -->
    <div class="flex items-center gap-1.5 font-sans text-xs">
      <!-- Live 4-Accent Color Switcher Pill -->
      <div
        class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-[var(--bg-elevated)] border border-[var(--border-subtle)]"
        role="group"
        aria-label="Pilih warna aksen"
        title="Ubah Warna Aksen Studio"
      >
        <Palette class="w-3.5 h-3.5 text-[var(--text-muted)] mr-0.5" />
        <button
          type="button"
          data-accent-choice="emerald"
          data-accent-label="Mint Emerald"
          class="nav-accent-dot w-3.5 h-3.5 rounded-full bg-[#0d9488] ring-2 ring-offset-1 ring-transparent hover:scale-125 transition-transform cursor-pointer"
          aria-label="Mint Emerald"
        ></button>
        <button
          type="button"
          data-accent-choice="coral"
          data-accent-label="Sunset Coral"
          class="nav-accent-dot w-3.5 h-3.5 rounded-full bg-[#ea580c] ring-2 ring-offset-1 ring-transparent hover:scale-125 transition-transform cursor-pointer"
          aria-label="Sunset Coral"
        ></button>
        <button
          type="button"
          data-accent-choice="ocean"
          data-accent-label="Royal Ocean"
          class="nav-accent-dot w-3.5 h-3.5 rounded-full bg-[#2563eb] ring-2 ring-offset-1 ring-transparent hover:scale-125 transition-transform cursor-pointer"
          aria-label="Royal Ocean"
        ></button>
        <button
          type="button"
          data-accent-choice="violet"
          data-accent-label="Electric Violet"
          class="nav-accent-dot w-3.5 h-3.5 rounded-full bg-[#7c3aed] ring-2 ring-offset-1 ring-transparent hover:scale-125 transition-transform cursor-pointer"
          aria-label="Electric Violet"
        ></button>
      </div>

      <!-- Quick Search Button (⌘K) -->
      <button
        type="button"
        id="nav-cmd-btn"
        class="hidden lg:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full bg-[var(--bg-elevated)] hover:border-[var(--accent-primary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
        aria-label="Open quick search"
        title="Pencarian Cepat (⌘K)"
      >
        <Search class="w-3.5 h-3.5 text-[var(--accent-primary)]" />
        <span class="font-mono text-[11px]">⌘K</span>
      </button>

      <!-- Mini-Game Arcade Button -->
      <button
        type="button"
        id="nav-arcade-btn"
        class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-[var(--accent-primary)] text-[var(--accent-ink)] hover:opacity-90 font-bold cursor-pointer transition-all shadow-sm"
        aria-label="Open developer mini-game arcade"
        title="Mini-Game Arcade (6 Permainan)"
      >
        <Gamepad2 class="w-3.5 h-3.5" />
        <span class="hidden sm:inline">Arcade</span>
      </button>

      <!-- Language Switcher -->
      <button
        type="button"
        id="lang-toggle-btn"
        class="px-2.5 py-1.5 rounded-full hover:bg-[var(--bg-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
        aria-label="Switch language between Indonesian and English"
        title="ID / EN"
      >
        <span id="lang-indicator-id" class="text-[var(--text-primary)] font-bold">ID</span>
        <span class="text-[var(--text-muted)] mx-0.5">/</span>
        <span id="lang-indicator-en" class="text-[var(--text-muted)]">EN</span>
      </button>

      <!-- Theme Switcher -->
      <button
        type="button"
        id="theme-toggle-btn"
        class="p-2 rounded-full hover:bg-[var(--bg-elevated)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] cursor-pointer transition-colors"
        aria-label="Toggle light and dark theme"
        title="Ganti Tema (Daylight Terang / Slate Gelap)"
      >
        <Sun id="theme-label-light" class="w-4 h-4 hidden text-amber-500" />
        <Moon id="theme-label-dark" class="w-4 h-4 text-[var(--accent-primary)]" />
      </button>

      <button type="button" id="nav-sfx-btn" class="hidden" aria-hidden="true"><span id="nav-sfx-label"></span></button>

      <!-- Mobile Menu Trigger -->
      <button
        type="button"
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-full hover:bg-[var(--bg-elevated)] text-[var(--text-primary)] cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <span id="mobile-menu-text-open"><Menu class="w-4 h-4" /></span>
        <span id="mobile-menu-text-close" class="hidden"><X class="w-4 h-4" /></span>
      </button>
    </div>
  </div>

  <!-- Clean Mobile Popover Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden max-w-6xl mx-auto mt-2 rounded-3xl bg-[var(--bg-surface)] border-2 border-[var(--border-subtle)] shadow-xl px-5 py-4 flex flex-col gap-2.5 font-sans text-sm pointer-events-auto"
  >
    <a href="#projects" class="mobile-nav-link py-1.5 font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
      <span data-lang="id">{translations.id.nav.projects}</span>
      <span data-lang="en">{translations.en.nav.projects}</span>
    </a>
    <a href="#stack" class="mobile-nav-link py-1.5 font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
      <span data-lang="id">{translations.id.nav.stack}</span>
      <span data-lang="en">{translations.en.nav.stack}</span>
    </a>
    <a href="#about" class="mobile-nav-link py-1.5 font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
      <span data-lang="id">{translations.id.nav.about}</span>
      <span data-lang="en">{translations.en.nav.about}</span>
    </a>
    {hasExperience && (
      <a href="#experience" class="mobile-nav-link py-1.5 font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
        <span data-lang="id">{translations.id.nav.experience}</span>
        <span data-lang="en">{translations.en.nav.experience}</span>
      </a>
    )}
    <a href="#github" class="mobile-nav-link py-1.5 font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
      <span data-lang="id">{translations.id.nav.github}</span>
      <span data-lang="en">{translations.en.nav.github}</span>
    </a>
    <a href="#contact" class="mobile-nav-link py-1.5 font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
      <span data-lang="id">{translations.id.nav.contact}</span>
      <span data-lang="en">{translations.en.nav.contact}</span>
    </a>
  </div>
</header>

<script>
  document.getElementById('nav-cmd-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:open-cmd'));
  });
  document.getElementById('nav-arcade-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('portfolio:open-arcade'));
  });

  // Live 4-Accent Color Dots
  const accentDots = document.querySelectorAll<HTMLButtonElement>('.nav-accent-dot');
  function syncAccentDots(active: string) {
    accentDots.forEach((dot) => {
      if (dot.getAttribute('data-accent-choice') === active) {
        dot.classList.add('ring-[var(--text-primary)]', 'scale-110');
        dot.classList.remove('ring-transparent');
      } else {
        dot.classList.remove('ring-[var(--text-primary)]', 'scale-110');
        dot.classList.add('ring-transparent');
      }
    });
  }

  syncAccentDots(document.documentElement.getAttribute('data-accent') || 'emerald');

  accentDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const choice = dot.getAttribute('data-accent-choice') || 'emerald';
      const label = dot.getAttribute('data-accent-label') || choice;
      syncAccentDots(choice);
      window.dispatchEvent(new CustomEvent('portfolio:set-accent', { detail: { accent: choice, label } }));
    });
  });

  window.addEventListener('portfolio:set-accent', (e: Event) => {
    const custom = e as CustomEvent<{ accent?: string }>;
    if (custom.detail?.accent) syncAccentDots(custom.detail.accent);
  });

  // Theme Toggle logic
  const themeBtn = document.getElementById('theme-toggle-btn');
  const labelDark = document.getElementById('theme-label-dark');
  const labelLight = document.getElementById('theme-label-light');

  function updateThemeUI(theme: string) {
    if (theme === 'dark') {
      labelDark?.classList.add('hidden');
      labelLight?.classList.remove('hidden');
    } else {
      labelLight?.classList.add('hidden');
      labelDark?.classList.remove('hidden');
    }
  }

  const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
  updateThemeUI(currentTheme);

  themeBtn?.addEventListener('click', (e) => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const nextTheme = isDark ? 'light' : 'dark';

    const applyTheme = () => {
      document.documentElement.setAttribute('data-theme', nextTheme);
      try {
        localStorage.setItem('portfolio_theme_v7', nextTheme);
      } catch (_) {}
      updateThemeUI(nextTheme);
    };

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const docAny = document as Document & {
      startViewTransition?: (cb: () => void) => { ready: Promise<void> };
    };

    if (!reduced && typeof docAny.startViewTransition === 'function') {
      const rect = themeBtn.getBoundingClientRect();
      const x = (e as MouseEvent).clientX || rect.left + rect.width / 2;
      const y = (e as MouseEvent).clientY || rect.top + rect.height / 2;
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      const transition = docAny.startViewTransition(() => applyTheme());
      transition.ready
        .then(() => {
          document.documentElement.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${endRadius}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 480,
              easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
              pseudoElement: '::view-transition-new(root)',
            }
          );
        })
        .catch(() => {});
    } else {
      applyTheme();
    }
  });

  // Language Toggle logic
  const langBtn = document.getElementById('lang-toggle-btn');
  const indicatorId = document.getElementById('lang-indicator-id');
  const indicatorEn = document.getElementById('lang-indicator-en');

  function updateLangUI(lang: string) {
    if (lang === 'en') {
      indicatorId?.classList.remove('text-[var(--text-primary)]', 'font-bold');
      indicatorId?.classList.add('text-[var(--text-muted)]');
      indicatorEn?.classList.remove('text-[var(--text-muted)]');
      indicatorEn?.classList.add('text-[var(--text-primary)]', 'font-bold');
    } else {
      indicatorEn?.classList.remove('text-[var(--text-primary)]', 'font-bold');
      indicatorEn?.classList.add('text-[var(--text-muted)]');
      indicatorId?.classList.remove('text-[var(--text-muted)]');
      indicatorId?.classList.add('text-[var(--text-primary)]', 'font-bold');
    }
  }

  updateLangUI(document.documentElement.getAttribute('lang') || 'id');

  langBtn?.addEventListener('click', () => {
    const isId = (document.documentElement.getAttribute('lang') || 'id') === 'id';
    const nextLang = isId ? 'en' : 'id';
    document.documentElement.setAttribute('lang', nextLang);
    try {
      localStorage.setItem('lang', nextLang);
    } catch (_) {}
    updateLangUI(nextLang);
    window.dispatchEvent(new CustomEvent('portfolio:langchange', { detail: { lang: nextLang } }));
  });

  // Mobile Menu
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const textOpen = document.getElementById('mobile-menu-text-open');
  const textClose = document.getElementById('mobile-menu-text-close');

  mobileBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden');
    if (isOpen) {
      mobileMenu?.classList.add('hidden');
      textOpen?.classList.remove('hidden');
      textClose?.classList.add('hidden');
      mobileBtn.setAttribute('aria-expanded', 'false');
    } else {
      mobileMenu?.classList.remove('hidden');
      textOpen?.classList.add('hidden');
      textClose?.classList.remove('hidden');
      mobileBtn.setAttribute('aria-expanded', 'true');
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      textOpen?.classList.remove('hidden');
      textClose?.classList.add('hidden');
      mobileBtn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Active Section Scroll-Spy with Soft Pill Highlight
  const sections = document.querySelectorAll('section[id]');
  const desktopAnchors = document.querySelectorAll<HTMLElement>('.nav-anchor');

  if ('IntersectionObserver' in window && sections.length > 0) {
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            desktopAnchors.forEach((anchor) => {
              if (anchor.getAttribute('data-nav-section') === id) {
                anchor.classList.add('bg-[var(--bg-elevated)]', 'text-[var(--accent-primary)]', 'font-bold');
                anchor.classList.remove('text-[var(--text-secondary)]');
              } else {
                anchor.classList.remove('bg-[var(--bg-elevated)]', 'text-[var(--accent-primary)]', 'font-bold');
                anchor.classList.add('text-[var(--text-secondary)]');
              }
            });
          }
        });
      },
      { rootMargin: '-25% 0px -65% 0px', threshold: 0 }
    );
    sections.forEach((sec) => spyObserver.observe(sec));
  }
</script>
