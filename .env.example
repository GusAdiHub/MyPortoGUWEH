# Opsional: Username GitHub publik (default di src/data/profile.ts adalah GusAdiHub)
PUBLIC_GITHUB_USERNAME=GusAdiHub

# Opsional: GitHub Personal Access Token (Fine-grained / Read-only public data)
# Hanya dipakai di sisi server/build Astro agar tidak terkena rate limit 60 request/jam.
# JANGAN gunakan prefix PUBLIC_ untuk token agar tetap aman di server.
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
